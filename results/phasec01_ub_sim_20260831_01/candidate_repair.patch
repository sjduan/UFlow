From c68cfb8ab139312cc9d41fb26f0ebcd3b00c7072 Mon Sep 17 00:00:00 2001
From: Super User <root@liteserver-560t-1.novalocal>
Date: Mon, 31 Aug 2026 12:48:02 +0800
Subject: [PATCH 2/2] Restore QEMU bridge compatibility alias

---
 crates/sim-qemu/include/linqu_ub_bridge.h |  7 +++++++
 crates/sim-qemu/src/ffi.rs                | 20 ++++++++++++++++++++
 2 files changed, 27 insertions(+)

diff --git a/crates/sim-qemu/include/linqu_ub_bridge.h b/crates/sim-qemu/include/linqu_ub_bridge.h
index 38c4baa..4c91e6b 100644
--- a/crates/sim-qemu/include/linqu_ub_bridge.h
+++ b/crates/sim-qemu/include/linqu_ub_bridge.h
@@ -40,6 +40,13 @@ int linqu_ub_bridge_register_model_runtime_object_payload(LinquUbBridge *bridge,
                                                           const uint8_t *payload,
                                                           size_t payload_len);
 
+/* Compatibility alias for reachable QEMU revisions with the old name. */
+int linqu_ub_bridge_register_qwen3_runtime_object_payload(LinquUbBridge *bridge,
+                                                          const uint8_t *object_ref,
+                                                          size_t object_ref_len,
+                                                          const uint8_t *payload,
+                                                          size_t payload_len);
+
 int linqu_ub_bridge_ring_doorbell(LinquUbBridge *bridge,
                                   uint16_t endpoint_id,
                                   uint32_t max_batch,
diff --git a/crates/sim-qemu/src/ffi.rs b/crates/sim-qemu/src/ffi.rs
index ba4a3c8..28a638b 100644
--- a/crates/sim-qemu/src/ffi.rs
+++ b/crates/sim-qemu/src/ffi.rs
@@ -193,6 +193,26 @@ pub extern "C" fn linqu_ub_bridge_register_model_runtime_object_payload(
     }
 }
 
+/// Backward-compatible entrypoint for QEMU revisions that predate the
+/// model-neutral runtime payload name.  The wire contract is identical; keep
+/// the alias until every reachable QEMU pin has migrated to the new symbol.
+#[unsafe(no_mangle)]
+pub extern "C" fn linqu_ub_bridge_register_qwen3_runtime_object_payload(
+    ptr: *mut LinquUbBridge,
+    object_ref_data: *const u8,
+    object_ref_len: usize,
+    payload: *const u8,
+    payload_len: usize,
+) -> c_int {
+    linqu_ub_bridge_register_model_runtime_object_payload(
+        ptr,
+        object_ref_data,
+        object_ref_len,
+        payload,
+        payload_len,
+    )
+}
+
 fn bridge_mut<'a>(ptr: *mut LinquUbBridge) -> Result<&'a mut LinquUbBridge, c_int> {
     unsafe { ptr.as_mut() }.ok_or(-1)
 }
