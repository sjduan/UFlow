diff --git a/include/hw/ub/uflow_bounded_log.h b/include/hw/ub/uflow_bounded_log.h
new file mode 100644
index 0000000000000000000000000000000000000000..50397b78d5be841ddb5e7c45321bdcb4c0e11102
--- /dev/null
+++ b/include/hw/ub/uflow_bounded_log.h
@@ -0,0 +1,50 @@
+/* Per-source-site bounded diagnostics; mandatory publication events preserved. */
+#ifndef UFLOW_BOUNDED_LOG_H
+#define UFLOW_BOUNDED_LOG_H
+#include <stdarg.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+typedef struct UFlowLogBucket { _Atomic uint64_t count; } UFlowLogBucket;
+static inline __attribute__((format(gnu_printf, 4, 5)))
+void uflow_bounded_log(UFlowLogBucket *bucket, const char *file,
+                                      int line, const char *fmt, ...)
+{
+    uint64_t previous = atomic_load_explicit(&bucket->count, memory_order_relaxed);
+    uint64_t count;
+    bool mandatory = !strncmp(fmt, "SIM_DEC: OBMM bootstrap publish ",
+                              sizeof("SIM_DEC: OBMM bootstrap publish ") - 1) ||
+                     !strncmp(fmt, "SIM_DEC: OBMM export retired ",
+                              sizeof("SIM_DEC: OBMM export retired ") - 1) ||
+                     !strncmp(fmt, "UFLOW_MC_BEGIN ", sizeof("UFLOW_MC_BEGIN ") - 1) ||
+                     !strncmp(fmt, "UFLOW_MC_END ", sizeof("UFLOW_MC_END ") - 1);
+    while (previous != UINT64_MAX &&
+           !atomic_compare_exchange_weak_explicit(&bucket->count, &previous,
+             previous + 1, memory_order_relaxed, memory_order_relaxed)) { }
+    count = previous == UINT64_MAX ? previous : previous + 1;
+    if (mandatory || count <= 8) {
+        char text[768];
+        va_list ap;
+        int length;
+        va_start(ap, fmt);
+        length = vsnprintf(text, sizeof(text), fmt, ap);
+        va_end(ap);
+        if (length >= 0) {
+            qemu_log("%s%s", text, length >= sizeof(text) ?
+                     " [UFLOW_LOG_TRUNCATED]\n" : "");
+        }
+    } else if ((count & (count - 1)) == 0) {
+        const char *name = strrchr(file, '/');
+        qemu_log("UFLOW_LOG_SUPPRESSED site=%s:%d occurrences=%" PRIu64
+                 " exact_text_retained=8 suppressed=%" PRIu64 "\n",
+                 name ? name + 1 : file, line, count, count - 8);
+    }
+}
+#define UFLOW_BOUNDED_LOG(...) do { \
+    static UFlowLogBucket uflow_site_bucket; \
+    uflow_bounded_log(&uflow_site_bucket, __FILE__, __LINE__, __VA_ARGS__); \
+} while (0)
+#endif
diff --git a/include/hw/ub/uflow_managed_cache_control.h b/include/hw/ub/uflow_managed_cache_control.h
new file mode 100644
index 0000000000000000000000000000000000000000..a7000a11a4406ea45e6cd11b9c8d1ffb7792fe70
--- /dev/null
+++ b/include/hw/ub/uflow_managed_cache_control.h
@@ -0,0 +1,9 @@
+/* Normal opt-in simulator metadata API; all calls require the BQL. */
+#ifndef UFLOW_MANAGED_CACHE_CONTROL_H
+#define UFLOW_MANAGED_CACHE_CONTROL_H
+#include "hw/ub/ub_ubc.h"
+void ubc_uflow_managed_invalidate(BusControllerDev *ubc,
+                                  const GsvaKeyV1 *key, bool revoke);
+bool ubc_uflow_managed_blocks_close(BusControllerDev *ubc,
+                                    const GsvaKeyV1 *key);
+#endif
diff --git a/include/hw/ub/uflow_managed_cache_core.h b/include/hw/ub/uflow_managed_cache_core.h
new file mode 100644
index 0000000000000000000000000000000000000000..591f9f38ca442978cf648935c86458ea9cc08af8
--- /dev/null
+++ b/include/hw/ub/uflow_managed_cache_core.h
@@ -0,0 +1,226 @@
+/* UFlow Catalog-managed read grants. Caller serializes state under the BQL.
+ * Transport/native permission validation is supplied by the real GSVA wrapper.
+ * Cache data is never authority; fills always use strict Guest remote I/O.
+ */
+#ifndef UFLOW_MANAGED_CACHE_CORE_H
+#define UFLOW_MANAGED_CACHE_CORE_H
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define UFLOW_MC_PAGE 4096u
+#define UFLOW_MC_SLOTS 2048u
+#define UFLOW_MC_HISTORY 512u
+enum { UFLOW_MC_OK = 0, UFLOW_MC_MISS = 1, UFLOW_MC_BUSY = 2,
+       UFLOW_MC_DENIED = 3, UFLOW_MC_REPLAY = 4, UFLOW_MC_FULL = 5 };
+
+typedef struct UFlowMcPage {
+    uint64_t start;
+    uint32_t length;
+    bool valid;
+    uint8_t bytes[UFLOW_MC_PAGE];
+} UFlowMcPage;
+
+typedef struct UFlowMcCounters {
+    uint64_t reads, hits, fills, remote_bytes, successful_bytes, evictions, invalidations;
+    uint64_t late_discards, remote_failures;
+    bool saturated;
+} UFlowMcCounters;
+
+typedef struct UFlowManagedCache {
+    bool active, revoking;
+    uint64_t epoch, generation, offset, length;
+    uint32_t in_flight, pages, used;
+    uint8_t id[32], operation[32];
+    uint64_t generations[UFLOW_MC_HISTORY];
+    uint8_t closed_ids[UFLOW_MC_HISTORY][32];
+    uint8_t operations[UFLOW_MC_HISTORY][32];
+    UFlowMcCounters counters;
+    UFlowMcPage *slots;
+} UFlowManagedCache;
+
+typedef int (*UFlowMcFetch)(void *opaque, uint64_t offset,
+                            uint8_t *bytes, uint32_t length);
+typedef bool (*UFlowMcNativeValid)(void *opaque);
+
+static inline void uflow_mc_count(UFlowManagedCache *m, uint64_t *v,
+                                  uint64_t amount)
+{
+    if (amount > UINT64_MAX - *v) {
+        *v = UINT64_MAX;
+        m->counters.saturated = true;
+    } else {
+        *v += amount;
+    }
+}
+
+static inline void uflow_mc_invalidate(UFlowManagedCache *m)
+{
+    if (!m || !m->active) {
+        return;
+    }
+    if (m->epoch == UINT64_MAX) {
+        m->revoking = true;
+    } else {
+        m->epoch++;
+    }
+    for (uint32_t i = 0; m->slots && i < UFLOW_MC_SLOTS; i++) {
+        m->slots[i].valid = false;
+    }
+    m->pages = 0;
+    uflow_mc_count(m, &m->counters.invalidations, 1);
+}
+
+static inline int uflow_mc_begin(UFlowManagedCache *m, uint64_t generation,
+                                 const uint8_t id[32], const uint8_t operation[32],
+                                 uint64_t offset, uint64_t length)
+{
+    if (!m || !generation || !length || length > UINT64_MAX - offset) {
+        return UFLOW_MC_DENIED;
+    }
+    if (m->active || m->in_flight) {
+        return UFLOW_MC_BUSY;
+    }
+    for (uint32_t i = 0; i < m->used; i++) {
+        if (m->generations[i] == generation ||
+            !memcmp(m->closed_ids[i], id, 32) ||
+            !memcmp(m->operations[i], operation, 32)) {
+            return UFLOW_MC_REPLAY;
+        }
+    }
+    if (m->used == UFLOW_MC_HISTORY || m->epoch == UINT64_MAX) {
+        return UFLOW_MC_FULL;
+    }
+    if (!m->slots) {
+        m->slots = calloc(UFLOW_MC_SLOTS, sizeof(*m->slots));
+        if (!m->slots) {
+            return UFLOW_MC_FULL;
+        }
+    }
+    m->active = true;
+    m->revoking = false;
+    m->generation = generation;
+    m->offset = offset;
+    m->length = length;
+    memcpy(m->id, id, 32);
+    memcpy(m->operation, operation, 32);
+    memset(&m->counters, 0, sizeof(m->counters));
+    uflow_mc_invalidate(m);
+    return UFLOW_MC_OK;
+}
+
+static inline bool uflow_mc_overlap(const UFlowManagedCache *m,
+                                    uint64_t offset, uint64_t length)
+{
+    return m && m->active && length && length <= UINT64_MAX - offset &&
+        offset < m->offset + m->length && m->offset < offset + length;
+}
+
+static inline int uflow_mc_end(UFlowManagedCache *m, uint64_t generation,
+                               const uint8_t id[32])
+{
+    if (!m || !generation) {
+        return UFLOW_MC_DENIED;
+    }
+    if (!m->active) {
+        for (uint32_t i = 0; i < m->used; i++) {
+            if (m->generations[i] == generation &&
+                !memcmp(m->closed_ids[i], id, 32)) {
+                return UFLOW_MC_OK;
+            }
+        }
+        return UFLOW_MC_DENIED;
+    }
+    if (m->generation != generation || memcmp(m->id, id, 32)) {
+        return UFLOW_MC_DENIED;
+    }
+    m->revoking = true;
+    uflow_mc_invalidate(m);
+    if (m->in_flight) {
+        return UFLOW_MC_BUSY;
+    }
+    /* Begin reserved one replay-history slot; no new begin can race an end. */
+    m->generations[m->used] = generation;
+    memcpy(m->closed_ids[m->used], m->id, 32);
+    memcpy(m->operations[m->used], m->operation, 32);
+    m->used++;
+    m->active = false;
+    return UFLOW_MC_OK;
+}
+
+static inline int uflow_mc_read(UFlowManagedCache *m, uint64_t offset,
+                                uint8_t *out, uint32_t length,
+                                UFlowMcFetch fetch, UFlowMcNativeValid valid,
+                                void *opaque)
+{
+    uint32_t done = 0;
+    if (!m || !m->active || !length || offset < m->offset ||
+        offset - m->offset > m->length ||
+        length > m->length - (offset - m->offset)) {
+        return UFLOW_MC_MISS;
+    }
+    if (m->revoking || m->in_flight || !out || !fetch || !valid ||
+        !valid(opaque)) {
+        return UFLOW_MC_DENIED;
+    }
+    uflow_mc_count(m, &m->counters.reads, 1);
+    while (done < length) {
+        uint64_t at = offset + done;
+        uint64_t base = at - at % UFLOW_MC_PAGE;
+        uint64_t start = base > m->offset ? base : m->offset;
+        uint64_t end = m->offset + m->length;
+        uint32_t amount;
+        UFlowMcPage *page;
+        if (UINT64_MAX - base >= UFLOW_MC_PAGE &&
+            end > base + UFLOW_MC_PAGE) {
+            end = base + UFLOW_MC_PAGE;
+        }
+        amount = end - at < length - done ? end - at : length - done;
+        page = &m->slots[(base / UFLOW_MC_PAGE) % UFLOW_MC_SLOTS];
+        if (!page->valid || page->start != start ||
+            page->length != end - start) {
+            uint8_t bytes[UFLOW_MC_PAGE];
+            uint64_t epoch = m->epoch;
+            int result;
+            m->in_flight++;
+            uflow_mc_count(m, &m->counters.fills, 1);
+            uflow_mc_count(m, &m->counters.remote_bytes, end - start);
+            result = fetch(opaque, start, bytes, end - start);
+            m->in_flight--;
+            if (result != 0) {
+                uflow_mc_count(m, &m->counters.remote_failures, 1);
+                return UFLOW_MC_DENIED;
+            }
+            uflow_mc_count(m, &m->counters.successful_bytes, end - start);
+            if (!m->active || m->revoking || m->epoch != epoch ||
+                !valid(opaque)) {
+                uflow_mc_count(m, &m->counters.late_discards, 1);
+                return UFLOW_MC_DENIED;
+            }
+            if (page->valid) {
+                uflow_mc_count(m, &m->counters.evictions, 1);
+            } else {
+                m->pages++;
+            }
+            page->start = start;
+            page->length = end - start;
+            memcpy(page->bytes, bytes, page->length);
+            page->valid = true;
+        } else {
+            uflow_mc_count(m, &m->counters.hits, 1);
+        }
+        memcpy(out + done, page->bytes + at - start, amount);
+        done += amount;
+    }
+    return UFLOW_MC_OK;
+}
+
+static inline void uflow_mc_destroy(UFlowManagedCache *m)
+{
+    if (m) {
+        free(m->slots);
+        memset(m, 0, sizeof(*m));
+    }
+}
+#endif
diff --git a/include/hw/ub/uflow_managed_write_core.h b/include/hw/ub/uflow_managed_write_core.h
new file mode 100644
index 0000000000000000000000000000000000000000..54a4633f6c96066f059d228f61a9633346acea35
--- /dev/null
+++ b/include/hw/ub/uflow_managed_write_core.h
@@ -0,0 +1,181 @@
+/* BQL-serialized Catalog W-grant buffer. No data is supplied by host control.
+ * CPU stores supply every dirty byte. Only real strict native completion clears
+ * it. Invalidation during an unlocked/reentrant flush is sticky uncertainty.
+ */
+#ifndef UFLOW_MANAGED_WRITE_CORE_H
+#define UFLOW_MANAGED_WRITE_CORE_H
+#include "hw/ub/uflow_managed_cache_core.h"
+
+#define UFLOW_MW_UNKNOWN 6
+typedef int (*UFlowMwStore)(void *, uint64_t, const uint8_t *, uint32_t);
+typedef struct UFlowManagedWrite {
+    UFlowManagedCache reads;
+    bool failed, staged;
+    uint32_t pending, dirty, span;
+    uint64_t start, writes, accepted_bytes, flushes, completed_bytes, failures;
+    uint8_t data[UFLOW_MC_PAGE], mask[UFLOW_MC_PAGE / 8];
+} UFlowManagedWrite;
+
+static inline bool uflow_mw_bit(const UFlowManagedWrite *m, uint32_t at)
+{
+    return (m->mask[at / 8] >> (at % 8)) & 1;
+}
+
+static inline int uflow_mw_fail(UFlowManagedWrite *m)
+{
+    m->failed = true;
+    m->reads.revoking = true;
+    uflow_mc_count(&m->reads, &m->failures, 1);
+    uflow_mc_invalidate(&m->reads);
+    return UFLOW_MW_UNKNOWN;
+}
+
+static inline int uflow_mw_begin(UFlowManagedWrite *m, uint64_t generation,
+    const uint8_t id[32], const uint8_t operation[32], uint64_t offset,
+    uint64_t length)
+{
+    int rc;
+    if (!m) { return UFLOW_MC_DENIED; }
+    if (m->failed) { return UFLOW_MW_UNKNOWN; }
+    if (m->pending || m->dirty) { return UFLOW_MC_BUSY; }
+    rc = uflow_mc_begin(&m->reads, generation, id, operation, offset, length);
+    if (rc != UFLOW_MC_OK) { return rc; }
+    m->staged = false;
+    m->writes = m->accepted_bytes = m->flushes = m->completed_bytes = 0;
+    m->failures = 0;
+    memset(m->mask, 0, sizeof(m->mask));
+    return UFLOW_MC_OK;
+}
+
+static inline void uflow_mw_invalidate(UFlowManagedWrite *m, bool revoke)
+{
+    if (!m || !m->reads.active) { return; }
+    if (revoke || m->dirty || m->pending || m->reads.in_flight) {
+        uflow_mw_fail(m);
+    } else {
+        uflow_mc_invalidate(&m->reads);
+    }
+}
+
+static inline int uflow_mw_flush(UFlowManagedWrite *m, UFlowMwStore store,
+    UFlowMcNativeValid valid, void *opaque)
+{
+    if (!m || !m->reads.active || !store || !valid) { return UFLOW_MC_DENIED; }
+    if (m->failed) { return UFLOW_MW_UNKNOWN; }
+    if (m->pending || m->reads.in_flight) { return UFLOW_MC_BUSY; }
+    if (!valid(opaque)) { return uflow_mw_fail(m); }
+    for (uint32_t at = 0; at < m->span && m->dirty;) {
+        uint32_t first, length;
+        uint64_t epoch;
+        int rc;
+        if (!uflow_mw_bit(m, at)) { at++; continue; }
+        first = at;
+        while (at < m->span && uflow_mw_bit(m, at)) { at++; }
+        length = at - first;
+        epoch = m->reads.epoch;
+        m->pending++;
+        m->reads.in_flight++;
+        uflow_mc_count(&m->reads, &m->flushes, 1);
+        rc = store(opaque, m->start + first, m->data + first, length);
+        m->pending--;
+        m->reads.in_flight--;
+        if (rc == 0) {
+            uflow_mc_count(&m->reads, &m->completed_bytes, length);
+        }
+        if (rc != 0 || m->failed || !m->reads.active ||
+            m->reads.epoch != epoch || !valid(opaque)) {
+            return uflow_mw_fail(m);
+        }
+        for (uint32_t i = first; i < at; i++) {
+            m->mask[i / 8] &= (uint8_t)~(1u << (i % 8));
+        }
+        m->dirty -= length;
+        uflow_mc_invalidate(&m->reads);
+    }
+    return UFLOW_MC_OK;
+}
+
+static inline int uflow_mw_write(UFlowManagedWrite *m, uint64_t offset,
+    const uint8_t *bytes, uint32_t length, UFlowMwStore store,
+    UFlowMcNativeValid valid, void *opaque)
+{
+    uint32_t done = 0;
+    if (!m || !m->reads.active || !length || offset < m->reads.offset ||
+        offset - m->reads.offset > m->reads.length ||
+        length > m->reads.length - (offset - m->reads.offset)) {
+        return UFLOW_MC_MISS;
+    }
+    if (m->failed) { return UFLOW_MW_UNKNOWN; }
+    if (m->pending || m->reads.in_flight || !bytes || !valid ||
+        !valid(opaque)) { return uflow_mw_fail(m); }
+    uflow_mc_count(&m->reads, &m->writes, 1);
+    while (done < length) {
+        uint64_t at = offset + done;
+        uint64_t base = at - at % UFLOW_MC_PAGE;
+        uint64_t start = base > m->reads.offset ? base : m->reads.offset;
+        uint64_t end = m->reads.offset + m->reads.length;
+        uint32_t count, inside;
+        int rc;
+        if (UINT64_MAX - base >= UFLOW_MC_PAGE && end > base + UFLOW_MC_PAGE) {
+            end = base + UFLOW_MC_PAGE;
+        }
+        if (!m->staged || m->start != start) {
+            rc = uflow_mw_flush(m, store, valid, opaque);
+            if (rc != UFLOW_MC_OK) { return rc; }
+            m->start = start;
+            m->span = end - start;
+            m->staged = true;
+            memset(m->mask, 0, sizeof(m->mask));
+        }
+        if (!m->dirty) { uflow_mc_invalidate(&m->reads); }
+        inside = at - start;
+        count = end - at < length - done ? end - at : length - done;
+        for (uint32_t i = 0; i < count; i++) {
+            uint32_t index = inside + i;
+            if (!uflow_mw_bit(m, index)) {
+                m->mask[index / 8] |= 1u << (index % 8);
+                m->dirty++;
+            }
+            m->data[index] = bytes[done + i];
+        }
+        uflow_mc_count(&m->reads, &m->accepted_bytes, count);
+        done += count;
+        if (m->dirty == m->span) {
+            rc = uflow_mw_flush(m, store, valid, opaque);
+            if (rc != UFLOW_MC_OK) { return rc; }
+        }
+    }
+    return UFLOW_MC_OK;
+}
+
+static inline int uflow_mw_read(UFlowManagedWrite *m, uint64_t offset,
+    uint8_t *bytes, uint32_t length, UFlowMwStore store, UFlowMcFetch fetch,
+    UFlowMcNativeValid valid, void *opaque)
+{
+    int rc;
+    if (!m || !m->reads.active || !length || offset < m->reads.offset ||
+        offset - m->reads.offset > m->reads.length ||
+        length > m->reads.length - (offset - m->reads.offset)) {
+        return UFLOW_MC_MISS;
+    }
+    rc = uflow_mw_flush(m, store, valid, opaque);
+    if (rc != UFLOW_MC_OK) { return rc; }
+    rc = uflow_mc_read(&m->reads, offset, bytes, length, fetch, valid, opaque);
+    return rc == UFLOW_MC_OK ? rc : uflow_mw_fail(m);
+}
+
+static inline int uflow_mw_end(UFlowManagedWrite *m, uint64_t generation,
+    const uint8_t id[32], UFlowMwStore store, UFlowMcNativeValid valid,
+    void *opaque)
+{
+    int rc;
+    if (!m || m->failed) { return m ? UFLOW_MW_UNKNOWN : UFLOW_MC_DENIED; }
+    if (!m->reads.active) { return uflow_mc_end(&m->reads, generation, id); }
+    if (m->reads.generation != generation || memcmp(m->reads.id, id, 32)) {
+        return UFLOW_MC_DENIED;
+    }
+    rc = uflow_mw_flush(m, store, valid, opaque);
+    if (rc != UFLOW_MC_OK) { return rc; }
+    return uflow_mc_end(&m->reads, generation, id);
+}
+#endif
