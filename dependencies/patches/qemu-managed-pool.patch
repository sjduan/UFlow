+++ b/hw/ub/uflow_managed_cache.inc
@@ -0,0 +1,441 @@
+/* Included after the real GSVA route/coherence tables. No payload control. */
+#include "hw/ub/uflow_managed_cache_core.h"
+#include "qapi/qmp/qdict.h"
+#include "qapi/qmp/qjson.h"
+
+#define UFLOW_MC_PROPERTY "uflow-managed-cache-control-v1"
+#define UFLOW_MC_FEATURE "uflow-managed-lease-cache-v1"
+#define UFLOW_MC_WIRE_BYTES 220
+typedef struct UFlowMcCommand {
+    uint8_t op, body[UFLOW_MC_WIRE_BYTES];
+    uint64_t generation, q[9];
+    uint32_t n[9];
+    uint8_t authority[32], correlation[32], descriptor[32], id[32], request[32];
+} UFlowMcCommand;
+enum { MC_MAP, MC_LEASE, MC_EXPORT, MC_UBA, MC_SIZE, MC_SEGMENT, MC_EPOCH,
+       MC_OFFSET, MC_LENGTH };
+enum { MC_BACKING, MC_HOME, MC_TOKEN, MC_POLICY, MC_PTAG, MC_ACCESS,
+       MC_NODE, MC_NODES, MC_FLAGS };
+typedef struct UFlowMcState {
+    bool enabled, alias_published;
+    UFlowManagedCache cache;
+    GsvaRouteAccess native;
+    UFlowMcCommand accepted;
+    char *reply;
+} UFlowMcState;
+typedef struct UFlowMcRead {
+    BusControllerDev *ubc;
+    GsvaRouteEntry *route;
+    UFlowMcState *state;
+} UFlowMcRead;
+static GHashTable *uflow_mc_states;
+
+static UFlowMcState *uflow_mc_state(BusControllerDev *ubc, bool create)
+{
+    UFlowMcState *s;
+    if (!uflow_mc_states) {
+        if (!create) { return NULL; }
+        uflow_mc_states = g_hash_table_new(g_direct_hash, g_direct_equal);
+    }
+    s = g_hash_table_lookup(uflow_mc_states, ubc);
+    if (!s && create) {
+        s = g_new0(UFlowMcState, 1);
+        g_hash_table_insert(uflow_mc_states, ubc, s);
+    }
+    return s;
+}
+
+static void uflow_mc_hash(const void *data, size_t length, uint8_t digest[32])
+{
+    GChecksum *sum = g_checksum_new(G_CHECKSUM_SHA256);
+    gsize n = 32;
+    g_checksum_update(sum, data, length);
+    g_checksum_get_digest(sum, digest, &n);
+    g_checksum_free(sum);
+    assert(n == 32);
+}
+
+static char *uflow_mc_hex(const uint8_t *data, size_t length)
+{
+    static const char digits[] = "0123456789abcdef";
+    char *text = g_malloc(length * 2 + 1);
+    for (size_t i = 0; i < length; i++) {
+        text[i * 2] = digits[data[i] >> 4];
+        text[i * 2 + 1] = digits[data[i] & 15];
+    }
+    text[length * 2] = 0;
+    return text;
+}
+
+static bool uflow_mc_decode(const char *wire, UFlowMcCommand *c)
+{
+    uint8_t neutral[UFLOW_MC_WIRE_BYTES];
+    if (!wire || strlen(wire) != 445 || strncmp(wire, "umc1:", 5)) {
+        return false;
+    }
+    memset(c, 0, sizeof(*c));
+    for (size_t i = 0; i < UFLOW_MC_WIRE_BYTES; i++) {
+        unsigned a = wire[5 + i * 2], b = wire[6 + i * 2];
+        if (!((a >= '0' && a <= '9') || (a >= 'a' && a <= 'f')) ||
+            !((b >= '0' && b <= '9') || (b >= 'a' && b <= 'f'))) {
+            return false;
+        }
+        c->body[i] = ((a <= '9' ? a - '0' : a - 'a' + 10) << 4) |
+                       (b <= '9' ? b - '0' : b - 'a' + 10);
+    }
+    if (memcmp(c->body, "UMC1", 4) || c->body[4] < 1 || c->body[4] > 4 ||
+        c->body[5] || c->body[6] || c->body[7]) {
+        return false;
+    }
+    c->op = c->body[4];
+    c->generation = ldq_be_p(c->body + 8);
+    memcpy(c->authority, c->body + 16, 32);
+    memcpy(c->correlation, c->body + 48, 32);
+    memcpy(c->descriptor, c->body + 80, 32);
+    for (size_t i = 0; i < 9; i++) {
+        c->q[i] = ldq_be_p(c->body + 112 + 8 * i);
+        c->n[i] = ldl_be_p(c->body + 184 + 4 * i);
+    }
+    if (!c->q[MC_SIZE] || !c->q[MC_LENGTH] ||
+        c->q[MC_UBA] > UINT64_MAX - c->q[MC_SIZE] ||
+        c->q[MC_OFFSET] > c->q[MC_SIZE] ||
+        c->q[MC_LENGTH] > c->q[MC_SIZE] - c->q[MC_OFFSET] ||
+        !c->q[MC_EXPORT] || !c->q[MC_SEGMENT] || !c->q[MC_EPOCH] ||
+        !c->n[MC_BACKING] || !c->n[MC_HOME] || !c->n[MC_TOKEN] ||
+        c->n[MC_POLICY] != 1 || c->n[MC_FLAGS] != 7 ||
+        !(c->n[MC_ACCESS] & 1) || c->n[MC_NODES] < 2 ||
+        c->n[MC_NODES] > 8 || c->n[MC_NODE] >= c->n[MC_NODES]) {
+        return false;
+    }
+    if ((c->op == 2 || c->op == 3) &&
+        (!c->generation || !c->q[MC_MAP] || !c->q[MC_LEASE] ||
+         !memcmp(c->authority, (uint8_t[32]){0}, 32) ||
+         !memcmp(c->correlation, (uint8_t[32]){0}, 32) ||
+         !memcmp(c->descriptor, (uint8_t[32]){0}, 32))) {
+        return false;
+    }
+    uflow_mc_hash(c->body, sizeof(c->body), c->request);
+    memcpy(neutral, c->body, sizeof(neutral));
+    neutral[4] = 0;
+    uflow_mc_hash(neutral, sizeof(neutral), c->id);
+    return true;
+}
+
+static bool uflow_mc_descriptor_equal(const UFlowMcCommand *c,
+                                       const GsvaRouteAccess *native)
+{
+    uint8_t bytes[96] = {0}, actual[32];
+    g_autofree char *hex = NULL;
+    stl_be_p(bytes, 0x4d534f42); stl_be_p(bytes + 4, 2);
+    stl_be_p(bytes + 8, 96);
+    stq_be_p(bytes + 16, c->q[MC_EXPORT]);
+    stq_be_p(bytes + 24, native->key.home_va);
+    stq_be_p(bytes + 32, native->key.size);
+    stl_be_p(bytes + 40, native->backing_token_id);
+    stl_be_p(bytes + 44, native->home_cna);
+    stq_be_p(bytes + 48, native->key.segment_id);
+    stq_be_p(bytes + 56, native->key.epoch);
+    /* MSOB segment flags (7) are distinct from GSVA key flags (0). */
+    stl_be_p(bytes + 64, c->n[MC_FLAGS]);
+    stl_be_p(bytes + 68, c->n[MC_NODE]);
+    stl_be_p(bytes + 72, c->n[MC_NODES]);
+    stl_be_p(bytes + 76, native->key.cache_policy);
+    stl_be_p(bytes + 80, native->key.p_tag);
+    stl_be_p(bytes + 84, native->access_flags);
+    stl_be_p(bytes + 88, native->token_id);
+    /* The secret never leaves this native reconstruction/hash. */
+    stl_be_p(bytes + 92, native->token_value);
+    hex = uflow_mc_hex(bytes, sizeof(bytes));
+    uflow_mc_hash(hex, 192, actual);
+    return !memcmp(actual, c->descriptor, sizeof(actual));
+}
+
+static bool uflow_mc_resolve(BusControllerDev *ubc, const UFlowMcCommand *c,
+                              GsvaRouteAccess *native)
+{
+    GsvaRouteEntry *route, *selected = NULL;
+    gsva_tables_init();
+    QTAILQ_FOREACH(route, &g_gsva_routes.routes, next) {
+        const GsvaKeyV1 *k = &route->key;
+        if (k->version == 1 && k->flags == 0 &&
+            !k->vmid && !k->asid && !k->pte_offset &&
+            k->segment_id == c->q[MC_SEGMENT] && k->home_va == c->q[MC_UBA] &&
+            k->size == c->q[MC_SIZE] && k->epoch == c->q[MC_EPOCH] &&
+            k->p_tag == c->n[MC_PTAG] && k->cache_policy == c->n[MC_POLICY] &&
+            route->home_cna == c->n[MC_HOME] &&
+            route->backing_token_id == c->n[MC_BACKING] &&
+            route->token.token_id == c->n[MC_TOKEN] &&
+            route->token.access_flags == c->n[MC_ACCESS]) {
+            if (selected) { return false; }
+            selected = route;
+        }
+    }
+    if (!selected || selected->source != SIM_DEC_MAP_SOURCE_GVA_MANAGER ||
+        gsva_route_resolve_pto(&g_gsva_routes,
+          selected->local_pa, 1, ubc->parent.cna, native) != GSVA_OK ||
+        (c->q[MC_MAP] && native->map_id != c->q[MC_MAP]) ||
+        (c->q[MC_LEASE] && native->lease_epoch != c->q[MC_LEASE]) ||
+        !uflow_mc_descriptor_equal(c, native)) {
+        return false;
+    }
+    if (native->direct_home_backing) {
+        GsvaHomeRequest registration;
+        if (native->home_cna != ubc->parent.cna ||
+            gsva_home_resolve_export(&ubc->gsva_home, ubc->parent.cna,
+              c->q[MC_EXPORT], native->backing_token_id, c->q[MC_UBA],
+              c->q[MC_SIZE], &registration) != GSVA_OK ||
+            memcmp(&registration.identity.key, &native->key, sizeof(native->key)) ||
+            registration.identity.token_id != native->token_id ||
+            registration.identity.token_value != native->token_value ||
+            registration.identity.backing_token_id != native->backing_token_id) {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool uflow_mc_native_valid(void *opaque)
+{
+    UFlowMcRead *r = opaque;
+    GsvaRouteAccess actual;
+    return r->route->state == GSVA_ROUTE_ACTIVE &&
+        gsva_route_resolve_pto(&g_gsva_routes, r->route->local_pa, 1,
+          r->ubc->parent.cna, &actual) == GSVA_OK &&
+        gsva_route_access_equal(&actual, &r->state->native) &&
+        (actual.access_flags & 1);
+}
+
+static int uflow_mc_fetch(void *opaque, uint64_t offset,
+                           uint8_t *bytes, uint32_t length)
+{
+    UFlowMcRead *r = opaque;
+    const GsvaRouteAccess *n = &r->state->native;
+    GsvaHomeIdentity identity = {.key = n->key, .home_cna = n->home_cna,
+        .token_id = n->token_id, .token_value = n->token_value,
+        .backing_token_id = n->backing_token_id};
+    return ubc_sim_dec_remote_io(r->ubc, n->key.home_va + offset,
+        n->backing_token_id, n->home_cna, bytes, length, true, false,
+        &identity) == MEMTX_OK ? 0 : -1;
+}
+
+static bool uflow_mc_cpu_read(GsvaRouteEntry *route, uint64_t offset,
+                               uint8_t *bytes, uint32_t length,
+                               MemTxResult *result)
+{
+    BusControllerDev *ubc = g_sim_decoder && g_sim_decoder->bcs ?
+        g_sim_decoder->bcs->ubc_dev : NULL;
+    UFlowMcState *s = ubc ? uflow_mc_state(ubc, false) : NULL;
+    UFlowMcRead read = {.ubc = ubc, .route = route, .state = s};
+    int code;
+    if (!s || !s->enabled || !s->cache.active ||
+        route->key.home_va != s->native.key.home_va) {
+        return false;
+    }
+    if (!uflow_mc_native_valid(&read)) {
+        s->cache.revoking = true;
+        uflow_mc_invalidate(&s->cache);
+        *result = MEMTX_ACCESS_ERROR;
+        return true;
+    }
+    code = uflow_mc_read(&s->cache, offset, bytes, length,
+                          uflow_mc_fetch, uflow_mc_native_valid, &read);
+    if (code == UFLOW_MC_MISS) { return false; }
+    *result = code == UFLOW_MC_OK ? MEMTX_OK : MEMTX_ACCESS_ERROR;
+    return true;
+}
+
+static bool uflow_mc_cpu_write_blocked(GsvaRouteEntry *route,
+                                        uint64_t offset, uint32_t length)
+{
+    BusControllerDev *ubc = g_sim_decoder && g_sim_decoder->bcs ?
+        g_sim_decoder->bcs->ubc_dev : NULL;
+    UFlowMcState *s = ubc ? uflow_mc_state(ubc, false) : NULL;
+    return s && s->enabled && s->cache.active &&
+        route->key.home_va == s->native.key.home_va &&
+        uflow_mc_overlap(&s->cache, offset, length);
+}
+
+bool ubc_uflow_managed_blocks_close(BusControllerDev *ubc,
+                                    const GsvaKeyV1 *key)
+{
+    UFlowMcState *s = uflow_mc_state(ubc, false);
+    return uflow_mw_blocks_close(ubc, key) || (s && s->enabled && s->cache.active &&
+        gsva_key_base_equal(&s->native.key, key));
+}
+
+void ubc_uflow_managed_invalidate(BusControllerDev *ubc,
+                                  const GsvaKeyV1 *key, bool revoke)
+{
+    uflow_mw_event(ubc, key, revoke);
+    UFlowMcState *s = uflow_mc_state(ubc, false);
+    if (s && s->enabled && s->cache.active &&
+        gsva_key_base_equal(&s->native.key, key)) {
+        if (revoke) { s->cache.revoking = true; }
+        uflow_mc_invalidate(&s->cache);
+    }
+}
+
+static void uflow_mc_put_u64(QDict *dict, const char *name, uint64_t value)
+{
+    g_autofree char *text = g_strdup_printf("%" PRIu64, value);
+    qdict_put_str(dict, name, text);
+}
+
+static void uflow_mc_reply(UFlowMcState *s, const UFlowMcCommand *c,
+                            const char *code, const GsvaRouteAccess *native)
+{
+    static const char *ops[] = {"", "probe", "begin", "end", "status"};
+    static const char *names64[] = {"map_id", "lease_epoch", "export_mem_id",
+        "remote_uba", "size", "segment_id", "epoch", "offset", "length"};
+    static const char *names32[] = {"backing_token_id", "home_cna",
+        "gsva_token_id", "cache_policy", "p_tag", "access_flags", "owner_node",
+        "node_count", "segment_flags"};
+    QDict *reply = qdict_new(), *stats = qdict_new();
+    GString *text;
+    g_autofree char *request = uflow_mc_hex(c->request, 32);
+    g_autofree char *authority = uflow_mc_hex(c->authority, 32);
+    g_autofree char *correlation = uflow_mc_hex(c->correlation, 32);
+    g_autofree char *descriptor = uflow_mc_hex(c->descriptor, 32);
+    qdict_put_int(reply, "version", 1); qdict_put_str(reply, "feature", UFLOW_MC_FEATURE);
+    qdict_put_int(reply, "pid", getpid()); qdict_put_str(reply, "operation", ops[c->op]);
+    qdict_put_str(reply, "request_sha256", request);
+    qdict_put_str(reply, "authority_sha256", authority);
+    qdict_put_str(reply, "correlation_sha256", correlation);
+    qdict_put_str(reply, "descriptor_sha256", descriptor);
+    uflow_mc_put_u64(reply, "control_generation", c->generation);
+    qdict_put_str(reply, "code", code);
+    qdict_put_str(reply, "scope", "UFlow-Catalog-managed-only");
+    qdict_put_bool(reply, "active", s->cache.active);
+    qdict_put_int(reply, "in_flight", s->cache.in_flight);
+    qdict_put_int(reply, "cache_pages", s->cache.pages);
+    if (native) {
+        QDict *alias = qdict_new();
+        for (size_t i = 0; i < 9; i++) {
+            uint64_t value = i == MC_MAP ? native->map_id :
+                             i == MC_LEASE ? native->lease_epoch : c->q[i];
+            uflow_mc_put_u64(alias, names64[i], value);
+            qdict_put_int(alias, names32[i], c->n[i]);
+        }
+        qdict_put_str(alias, "descriptor_sha256", descriptor);
+        qdict_put_obj(reply, "native_alias", QOBJECT(alias));
+    } else {
+        qdict_put_null(reply, "native_alias");
+    }
+    uflow_mc_put_u64(stats, "read_callbacks", s->cache.counters.reads);
+    uflow_mc_put_u64(stats, "cache_hits", s->cache.counters.hits);
+    uflow_mc_put_u64(stats, "remote_fill_calls", s->cache.counters.fills);
+    uflow_mc_put_u64(stats, "remote_fill_requested_bytes", s->cache.counters.remote_bytes);
+    uflow_mc_put_u64(stats, "remote_fill_successful_bytes", s->cache.counters.successful_bytes);
+    uflow_mc_put_u64(stats, "evictions", s->cache.counters.evictions);
+    uflow_mc_put_u64(stats, "invalidations", s->cache.counters.invalidations);
+    uflow_mc_put_u64(stats, "late_fill_discards", s->cache.counters.late_discards);
+    uflow_mc_put_u64(stats, "remote_failures", s->cache.counters.remote_failures);
+    qdict_put_bool(stats, "saturated", s->cache.counters.saturated);
+    qdict_put_obj(reply, "counters", QOBJECT(stats));
+    text = qobject_to_json(QOBJECT(reply));
+    assert(text->len <= 4096);
+    g_free(s->reply); s->reply = g_string_free(text, false);
+    qobject_unref(reply);
+}
+
+static bool uflow_mc_enabled_get(Object *obj, Error **errp)
+{
+    UFlowMcState *s = uflow_mc_state(BUS_CONTROLLER_DEV(obj), false);
+    return s && s->enabled;
+}
+
+static void uflow_mc_enabled_set(Object *obj, bool value, Error **errp)
+{
+    if (DEVICE(obj)->realized) {
+        error_setg(errp, "managed-cache feature is construction-only");
+        return;
+    }
+    uflow_mc_state(BUS_CONTROLLER_DEV(obj), true)->enabled = value;
+}
+
+static char *uflow_mc_control_get(Object *obj, Error **errp)
+{
+    UFlowMcState *s = uflow_mc_state(BUS_CONTROLLER_DEV(obj), false);
+    if (!s || !s->enabled || !s->reply) {
+        error_setg(errp, "no enabled managed-cache metadata transaction");
+        return NULL;
+    }
+    return g_strdup(s->reply);
+}
+
+static void uflow_mc_control_set(Object *obj, const char *wire, Error **errp)
+{
+    BusControllerDev *ubc = BUS_CONTROLLER_DEV(obj);
+    UFlowMcState *s = uflow_mc_state(ubc, false);
+    UFlowMcCommand command;
+    GsvaRouteAccess native;
+    const char *codes[] = {"ok", "denied", "busy", "denied", "replay", "full"};
+    int result;
+    if (!s || !s->enabled || !uflow_mc_decode(wire, &command)) {
+        error_setg(errp, "disabled or malformed bounded UFlow metadata control");
+        return;
+    }
+    if (command.op == 3) {
+        bool was_active = s->cache.active;
+        bool accepted = command.generation == s->accepted.generation &&
+                        !memcmp(command.id, s->accepted.id, 32);
+        result = accepted ? uflow_mc_end(&s->cache, command.generation,
+                                          command.id) : UFLOW_MC_DENIED;
+        uflow_mc_reply(s, &command, codes[result], accepted ? &s->native : NULL);
+        if (was_active && result == UFLOW_MC_OK) {
+            qemu_log("UFLOW_MC_END generation=%" PRIu64 " active=0 fills=0 pages=0\n",
+                     command.generation);
+        }
+        return;
+    }
+    if (!uflow_mc_resolve(ubc, &command, &native)) {
+        uflow_mc_reply(s, &command, "denied", NULL);
+        return;
+    }
+    if (command.op == 2) {
+        if (uflow_mw_active(ubc)) {
+            uflow_mc_reply(s, &command, "busy", &native); return;
+        }
+        result = uflow_mc_begin(&s->cache, command.generation, command.id,
+            command.correlation, command.q[MC_OFFSET], command.q[MC_LENGTH]);
+        if (result == UFLOW_MC_OK) {
+            s->native = native; s->accepted = command;
+            qemu_log("UFLOW_MC_BEGIN generation=%" PRIu64 " offset=%" PRIu64
+                     " length=%" PRIu64 " active=1 pages=0\n", command.generation,
+                     command.q[MC_OFFSET], command.q[MC_LENGTH]);
+        }
+        uflow_mc_reply(s, &command, codes[result], &native);
+    } else {
+        uflow_mc_reply(s, &command, "ok", &native);
+    }
+}
+
+static bool uflow_mc_publish_alias(BusControllerDev *ubc, Error **errp)
+{
+    if (!uflow_mc_enabled_get(OBJECT(ubc), NULL)) { return true; }
+    if (object_property_find(OBJECT(qdev_get_machine()), UFLOW_MC_PROPERTY)) {
+        error_setg(errp, "managed-cache profile requires one UBC per Guest");
+        return false;
+    }
+    object_property_add_alias(OBJECT(qdev_get_machine()), UFLOW_MC_PROPERTY,
+                               OBJECT(ubc), UFLOW_MC_PROPERTY);
+    uflow_mc_state(ubc, false)->alias_published = true;
+    return true;
+}
+
+static void uflow_mc_finalize(BusControllerDev *ubc)
+{
+    uflow_mw_finalize(ubc);
+    UFlowMcState *s = uflow_mc_state(ubc, false);
+    if (s) {
+        assert(!s->cache.in_flight);
+        if (s->alias_published &&
+            object_property_find(OBJECT(qdev_get_machine()), UFLOW_MC_PROPERTY)) {
+            object_property_del(OBJECT(qdev_get_machine()), UFLOW_MC_PROPERTY);
+        }
+        uflow_mc_destroy(&s->cache);
+        g_free(s->reply);
+        g_hash_table_remove(uflow_mc_states, ubc);
+        g_free(s);
+    }
+}
diff --git a/hw/ub/uflow_managed_write.inc b/hw/ub/uflow_managed_write.inc
new file mode 100644
index 0000000000000000000000000000000000000000..11e1c27b9e99cb10fb4fd6dac396f77f5639c196
--- /dev/null
+++ b/hw/ub/uflow_managed_write.inc
@@ -0,0 +1,304 @@
+/* Explicit normal metadata W control; caller holds BQL, including reentrant IO. */
+#include "hw/ub/uflow_managed_write_core.h"
+#define UFLOW_MW_PROPERTY "uflow-managed-write-control-v1"
+#define UFLOW_MW_FEATURE "uflow-managed-write-v1"
+typedef struct UFlowMwState {
+    bool enabled, alias_published;
+    UFlowManagedWrite write;
+    GsvaRouteAccess native;
+    UFlowMcCommand accepted;
+    BusControllerDev *ubc;
+    char *reply;
+} UFlowMwState;
+static GHashTable *uflow_mw_states;
+
+static UFlowMwState *uflow_mw_state(BusControllerDev *ubc, bool create)
+{
+    UFlowMwState *s;
+    if (!uflow_mw_states) {
+        if (!create) { return NULL; }
+        uflow_mw_states = g_hash_table_new(g_direct_hash, g_direct_equal);
+    }
+    s = g_hash_table_lookup(uflow_mw_states, ubc);
+    if (!s && create) {
+        s = g_new0(UFlowMwState, 1);
+        s->ubc = ubc;
+        g_hash_table_insert(uflow_mw_states, ubc, s);
+    }
+    return s;
+}
+
+static bool uflow_mw_active(BusControllerDev *ubc)
+{
+    UFlowMwState *s = uflow_mw_state(ubc, false);
+    return s && s->enabled && s->write.reads.active;
+}
+
+static bool uflow_mw_native_valid(void *opaque)
+{
+    UFlowMwState *s = opaque;
+    GsvaRouteAccess actual;
+    return s && (s->native.access_flags & 3) == 3 &&
+        gsva_route_resolve_pto(&g_gsva_routes, s->native.local_pa, 1,
+                              s->ubc->parent.cna, &actual) == GSVA_OK &&
+        gsva_route_access_equal(&actual, &s->native);
+}
+
+static int uflow_mw_transfer(UFlowMwState *s, uint64_t offset, uint8_t *bytes,
+                              uint32_t length, bool write)
+{
+    const GsvaRouteAccess *n = &s->native;
+    GsvaHomeIdentity identity = {.key = n->key, .home_cna = n->home_cna,
+        .token_id = n->token_id, .token_value = n->token_value,
+        .backing_token_id = n->backing_token_id};
+    return ubc_sim_dec_remote_io(s->ubc, n->key.home_va + offset,
+        n->backing_token_id, n->home_cna, bytes, length, true, write,
+        &identity) == MEMTX_OK ? 0 : -1;
+}
+
+static int uflow_mw_store(void *opaque, uint64_t offset, const uint8_t *bytes,
+                           uint32_t length)
+{
+    return uflow_mw_transfer(opaque, offset, (uint8_t *)bytes, length, true);
+}
+
+static int uflow_mw_fetch(void *opaque, uint64_t offset, uint8_t *bytes,
+                           uint32_t length)
+{
+    return uflow_mw_transfer(opaque, offset, bytes, length, false);
+}
+
+static bool uflow_mw_callback_matches(UFlowMwState *s, GsvaRouteEntry *route)
+{
+    GsvaRouteAccess actual;
+    return gsva_route_resolve_pto(&g_gsva_routes, route->local_pa, 1,
+                                  s->ubc->parent.cna, &actual) == GSVA_OK &&
+           gsva_route_access_equal(&actual, &s->native);
+}
+
+static bool uflow_mw_cpu_read(GsvaRouteEntry *route, uint64_t offset,
+    uint8_t *bytes, uint32_t length, MemTxResult *result)
+{
+    BusControllerDev *ubc = g_sim_decoder && g_sim_decoder->bcs ?
+        g_sim_decoder->bcs->ubc_dev : NULL;
+    UFlowMwState *s = ubc ? uflow_mw_state(ubc, false) : NULL;
+    int rc;
+    if (!s || !s->enabled || !s->write.reads.active ||
+        route->key.home_va != s->native.key.home_va) { return false; }
+    if (!uflow_mw_callback_matches(s, route)) {
+        uflow_mw_fail(&s->write); *result = MEMTX_ACCESS_ERROR; return true;
+    }
+    rc = uflow_mw_read(&s->write, offset, bytes, length, uflow_mw_store,
+                       uflow_mw_fetch, uflow_mw_native_valid, s);
+    if (rc == UFLOW_MC_MISS) { uflow_mw_fail(&s->write); }
+    *result = rc == UFLOW_MC_OK ? MEMTX_OK : MEMTX_ACCESS_ERROR;
+    return true;
+}
+
+static bool uflow_mw_cpu_write(GsvaRouteEntry *route, uint64_t offset,
+    const uint8_t *bytes, uint32_t length, MemTxResult *result)
+{
+    BusControllerDev *ubc = g_sim_decoder && g_sim_decoder->bcs ?
+        g_sim_decoder->bcs->ubc_dev : NULL;
+    UFlowMwState *s = ubc ? uflow_mw_state(ubc, false) : NULL;
+    int rc;
+    if (!s || !s->enabled || !s->write.reads.active ||
+        route->key.home_va != s->native.key.home_va) { return false; }
+    if (!uflow_mw_callback_matches(s, route)) {
+        uflow_mw_fail(&s->write); *result = MEMTX_ACCESS_ERROR; return true;
+    }
+    rc = uflow_mw_write(&s->write, offset, bytes, length, uflow_mw_store,
+                        uflow_mw_native_valid, s);
+    if (rc == UFLOW_MC_MISS) { uflow_mw_fail(&s->write); }
+    *result = rc == UFLOW_MC_OK ? MEMTX_OK : MEMTX_ACCESS_ERROR;
+    return true;
+}
+
+static bool uflow_mw_blocks_close(BusControllerDev *ubc, const GsvaKeyV1 *key)
+{
+    UFlowMwState *s = uflow_mw_state(ubc, false);
+    return s && s->enabled && s->write.reads.active &&
+           gsva_key_base_equal(&s->native.key, key);
+}
+
+static void uflow_mw_event(BusControllerDev *ubc, const GsvaKeyV1 *key,
+                            bool revoke)
+{
+    UFlowMwState *s = uflow_mw_state(ubc, false);
+    if (s && uflow_mw_blocks_close(ubc, key)) {
+        uflow_mw_invalidate(&s->write, revoke);
+    }
+}
+
+static int uflow_mw_fence(BusControllerDev *ubc, const GsvaKeyV1 *key)
+{
+    UFlowMwState *s = ubc ? uflow_mw_state(ubc, false) : NULL;
+    if (!s || !uflow_mw_blocks_close(ubc, key)) { return GSVA_OK; }
+    if (memcmp(key, &s->native.key, sizeof(*key))) { return GSVA_ERR_COH_PENDING; }
+    return uflow_mw_flush(&s->write, uflow_mw_store, uflow_mw_native_valid, s) ==
+           UFLOW_MC_OK ? GSVA_OK : GSVA_ERR_COH_PENDING;
+}
+
+static bool uflow_mw_decode(const char *wire, UFlowMcCommand *c)
+{
+    char proxy[446];
+    uint8_t neutral[UFLOW_MC_WIRE_BYTES];
+    if (!wire || strlen(wire) != 445 || strncmp(wire, "umw1:", 5)) {
+        return false;
+    }
+    /* Reuse the source-bound strict R wire parser, not its R authority. */
+    memcpy(proxy, wire, sizeof(proxy));
+    memcpy(proxy, "umc1:554d4331", 13);
+    if (proxy[14] == '5') { proxy[14] = '4'; }
+    if (!uflow_mc_decode(proxy, c) || wire[13] != '0' ||
+        wire[14] < '1' || wire[14] > '5' ||
+        memcmp(wire + 5, "554d5731", 8) || (c->n[MC_ACCESS] & 3) != 3) {
+        return false;
+    }
+    c->op = wire[14] - '0';
+    if (c->op == 5 && (!c->generation || !c->q[MC_MAP] || !c->q[MC_LEASE] ||
+        !memcmp(c->authority, (uint8_t[32]){0}, 32) ||
+        !memcmp(c->correlation, (uint8_t[32]){0}, 32) ||
+        !memcmp(c->descriptor, (uint8_t[32]){0}, 32))) { return false; }
+    memcpy(c->body, "UMW1", 4); c->body[4] = c->op;
+    uflow_mc_hash(c->body, sizeof(c->body), c->request);
+    memcpy(neutral, c->body, sizeof(neutral)); neutral[4] = 0;
+    uflow_mc_hash(neutral, sizeof(neutral), c->id);
+    return true;
+}
+
+static void uflow_mw_reply(UFlowMwState *s, const UFlowMcCommand *c,
+                            const char *code, const GsvaRouteAccess *native)
+{
+    static const char *ops[] = {"", "probe", "begin", "end", "status", "flush"};
+    static const char *qnames[] = {"map_id", "lease_epoch", "export_mem_id",
+        "remote_uba", "size", "segment_id", "epoch", "offset", "length"};
+    static const char *nnames[] = {"backing_token_id", "home_cna", "gsva_token_id",
+        "cache_policy", "p_tag", "access_flags", "owner_node", "node_count", "segment_flags"};
+    QDict *reply = qdict_new(), *stats = qdict_new(), *writes = qdict_new();
+    UFlowManagedCache *cache = &s->write.reads;
+    GString *text;
+    g_autofree char *request = uflow_mc_hex(c->request, 32);
+    g_autofree char *authority = uflow_mc_hex(c->authority, 32);
+    g_autofree char *correlation = uflow_mc_hex(c->correlation, 32);
+    g_autofree char *descriptor = uflow_mc_hex(c->descriptor, 32);
+    qdict_put_int(reply, "version", 1); qdict_put_str(reply, "feature", UFLOW_MW_FEATURE);
+    qdict_put_int(reply, "pid", getpid()); qdict_put_str(reply, "operation", ops[c->op]);
+    qdict_put_str(reply, "request_sha256", request); uflow_mc_put_u64(reply, "control_generation", c->generation);
+    qdict_put_str(reply, "authority_sha256", authority); qdict_put_str(reply, "correlation_sha256", correlation);
+    qdict_put_str(reply, "descriptor_sha256", descriptor); qdict_put_str(reply, "code", code);
+    qdict_put_str(reply, "scope", "UFlow-Catalog-exclusive-W-with-native-RW-verification");
+    qdict_put_bool(reply, "active", cache->active); qdict_put_bool(reply, "uncertain", s->write.failed);
+    qdict_put_int(reply, "in_flight", cache->in_flight); qdict_put_int(reply, "write_in_flight", s->write.pending);
+    qdict_put_int(reply, "cache_pages", cache->pages); qdict_put_int(reply, "dirty_bytes", s->write.dirty);
+    if (native) {
+        QDict *alias = qdict_new();
+        for (size_t i = 0; i < 9; i++) {
+            uint64_t v = i == MC_MAP ? native->map_id : i == MC_LEASE ? native->lease_epoch : c->q[i];
+            uflow_mc_put_u64(alias, qnames[i], v); qdict_put_int(alias, nnames[i], c->n[i]);
+        }
+        qdict_put_str(alias, "descriptor_sha256", descriptor); qdict_put_obj(reply, "native_alias", QOBJECT(alias));
+    } else { qdict_put_null(reply, "native_alias"); }
+    uflow_mc_put_u64(stats, "read_callbacks", cache->counters.reads);
+    uflow_mc_put_u64(stats, "cache_hits", cache->counters.hits);
+    uflow_mc_put_u64(stats, "remote_fill_calls", cache->counters.fills);
+    uflow_mc_put_u64(stats, "remote_fill_requested_bytes", cache->counters.remote_bytes);
+    uflow_mc_put_u64(stats, "remote_fill_successful_bytes", cache->counters.successful_bytes);
+    uflow_mc_put_u64(stats, "evictions", cache->counters.evictions);
+    uflow_mc_put_u64(stats, "invalidations", cache->counters.invalidations);
+    uflow_mc_put_u64(stats, "late_fill_discards", cache->counters.late_discards);
+    uflow_mc_put_u64(stats, "remote_failures", cache->counters.remote_failures);
+    qdict_put_bool(stats, "saturated", cache->counters.saturated);
+    uflow_mc_put_u64(writes, "cpu_callbacks", s->write.writes);
+    uflow_mc_put_u64(writes, "accepted_bytes", s->write.accepted_bytes);
+    uflow_mc_put_u64(writes, "strict_flush_calls", s->write.flushes);
+    uflow_mc_put_u64(writes, "completed_bytes", s->write.completed_bytes);
+    uflow_mc_put_u64(writes, "failures", s->write.failures);
+    qdict_put_obj(reply, "counters", QOBJECT(stats)); qdict_put_obj(reply, "write_counters", QOBJECT(writes));
+    text = qobject_to_json(QOBJECT(reply)); assert(text->len <= 4096);
+    g_free(s->reply); s->reply = g_string_free(text, false); qobject_unref(reply);
+}
+
+static bool uflow_mw_enabled_get(Object *obj, Error **errp)
+{
+    UFlowMwState *s = uflow_mw_state(BUS_CONTROLLER_DEV(obj), false);
+    return s && s->enabled;
+}
+
+static void uflow_mw_enabled_set(Object *obj, bool value, Error **errp)
+{
+    if (DEVICE(obj)->realized) { error_setg(errp, "managed W is construction-only"); return; }
+    uflow_mw_state(BUS_CONTROLLER_DEV(obj), true)->enabled = value;
+}
+
+static char *uflow_mw_control_get(Object *obj, Error **errp)
+{
+    UFlowMwState *s = uflow_mw_state(BUS_CONTROLLER_DEV(obj), false);
+    if (!s || !s->enabled || !s->reply) { error_setg(errp, "no enabled W metadata transaction"); return NULL; }
+    return g_strdup(s->reply);
+}
+
+static void uflow_mw_control_set(Object *obj, const char *wire, Error **errp)
+{
+    BusControllerDev *ubc = BUS_CONTROLLER_DEV(obj);
+    UFlowMwState *s = uflow_mw_state(ubc, false);
+    UFlowMcCommand c;
+    GsvaRouteAccess native;
+    static const char *codes[] = {"ok", "denied", "busy", "denied", "replay", "full", "unknown"};
+    int rc;
+    if (!s || !s->enabled || !uflow_mw_decode(wire, &c)) {
+        error_setg(errp, "disabled or malformed bounded W metadata control"); return;
+    }
+    if (c.op == 3 || c.op == 5) {
+        /* Operation byte alone may differ. Bind authority, correlation, opaque
+         * descriptor and every native/range field to the exact accepted grant. */
+        bool accepted = c.generation == s->accepted.generation &&
+            !memcmp(c.body + 8, s->accepted.body + 8, sizeof(c.body) - 8);
+        bool was_active = s->write.reads.active;
+        rc = !accepted ? UFLOW_MC_DENIED : c.op == 3 ?
+            uflow_mw_end(&s->write, c.generation, c.id, uflow_mw_store, uflow_mw_native_valid, s) :
+            uflow_mw_flush(&s->write, uflow_mw_store, uflow_mw_native_valid, s);
+        uflow_mw_reply(s, &c, codes[rc], accepted ? &s->native : NULL);
+        if (c.op == 3 && was_active && rc == UFLOW_MC_OK) {
+            /* At most512 accepted grant pairs; metadata only, no hot-loop log. */
+            (qemu_log)("UFLOW_MW_END generation=%" PRIu64 " active=0 dirty=0 fills=0 pages=0\n", c.generation);
+        }
+        return;
+    }
+    if (!uflow_mc_resolve(ubc, &c, &native) || (native.access_flags & 3) != 3) {
+        uflow_mw_reply(s, &c, "denied", NULL); return;
+    }
+    if (c.op == 2) {
+        UFlowMcState *r = uflow_mc_state(ubc, false);
+        rc = r && r->cache.active ? UFLOW_MC_BUSY :
+            uflow_mw_begin(&s->write, c.generation, c.id, c.correlation, c.q[MC_OFFSET], c.q[MC_LENGTH]);
+        if (rc == UFLOW_MC_OK) {
+            s->native = native; s->accepted = c;
+            (qemu_log)("UFLOW_MW_BEGIN generation=%" PRIu64 " offset=%" PRIu64 " length=%" PRIu64 " active=1 dirty=0\n",
+                       c.generation, c.q[MC_OFFSET], c.q[MC_LENGTH]);
+        }
+        uflow_mw_reply(s, &c, codes[rc], &native);
+    } else { uflow_mw_reply(s, &c, s->write.failed ? "unknown" : "ok", &native); }
+}
+
+static bool uflow_mw_publish_alias(BusControllerDev *ubc, Error **errp)
+{
+    if (!uflow_mw_enabled_get(OBJECT(ubc), NULL)) { return true; }
+    if (object_property_find(OBJECT(qdev_get_machine()), UFLOW_MW_PROPERTY)) {
+        error_setg(errp, "managed W requires one UBC per Guest"); return false;
+    }
+    object_property_add_alias(OBJECT(qdev_get_machine()), UFLOW_MW_PROPERTY, OBJECT(ubc), UFLOW_MW_PROPERTY);
+    uflow_mw_state(ubc, false)->alias_published = true; return true;
+}
+
+static void uflow_mw_finalize(BusControllerDev *ubc)
+{
+    UFlowMwState *s = uflow_mw_state(ubc, false);
+    if (!s) { return; }
+    assert(!s->write.pending && !s->write.reads.in_flight);
+    if (s->alias_published && object_property_find(OBJECT(qdev_get_machine()), UFLOW_MW_PROPERTY)) {
+        object_property_del(OBJECT(qdev_get_machine()), UFLOW_MW_PROPERTY);
+    }
+    uflow_mc_destroy(&s->write.reads); g_free(s->reply);
+    g_hash_table_remove(uflow_mw_states, ubc); g_free(s);
+}
