+class ProfileMetadataTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls): cls.run_dir, cls.case, cls.requests, cls.plan, cls.prof = make_fixture(); cls.counter = 0
+
+    def mutated(self, ref, update):
+        value = m.ev.decode(m.bound(ref)); update(value)
+        type(self).counter += 1
+        return save(self.run_dir / ('negative-%03d.json' % self.counter), value)
+
+    def validate(self, ref): return m.validate_fixture_registration(ref['path'], ref['sha256'], HELPER)
+
+    def test_actual_profile_writer(self):
