+#!/usr/bin/env python3
+"""Validate a private QEMU ELF and its source/object/control-link closure."""
+import argparse
+import difflib
+import json
+import os
+from pathlib import Path
+import stat
+import struct
+import subprocess
+
+from uflow_qemu_evidence import bound,check,decode,digest,read
+
+INTERFACE='mem-service-private-qemu-profile-v1'
+PROFILE='mem-service-gsva-scatter-home-v1'
+BASE_COMMIT='f2ef54f454b661e551a8619f9feb7406752a1b1a'
+BASE_BINARY='56fab4e5d8c50c559f76c8ddbae9d6e1661e4764a6f927db2c3706e8199e5d4c'
+BASE_SOURCE={
+    'hw/ub/ub_ubc.c':'cf803e8e898764002bea02307ff4f94d20320fac44226fa1b54c40f5154cf043',
+    'hw/ub/ub_ummu.c':'8c9a7982daec0d626129a70d2224f13cc9270d29a0db54d6d1025208c27a400f',
+    'include/hw/ub/ub_ummu.h':'6cfd9c76802d9fa1d37f5954de55290841041f873800071449bae069d5356e1b'}
+
+
+def elf_functions(raw):
+    check(raw[:6]==b'\x7fELF\x02\x01' and struct.unpack_from('<H',raw,18)[0]==183,
+          'ordinary AArch64 ELF64 executable required')
+    check(struct.unpack_from('<H',raw,16)[0] in (2,3),'ELF is not an executable/PIE')
+    offset=struct.unpack_from('<Q',raw,40)[0];size,count=struct.unpack_from('<HH',raw,58)
+    check(size==64 and 0<count<65536 and offset+size*count<=len(raw),'ELF section bounds')
+    sections=[struct.unpack_from('<IIQQQQIIQQ',raw,offset+i*size) for i in range(count)]
+    tables=[s for s in sections if s[1]==2];check(len(tables)==1,'one ordinary symbol table required')
+    table=tables[0];check(table[9]==24 and table[5]%24==0 and table[4]+table[5]<=len(raw) and table[6]<count,'symbol bounds')
+    strings=sections[table[6]];check(strings[1]==3 and strings[4]+strings[5]<=len(raw),'symbol string bounds')
+    names=raw[strings[4]:strings[4]+strings[5]];wanted={'gsva_arm_mmu_translate_full','ummu_dma_s1_translate_page'};found={}
+    for at in range(table[4],table[4]+table[5],24):
+        index,info,_,section,address,length=struct.unpack_from('<IBBHQQ',raw,at)
+        check(index<len(names),'symbol name index')
+        end=names.find(b'\0',index);check(end>=index,'symbol name terminator')
+        name=names[index:end].decode('ascii',errors='replace')
+        if name in wanted:
+            check(name not in found and info&15==2 and info>>4==1 and 0<section<count and
+                  sections[section][2]&4 and address>0 and length>0,'candidate function symbol missing/invalid')
+            found[name]={'address':address,'bytes':length}
+    check(set(found)==wanted,'candidate function symbol closure missing')
+    return found
+
+
+def validate(manifest_path,external_manifest_sha256,qemu_binary_path):
+    body,_=read(manifest_path,8<<20);check(digest(body)==external_manifest_sha256,'external manifest hash mismatch')
+    m=decode(body)
+    check(m['schema']==1 and m['interface']==INTERFACE and m['profile_id']==PROFILE and
+          m['base_qemu_commit']==BASE_COMMIT and m['base_binary_sha256']==BASE_BINARY and
+          m['runtime_tested'] is False and m['authority_to_boot_or_replace_existing_binary'] is False,
+          'wrong source-only private QEMU profile')
+    binary=Path(qemu_binary_path)
+    check(str(binary)==m['qemu_binary']['path'],'selected executable is outside the accepted release identity')
+    info=binary.lstat();check(stat.S_ISREG(info.st_mode) and stat.S_IMODE(info.st_mode)==0o755 and
+                              os.access(binary,os.X_OK),'ordinary executable mode required')
+    raw=bound(m['qemu_binary'],256<<20);symbols=elf_functions(raw)
+    check(digest(raw)!=BASE_BINARY,'candidate cannot silently select the old runtime')
+    check(m['baseline_binary']['sha256']==BASE_BINARY and m['original_binary']['sha256']==BASE_BINARY,
+          'exact fixed-binary control identity missing')
+    bound(m['baseline_binary'],256<<20);bound(m['original_binary'],256<<20)
+    check(set(m['sources'])==set(BASE_SOURCE),'exact three-file source delta required')
+    patch=''
+    for name in BASE_SOURCE:
+        row=m['sources'][name];check(row['base']['sha256']==BASE_SOURCE[name],'wrong base source bytes')
+        before=bound(row['base'],2<<20).decode();after=bound(row['candidate'],2<<20).decode()
+        check(before!=after,'source change missing')
+        patch+='diff --git a/'+name+' b/'+name+'\n'+''.join(difflib.unified_diff(before.splitlines(keepends=True),
+                 after.splitlines(keepends=True),fromfile='a/'+name,tofile='b/'+name))
+    actual_patch=bound(m['patch'],128<<10);check(actual_patch==patch.encode(),'patch/source delta mismatch')
+    header=m['sources']['include/hw/ub/ub_ummu.h']
+    before=bound(header['base']).decode();after=bound(header['candidate']).decode()
+    prototype='int ummu_dma_s1_translate_page(UMMUState *ummu, UBDevice *udev, uint32_t tid,\n                               uint64_t iova, uint64_t *physical_page);\n'
+    check(after.count(prototype)==1 and after.replace(prototype,'').replace('\n\n\n','\n\n')==before.replace('\n\n\n','\n\n'),
+          'header must add only the new prototype; existing ABI declarations changed')
+    objects=decode(bound(m['object_compilation'],128<<10));check(len(objects['results'])==2,'two actual object compile receipts required')
+    changed=m['changed_objects'];check(set(changed)=={'libcommon.fa.p/hw_ub_ub_ubc.c.o','libcommon.fa.p/hw_ub_ub_ummu.c.o'},'wrong changed object set')
+    for old,obj in changed.items():
+        bound(obj,16<<20);name='hw/ub/'+Path(obj['path']).stem+'.c'
+        rows=[r for r in objects['results'] if r['source']==name];check(len(rows)==1,'object/source binding absent')
+        r=rows[0];argv=r['compiler_argv'];check(r['exit']==0 and r['object_sha256']==obj['sha256'] and
+            r['source_sha256']==m['sources'][name]['candidate']['sha256'] and
+            argv[argv.index('-c')+1]==m['sources'][name]['candidate']['path'] and argv[argv.index('-o')+1]==obj['path'],
+            'actual object compiler/source identity mismatch')
+    baseline=decode(bound(m['baseline_command'],256<<10));candidate=decode(bound(m['candidate_command'],256<<10))
+    a,b=baseline['argv'],candidate['argv'];check(baseline['cwd']==candidate['cwd'] and a[:2]==b[:2]==['cc','-o'] and len(a)==len(b),
+                                              'control/candidate recipe identity mismatch')
+    check(a[2]==m['baseline_binary']['path'] and b[2]==m['linked_candidate_binary']['path'],'link output binding mismatch')
+    bound(m['linked_candidate_binary'],256<<20)
+    check(m['linked_candidate_binary']['sha256']==m['qemu_binary']['sha256'],'release bytes differ from linked candidate')
+    counts={name:0 for name in changed}
+    for old,new in zip(a[3:],b[3:]):
+        if old in changed:
+            counts[old]+=1;check(new==changed[old]['path'],'candidate object replacement mismatch')
+        else:check(old==new,'unreviewed link input/flag change')
+    check(all(n==1 for n in counts.values()),'affected objects missing/duplicated in actual link')
+    reused=decode(bound(m['reused_input_identities'],2<<20));check(1000<len(reused)<5000,'incomplete or excessive reused input closure')
+    for path,row in reused.items():
+        p=Path(path);check(p.is_absolute() and str(p.resolve())==row['resolved'],'reused input target identity changed')
+        check(row['bytes']!=0 or p.name in ('block.syms','qemu.syms'),'empty object/library input rejected')
+        bound({'path':row['resolved'],'bytes':row['bytes'],'sha256':row['sha256']},512<<20,allow_empty=True)
+    for arg in a[3:]:
+        if arg.endswith(('.o','.a','.fa','.so')) or arg.startswith('@'):
+            name=arg[1:] if arg.startswith('@') else arg;p=Path(name)
+            if not p.is_absolute():p=Path(baseline['cwd'])/p
+            check(str(p) in reused,'link recipe input not present in the revalidated closure')
+    for ref in m['toolchain'].values():bound(ref,128<<20)
+    ar=Path('/usr/bin/ar').resolve()
+    check(str(ar)==m['toolchain']['ar']['path'],'unexpected archive inspection tool')
+    thin=decode(bound(m['thin_archive_members'],512<<10));seen=set()
+    for arg in dict.fromkeys(a[3:]):
+        if not arg.endswith(('.a','.fa')):continue
+        archive=Path(arg)
+        if not archive.is_absolute():archive=Path(baseline['cwd'])/archive
+        data,_=read(archive,512<<20)
+        if data[:8]!=b'!<thin>\n':continue
+        result=subprocess.run([str(ar),'t',str(archive)],capture_output=True,timeout=20)
+        check(result.returncode==0 and len(result.stdout)<512<<10,'thin archive member inspection failed')
+        names=result.stdout.decode().splitlines()
+        check(thin.get(str(archive))==names,'thin archive member list changed')
+        for name in names:
+            member=Path(name)
+            if not member.is_absolute():member=archive.parent/member
+            check(str(member.resolve()) in reused,'thin archive member missing from verified reused input closure')
+        seen.add(str(archive))
+    check(seen==set(thin),'thin archive closure mismatch')
+    link=decode(bound(m['link_result'],128<<10))
+    check(link['status']=='PASS_PRIVATE_QEMU_ELF_CANDIDATE_ONLY' and link['baseline_exact_fixed_binary'] is True and
+          link['candidate_sha256']==m['qemu_binary']['sha256'] and link['patch_sha256']==m['patch']['sha256'] and
+          link['runtime_replaced'] is False and link['QEMU_or_Guest_executed'] is False,'actual link receipt mismatch')
+    for ref in m['provenance'].values():bound(ref,128<<20)
+    return {'schema':1,'interface':INTERFACE,'profile_id':PROFILE,'status':'PASS_HOST_QEMU_PROFILE_ONLY',
+        'producer_manifest_sha256':external_manifest_sha256,'base_qemu_commit':BASE_COMMIT,'base_binary_sha256':BASE_BINARY,
+        'patch_sha256':m['patch']['sha256'],'qemu_binary':str(binary),'qemu_binary_sha256':m['qemu_binary']['sha256'],
+        'source_closure':m['sources'],'object_closure':changed,'link_closure':{'baseline':m['baseline_command'],
+         'candidate':m['candidate_command'],'reused_inputs':m['reused_input_identities'],'link_result':m['link_result']},
+        'candidate_symbols':symbols,'reused_inputs_verified':len(reused),'runtime_tested':False,
+        'authority_to_boot_or_replace_existing_binary':False,'authority_to_mutate_ledger':False}
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    p.add_argument('--manifest',required=True);p.add_argument('--manifest-sha256',required=True);p.add_argument('--qemu-binary',required=True)
+    a=p.parse_args();print(json.dumps(validate(a.manifest,a.manifest_sha256,a.qemu_binary)))
+
+
+if __name__=='__main__':main()
