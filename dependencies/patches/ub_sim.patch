+    table=tables[0];check(table[9]==24 and table[5]%24==0 and table[4]+table[5]<=len(raw) and table[6]<count,'ELF symbol table bounds')
+    strings=sections[table[6]];check(strings[1]==3 and strings[4]+strings[5]<=len(raw),'ELF symbol string bounds')
+    names=raw[strings[4]:strings[4]+strings[5]]
