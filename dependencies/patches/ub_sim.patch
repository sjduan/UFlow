+        actual_pid, uid, _ = struct.unpack('3i', self.sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, 12))
+        if (actual_pid, uid) != (pid, os.geteuid()):
+            raise RuntimeError('Guest control endpoint peer identity mismatch')
