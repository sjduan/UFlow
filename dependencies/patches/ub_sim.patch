+    if path.resolve()!=path or not stat.S_ISREG(info.st_mode) or not 0<info.st_size<128<<10:
+        raise ValueError('ordinary same-release source dependency required')
+    raw=path.read_bytes()
+    if hashlib.sha256(raw).hexdigest()!=pin:raise ValueError('metadata source dependency drift: '+name)
+    m=types.ModuleType('_metadata_v4_'+name[:-3]);m.__file__=str(path)
+    exec(compile(raw,str(path),'exec'),m.__dict__);return m
