+def registry_history(directory, expected_head):
+    root = Path(directory); previous = '0' * 64; rows = []
+    check(root.parent == PREFIX / 'registry' and re.fullmatch('c[0-9]{3}', root.name) and root.resolve() == root,
+          'new production registry namespace required')
+    if root.exists():
+        files = sorted(p for p in root.iterdir() if p.name != '.lock')
+        check(len(files) <= 256 and all(re.fullmatch('[0-9]{6}\.json', p.name) for p in files), 'torn/unknown registry')
+        for number, p in enumerate(files, 1):
+            raw, _ = ev.read(p, 1 << 20); r = ev.decode(raw)
+            check(p.name == '%06d.json' % number and r['schema'] == 2 and r['interface'] == INTERFACE and
+                  r['kind'] == 'profile-registry-entry-v2' and r['sequence'] == number and r['previous_sha256'] == previous,
+                  'registry schema/chain gap/conflict')
+            entry = r['metadata']; check(entry['run'] == root.name, 'registry case/run conflict')
+            check(entry == validate_registration(entry['request_manifest_path'], entry['request_manifest_sha256'], entry['helper_path']),
+                  'registry entry changed since fresh validation')
+            previous = digest(raw); rows.append((r, previous))
+    check(expected_head == previous, 'stale registry head/replay')
+    return rows
+
+
+def append_registration(directory, expected_head, entry):
+    check(entry.get('kind') == 'validated-profile-metadata-v2' and entry.get('HOST_fixture_only') is False,
+          'HOST fixture/quarantine cannot enter production registry')
+    again = validate_registration(entry['request_manifest_path'], entry['request_manifest_sha256'], entry['helper_path'])
+    check(entry == again, 'fresh registration differs')
+    root = Path(directory)
+    check(str(root) == str(PREFIX / 'registry' / entry['run']) and root.resolve() == root, 'wrong new registry root')
+    root.mkdir(parents=True, exist_ok=True)
+    fd = os.open(root / '.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
+    try:
+        check(stat.S_ISREG(os.fstat(fd).st_mode) and os.fstat(fd).st_nlink == 1, 'invalid registry lock')
+        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        # Determine the current head without accepting a caller-selected prefix.
+        files = sorted(root.glob('[0-9][0-9][0-9][0-9][0-9][0-9].json'))
+        head = digest(ev.read(files[-1], 1 << 20)[0]) if files else '0' * 64
+        rows = registry_history(root, head)
+        for old, _ in rows:
+            m = old['metadata']
+            if m['file']['path'] == entry['file']['path'] or m['publication_binding']['event_line_sha256'] == entry['publication_binding']['event_line_sha256']:
+                check(m == entry and expected_head in (old['previous_sha256'], head), 'conflicting duplicate metadata/event')
+                return {'sequence': old['sequence'], 'head_sha256': head, 'idempotent': True}
+        check(expected_head == head, 'stale append head')
+        row = {'schema': 2, 'interface': INTERFACE, 'kind': 'profile-registry-entry-v2', 'sequence': len(rows) + 1,
+               'previous_sha256': head, 'metadata': entry}
+        raw = ev.canonical(row) + b'\n'; temp = root / ('.publishing-' + uuid.uuid4().hex)
+        try:
+            with temp.open('xb') as stream:
+                stream.write(raw); stream.flush(); os.fsync(stream.fileno())
+            temp.chmod(0o444); os.link(temp, root / ('%06d.json' % row['sequence']))
+        finally:
+            if temp.exists(): temp.unlink()
+        d = os.open(root, os.O_DIRECTORY | os.O_RDONLY)
+        try: os.fsync(d)
+        finally: os.close(d)
+        return {'sequence': row['sequence'], 'head_sha256': digest(raw), 'idempotent': False}
+    finally:
+        os.close(fd)
+
