+#!/usr/bin/env python3
+"""Profile-aware metadata and exact retained union. Never a ledger or SDK ACK.
+
+Production entry points require externally reviewed case/plan digests. HOST
+fixtures have separate entry points and cannot enter the production registry.
+All dependency bytes are checked before fresh execution; no pyc/import cache.
+"""
+import argparse
+import builtins
+import fcntl
+import os
+from pathlib import Path
+import re
+import stat
+import time
+import types
+import uuid
+
+ROOT = Path('/workspace/uflow/runs/mem-service-shared-pool-20261108')
+PREFIX = ROOT / 'implementation/c064-profile-metadata-v1'
+OLD = ROOT / 'implementation/c064-platform-v1'
+INTERFACE = 'mem-service-profile-metadata-v2'
+PROFILE_SHA = 'eb667be0a3c40b61ebb15d3cd487137e9febf45cbd67b86b7f48254ae330601c'
+PROFILE_CODE_SHA = 'e295a26c99216ac027dd64f54ed323b211bc529ee7fb6753dac4e422bc7fb43e'
+BINARY_SHA = '3c34d92dc970359036a969bd109a61086e23e5d3b0d908c9143ee62beb006779'
+WRITER_SHA = '42c93476fb56219f8e04301c3bcb24d85f48be969406f679f538fff981fb904d'
+CANDIDATE_SHA = '57df8009657ed8f806743a758b6edf133d0d97ee8f2a0cf922d41b8d9a567abb'
+GRAPH_SHA = '12c6ce496db6a6e184698c2a1b755c5c06c163ce5ad15ab48a32107d5044ad73'
+PHYSICAL_SHA = 'f3e0da25ab9d9aa14e4253575a46f88482945bb534a5a831081b177538a1ded2'
+HISTORICAL_CANONICAL_SHA = '56d8276f2c6e6b317202af70ebe3dd53a007e1cbaa130fc2281ee421de13358d'
+DEP_PINS = {
+    'uflow_qemu_evidence.py': '0dc9cbe9909bca7d53dcc6aa58b72f72942e699999ecf420055528cbd98c0995',
+    'uflow_qemu_metadata.py': '3edf6eb9e99cfe1a194d273bd11ae0e21f2ddcd3fff7fed2fd835ec9f5c227e5',
+    'uflow_qemu_profile.py': PROFILE_CODE_SHA,
+}
+
+
+def _load_dependencies():
+    import hashlib
+    here = Path(__file__).resolve().parent
+    sources = {}
+    for name, pin in DEP_PINS.items():
+        p = here / name
+        info = p.lstat()
+        if not stat.S_ISREG(info.st_mode) or p.resolve() != p or not 0 < info.st_size < 128 << 10:
+            raise ValueError('ordinary local pinned dependency required')
+        raw = p.read_bytes()
+        if hashlib.sha256(raw).hexdigest() != pin:
+            raise ValueError('dependency source drift: ' + name)
+        sources[name] = raw
+    modules = {}
+    for name, raw in sources.items():
+        m = types.ModuleType('_profile_v2_' + name[:-3]); m.__file__ = str(here / name)
+        def importer(key, *args, **kwargs):
+            if key == 'uflow_qemu_evidence':
+                return modules['uflow_qemu_evidence.py']
+            return builtins.__import__(key, *args, **kwargs)
+        m.__dict__['__builtins__'] = {**vars(builtins), '__import__': importer}
+        exec(compile(raw, m.__file__, 'exec'), m.__dict__)
+        modules[name] = m
+    return modules
