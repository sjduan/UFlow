+"""Real UNIX control protocol tests; no QEMU or physical device launch."""
+import importlib.util
+import json
+import os
+from pathlib import Path
+import socket
+import sys
+import tempfile
+import threading
+import time
+import unittest
+
+SOURCE = Path(__file__).resolve().parents[1] / 'scripts/uflow_guest_group.py'
+spec = importlib.util.spec_from_file_location('uflow_guest_group', SOURCE)
+guest = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(guest)
+
+
+@unittest.skipUnless(sys.platform.startswith('linux'), 'real Linux UNIX control tests')
+class ControlProtocol(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix='q', dir=os.environ.get('UFLOW_TEST_WORK_DIR'))
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+
+    def server(self, handler):
+        listener = socket.socket(socket.AF_UNIX)
+        path = self.root / 's'
+        listener.bind(str(path))
+        listener.listen(1)
+        listener.settimeout(3)
+        errors = []
+
+        def serve():
+            try:
+                with listener.accept()[0] as conn:
+                    conn.settimeout(3)
+                    handler(conn)
+            except BaseException as error:
+                errors.append(error)
+            finally:
+                listener.close()
+
+        thread = threading.Thread(target=serve)
+        thread.start()
+
+        def close():
+            thread.join(timeout=4)
+            self.assertFalse(thread.is_alive())
+            self.assertEqual(errors, [])
+        self.addCleanup(close)
+        return path
+
+    def test_qmp_correlates_id_and_skips_events(self):
+        def respond(conn):
+            conn.sendall(b'{"QMP":{"version":{}}}\n')
+            with conn.makefile('rb') as stream:
+                for _ in range(2):
+                    request = json.loads(stream.readline())
+                    conn.sendall(b'{"event":"TEST"}\n')
+                    conn.sendall((json.dumps({'id': request['id'], 'return': {'status': 'running'}})+'\n').encode())
+        channel = guest.QMP(self.server(respond), time.monotonic()+3)
+        self.addCleanup(channel.close)
+        channel.verify_peer(os.getpid())
+        self.assertEqual(channel.command('query-status'), {'status': 'running'})
+        with self.assertRaises(ValueError):
+            channel.command('system_reset')
+
+    def test_oversized_control_reply_rejected(self):
+        def respond(conn):
+            conn.sendall(b'x'*65537)
+        channel = guest.Channel(self.server(respond), time.monotonic()+3)
+        self.addCleanup(channel.close)
+        with self.assertRaises(RuntimeError):
+            channel.line(time.monotonic()+3)
+
+    def test_peer_mismatch_rejected(self):
+        path = self.server(lambda conn: conn.recv(1))
+        channel = guest.Channel(path, time.monotonic()+3)
+        self.addCleanup(channel.close)
+        with self.assertRaises(RuntimeError):
+            channel.verify_peer(os.getpid()+100000)
+        channel.sock.sendall(b'x')
+
+    def test_missing_endpoint_times_out(self):
+        start = time.monotonic()
+        with self.assertRaises(TimeoutError):
+            guest.Channel(self.root/'missing', start+.05)
+        self.assertLess(time.monotonic()-start, .5)
+
+
+if __name__ == '__main__':
+    unittest.main()
