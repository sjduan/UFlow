++        unsigned a = wire[5 + i * 2], b = wire[6 + i * 2];
++        if (!((a >= '0' && a <= '9') || (a >= 'a' && a <= 'f')) ||
++            !((b >= '0' && b <= '9') || (b >= 'a' && b <= 'f'))) {
++            return false;
++        }
++        c->body[i] = ((a <= '9' ? a - '0' : a - 'a' + 10) << 4) |
++                       (b <= '9' ? b - '0' : b - 'a' + 10);
++    }
++    if (memcmp(c->body, "UMC1", 4) || c->body[4] < 1 || c->body[4] > 4 ||
++        c->body[5] || c->body[6] || c->body[7]) {
++        return false;
++    }
++    c->op = c->body[4];
++    c->generation = ldq_be_p(c->body + 8);
++    memcpy(c->authority, c->body + 16, 32);
++    memcpy(c->correlation, c->body + 48, 32);
++    memcpy(c->descriptor, c->body + 80, 32);
