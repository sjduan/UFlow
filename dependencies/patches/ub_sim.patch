+    def test_false_runtime_claim(self):self.invalid_manifest('runtime',lambda m:m.update(runtime_tested=True))
+    def test_wrong_ancestor(self):self.invalid_manifest('ancestor',lambda m:m['base_profile'].update(sha256='0'*64))
+    def test_changed_source(self):self.invalid_manifest('source',lambda m:m['sources']['hw/ub/ub_ubc.c'].update(sha256='0'*64))
+    def test_wrong_source_set(self):self.invalid_manifest('set',lambda m:m['sources'].pop('hw/ub/uflow_managed_cache.inc'))
+    def test_wrong_selected_elf(self):
+        with self.assertRaises(ValueError):q.validate(PROFILE,t.reference(PROFILE)['sha256'],profile['control_binary']['path'])
+
+
+if __name__=='__main__':
+    output=io.StringIO();suite=unittest.TestSuite([unittest.defaultTestLoader.loadTestsFromTestCase(c) for c in (CurrentTerminal,ActualProfile)])
+    result=unittest.TextTestRunner(stream=output,verbosity=2).run(suite)
+    report={'schema':3,'kind':'actual-current-terminal-and-profile-HOST-tests','tests':result.testsRun,'failures':len(result.failures),
+            'errors':len(result.errors),'skips':len(result.skipped),'transcript':output.getvalue(),'Guest_or_ledger_mutation':False,
