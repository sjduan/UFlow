+def config_ancestry(executable):
+    """Exact source-derived bundle, relocatable and configured-prefix paths.
+
+    Both non-bundle branches must be absent, so no branch-selection assumption
+    can hide a config. Directory times are inference in the reviewed controlled
+    execution model, not evidence against malicious root/timestamp tampering.
+    """
+    executable=Path(executable); targets=(executable.parent/'qemu-bundle',
+        executable.parent.parent/'etc/qemu/qemu.conf',Path('/usr/local/etc/qemu/qemu.conf'))
+    result=[]
+    for target in targets:
+        missing=[]; path=target
+        for _ in range(12):
+            try: info=path.lstat(); break
+            except FileNotFoundError: missing.append(str(path));path=path.parent
+        else: raise ValueError('default config ancestry depth exceeded')
+        check(missing and path.resolve()==path and stat.S_ISDIR(info.st_mode) and info.st_uid==os.geteuid(),
+              'actual default config/bundle exists or ancestor aliased/foreign')
+        result.append({'target':str(target),'absent_components':missing,'ancestor':str(path),
+                       'identity':{**ev.identity(info),'ctime_ns':info.st_ctime_ns,'mode':stat.S_IMODE(info.st_mode)}})
+    return result
+
