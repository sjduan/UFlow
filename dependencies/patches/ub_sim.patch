+"""Lightweight source extraction and fail-closed request contract tests."""
+import hashlib
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'scripts'))
+from uflow_c064_platform import extract_function,assess_c064_metadata,evaluate_terminal_v2
+from uflow_qemu_evidence import EvidenceError,immutable_json,INTERFACE
+from uflow_gsva_scatter_host import run
+
+
+class Contracts(unittest.TestCase):
+    def test_extracts_definition_after_prototype_and_ignores_quoted_braces(self):
+        text='int chosen(int a);\nstatic int chosen(int a)\n{ const char *s="}"; /* { */ return a; }\n'
+        actual=extract_function(text,'chosen')
+        self.assertTrue(actual.startswith('static int chosen'))
+        self.assertTrue(actual.endswith('return a; }\n'))
+
+    def test_missing_and_duplicate_definition_rejected(self):
+        for text in ['int f(void);','int f(void) {return 1;}\nint f(void) {return 2;}']:
+            with self.subTest(text=text),self.assertRaises(EvidenceError):extract_function(text,'f')
+
+    def test_old_c044_state_rejected_before_other_evidence_reads(self):
+        with self.assertRaisesRegex(EvidenceError,'wrong c064'):
+            assess_c064_metadata({'sha256':'b6592a7442e7cb8540f340168a215fe6cc8cf669c7e87fedb7403ced2fc6c307'},
+                                 {'sha256':'x'},{'sha256':'x'},{})
+
+    def test_external_candidate_hash_required_before_outputs_or_compiler(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            root=Path(tmp);p=root/'profile.json';p.write_bytes(b'{}')
+            with self.assertRaisesRegex(EvidenceError,'external candidate profile hash'):
