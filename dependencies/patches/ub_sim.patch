@@ -0,0 +1,151 @@
+#!/usr/bin/env python3
+"""c064 metadata-only analysis and private source-candidate binding helpers."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import re
+
+from uflow_qemu_evidence import EvidenceError, bound, canonical, check, decode, digest, immutable_json, reviewed
+
+STATE_SHA = '163f7500836dc4fd199d34f83a0e08453ab05255f8b15a57338052df4601d5b0'
+SERIAL_SHA = 'a77af37ee9e8f87038f64de465801fc2f661b6d4960eb80cbcfcd46f1ef4762c'
+QEMU_LOG_SHA = 'bc663d9e0349e4c44cbfc9d97eb5a178c8a47bc7f4b9d7bbe8cabc61782a0339'
+CAPTURE_SHA = '505f583c7d45a57a704d65fe0e4bb86a4d44f833c7bea3c23c31dc6fb7dade47'
+CLIENT_SOURCE_SHA = '1e56609018a718513ec2b81de9cd2b7c8357fd49b04b46e4af6140b3e09556a3'
+QEMU_COMMIT = 'f2ef54f454b661e551a8619f9feb7406752a1b1a'
+KERNEL_COMMIT = 'c2def7c931e6451d89727dec0c6f892abe28ba00'
+
+
+def reference(path):
+    path = Path(path);body = path.read_bytes()
+    return {'path':str(path),'bytes':len(body),'sha256':digest(body)}
+
+
+def extract_function(source, name):
+    """Extract one actual definition, ignoring braces inside C comments/strings."""
+    matches = list(re.finditer(r'(?m)^(?:static\s+)?(?:inline\s+)?[\w *]+\b' + re.escape(name) + r'\s*\(', source))
+    definitions = []
+    for match in matches:
+        first = source.find('{', match.end());semi = source.find(';', match.end())
+        if first < 0 or (semi >= 0 and semi < first):continue
+        cursor=first;depth=0;state='code'
+        while cursor<len(source):
+            char=source[cursor];pair=source[cursor:cursor+2]
+            if state=='line':
+                if char=='\n':state='code'
+            elif state=='comment':
+                if pair=='*/':state='code';cursor+=1
+            elif state in ('"', "'"):
+                if char=='\\':cursor+=1
+                elif char==state:state='code'
+            elif pair=='//':state='line';cursor+=1
+            elif pair=='/*':state='comment';cursor+=1
+            elif char in ('"',"'"):state=char
+            elif char=='{':depth+=1
+            elif char=='}':
+                depth-=1
+                if depth==0:
+                    definitions.append(source[match.start():cursor+1]+'\n');break
+            cursor+=1
+    check(len(definitions)==1,'unique production C function definition required: '+name)
+    return definitions[0]
+
+
+def assess_c064_metadata(state_ref, capture_ref, serial_ref, physical_ref):
+    check(state_ref['sha256']==STATE_SHA and capture_ref['sha256']==CAPTURE_SHA and serial_ref['sha256']==SERIAL_SHA,
+          'wrong c064 state/capture identity; c044 ticket cannot apply')
+    state=decode(bound(state_ref,1<<20));capture=decode(bound(capture_ref,128<<10));serial=bound(serial_ref,1<<20)
+    physical=decode(bound(physical_ref,128<<10))
+    check(physical['state_sha256']==STATE_SHA and physical['current_authority'].endswith('/runs/c064/state/state.json'),
+          'physical report is not bound to the current c064 authority')
+    check(state['revision']==256 and state['active_bytes']==52<<20 and state['charged_bytes']==64<<20 and
+          state['retained_bytes']==12<<20 and state['creation_reserved_bytes']==64<<20,'current c064 responsibility changed')
+    pool=state['pools'][0]
+    check((pool['pool_id'],pool['pool_epoch'],pool['provider_session'],pool['resource_id'])==
+          ('5b594a62-cce5-47d2-9182-21b972b4ced2','0f4d0db6-8906-4c83-83b9-412d642500a3','12455ce8-717e-4c78-8d90-685700fac2e0',115),
+          'new c064 pool tuple mismatch')
+    check(capture['kind']=='own-QEMU-metadata-capture' and len(capture['processes'])==2 and
+          {p['node'] for p in capture['processes']}=={'nodeA','nodeB'},'both actual owning contexts required')
+    check(b'UFPOOL_JOURNAL_BEGIN ' not in serial and physical['new_A_complete_journal_missing'] is True and
+          physical['file_count']==62 and physical['E_metadata_union_acceptance'] is False,'original incomplete metadata boundary changed')
+    summaries=[]
+    for process in capture['processes']:
+        check(process['executable_sha256']=='56fab4e5d8c50c559f76c8ddbae9d6e1661e4764a6f927db2c3706e8199e5d4c' and
+              process['RAM_or_transport_contents_read'] is False and not process['missing_evidence'],'invalid owned-QEMU metadata capture')
+        summaries.append({'node':process['node'],'identity':process['identity'],'namespaces':process['namespaces'],
+                          'FD_count':len(process['FD_metadata']),'RAM_sized_anonymous_candidates':process['RAM_sized_anonymous_candidates']})
+    return {'schema':1,'kind':'c064-terminal-domain-evidence-assessment-v1','status':'INCOMPLETE','run':'c064',
+        'state_sha256':STATE_SHA,'pool_id':pool['pool_id'],'pool_epoch':pool['pool_epoch'],'provider_session':pool['provider_session'],
+        'only_possible_resource_scope':[113,114,115],'scope_bytes':52<<20,'current_eligible_capacity_bytes':0,
+        'owning_context_observations':summaries,'original_journal_completeness':{'nodeA':'missing; not reconstructed'},
+        'missing_evidence':[{'predicate':'accepted-exact-metadata-union','observed':'62 files include new unregistered bootstrap metadata; current strict publication+journal registration cannot complete without original nodeA journal',
+          'next_step':'independently review an alternative source/runtime/publication-bound metadata admission rule if appropriate; do not set ready/complete or reuse c044 registration'}],
+        'normal_native_or_SDK_release_ACK_proven':False,'ledger_fences_applied':False,'authority_to_mutate_ledger':False,
+        'authority_to_launch_Guest':False,'normal_Unknown_client_history_preserved':True,
+        'protected_historical_bytes':76<<20,'B_total_unchanged_bytes':128<<20,'A_historical_unqueried_bytes':128<<20}
+
+
+def evaluate_terminal_v2(request_path, external_sha):
+    """Return an evidence assessment, never a release or ledger permit.
+
+    The available source references establish the addressing candidate. They
+    do not yet establish every allocator/transport/worker confinement link or
+    classify all retained carrier files for this distinct terminal predicate.
+    Absence of the original journal remains a fact, not the v2 rejection rule.
+    """
+    plan=reviewed(request_path,external_sha)
+    check(set(plan)=={'schema','interface','kind','state','capture','serial','physical'},
+          'terminal request accepts exact references only; no caller readiness flags')
+    check(plan['kind']=='c064-terminal-private-cpu-domain-v2-request','wrong terminal v2 request kind')
+    original=assess_c064_metadata(plan['state'],plan['capture'],plan['serial'],plan['physical'])
+    capture=decode(bound(plan['capture'],128<<10))
+    observed=[]
+    for p in capture['processes']:
+        ram=p['RAM_sized_anonymous_candidates'];env=p['selected_launch_environment']
+        check(len(ram)==1 and ram[0]['bytes']==2<<30 and ram[0]['permissions']=='rw-p' and
+              ram[0]['file_backed'] is False,'private anonymous RAM candidate not observed')
+        check(env['direct_child_proc_environment_observed'] is False and env['full_environment_read'] is False,
+              'environment evidence basis changed')
+        observed.append({'node':p['node'],'identity':p['identity'],'anonymous_RAM_candidate_bytes':ram[0]['bytes'],
+                         'selected_environment_basis':env['basis'],'historical_child_environment_captured':False})
+    value={'schema':1,'interface':'mem-service-terminal-private-cpu-domain-v2','method':'terminal-private-cpu-domain-v2',
+           'status':'INCOMPLETE','run':'c064','state_sha256':STATE_SHA,'pool_id':original['pool_id'],
+           'pool_epoch':original['pool_epoch'],'provider_session':original['provider_session'],
+           'candidate_resource_scope':[113,114,115],'candidate_scope_bytes':52<<20,
+           'eligible_rows':[],'current_eligible_capacity_bytes':0,'protected_historical_bytes':76<<20,
+           'evidence_references':{k:plan[k] for k in ('state','capture','serial','physical')},
+           'observed_contexts':observed,'v1_metadata_verdict':'INCOMPLETE',
+           'missing_evidence':[
+             {'predicate':'complete-current-source-runtime-ownership-confinement',
+              'observed':'actual QEMU process/namespace/FD/anonymous VMA capture is available; a validated current allocator, kernel/agent/worker, lower-record and FM source graph binding every backing and visibility path is not supplied'},
+             {'predicate':'complete-terminal-specific-carrier-classification',
+              'observed':'62 retained files have physical stat/alias closure; the unregistered bootstrap marker has not been content/schema validated or admitted by an independent terminal classification rule; stat identity is not content validation'}],
+           'normal_metadata_publication_proven':False,'normal_native_or_SDK_release_ACK':False,
+           'journal_A_complete':False,'ledger_mutated':False,'fences_applied':False,
+           'new_allocation_authority':False,'FM_payload_destroyed':False,
+           'authority_to_mutate_ledger':False,'prior_history_and_tombstones_modified':False}
+    value['assessment_sha256']=digest(canonical(value))
+    return value
+
+
+def main():
+    parser=argparse.ArgumentParser(description=__doc__);parser.add_argument('--manifest',required=True)
+    parser.add_argument('--manifest-sha256',required=True);parser.add_argument('--output',required=True)
+    parser.add_argument('--terminal-v2',action='store_true')
+    args=parser.parse_args()
+    try:
+        if args.terminal_v2:
+            assessment=evaluate_terminal_v2(args.manifest,args.manifest_sha256)
+            immutable_json(args.output,assessment)
+            print(json.dumps({'terminal_assessment':assessment['status'],'current_eligible_bytes':0}))
+            return
+        plan=reviewed(args.manifest,args.manifest_sha256)
+        check(plan['kind']=='c064-platform-readonly-request-v1','wrong c064 platform request')
+        assessment=assess_c064_metadata(plan['state'],plan['capture'],plan['serial'],plan['physical'])
+        immutable_json(args.output,{'terminal_assessment':assessment,'authority_to_mutate_ledger':False})
+    except (EvidenceError,OSError,KeyError,ValueError,TypeError) as error:parser.exit(2,'REJECT_C064_METADATA: '+str(error)+'\n')
+    print(json.dumps({'terminal_assessment':assessment['status'],'current_eligible_bytes':0}))
+
+
+if __name__=='__main__':main()
diff --git a/guest-linux/aarch64/scripts/uflow_env_guest_entry.sh b/guest-linux/aarch64/scripts/uflow_env_guest_entry.sh
