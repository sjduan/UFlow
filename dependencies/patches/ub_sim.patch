+def _registration(request_path, external_sha, helper_path, fixture):
+    r = reviewed(request_path, external_sha, 'HOST-fixture-registration-v2' if fixture else 'metadata-registration-request-v2')
+    c, run, prof, config = _case(r['case']['path'], r['case']['sha256'], fixture)
+    check(r['fm_root'] == str(run / 'fm') and r['run'] == run.name, 'case/run mismatch')
+    starts, ids, cap = _capture(c, run, prof, config, fixture)
+    row = r['file_identity']; p = Path(row['path']); rel = p.relative_to(run / 'fm')
+    check({'dev', 'inode', 'uid', 'file_type', 'bytes', 'mtime_ns', 'content_sha256', 'kernel_inode_aliases'} <= row.keys(), 'complete file identity required')
+    check(len(rel.parts) == 2 and rel.parts[0] in ('obmm_bootstrap', 'obmm_retired') and '.tmp.' not in rel.name and
+          p.resolve() == p and row['uid'] == os.geteuid() and row['file_type'] == stat.S_IFREG, 'exact normal metadata path/owner required')
+    raw, actual = ev.read(p, 4096, metadata=True, expected=row)
+    check(digest(raw) == row['content_sha256'], 'metadata content replaced')
+    fields = md.parse_metadata(raw, r['metadata_kind'])
+    check(rel == md.relative_name(r['metadata_kind'], fields), 'metadata name/schema mismatch')
+    proof = _publication(r, fields, c, run, starts, ids)
+    helper = ev.frozen_helper(helper_path); aliases = helper.file_identity_aliases(p, actual)
+    check(sorted(aliases) == sorted(row['kernel_inode_aliases']) and p.lstat().st_nlink == 1, 'metadata aliases/link changed')
+    return {'schema': 2, 'interface': INTERFACE, 'kind': 'HOST-fixture-validated-v2' if fixture else 'validated-profile-metadata-v2',
+            'case': r['case'], 'run': run.name, 'fm_root': str(run / 'fm'), 'metadata_kind': r['metadata_kind'],
+            'file': {**actual, 'path': str(p), 'content_sha256': digest(raw), 'kernel_inode_aliases': aliases},
+            'fields': fields, 'publication_binding': proof, 'request_manifest_path': str(request_path),
+            'request_manifest_sha256': external_sha, 'helper_path': str(helper_path),
+            'profile_manifest_sha256': PROFILE_SHA, 'writer_source_sha256': WRITER_SHA, 'qemu_binary_sha256': BINARY_SHA,
+            'HOST_fixture_only': fixture, **TRUTHS}
