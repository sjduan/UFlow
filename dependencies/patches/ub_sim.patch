+def _publication(r, fields, c, run, starts, ids, prof):
+    check(r['qemu_binary_sha256'] == prof['qemu_binary_sha256'] and r['writer_source_sha256'] == prof['source_closure']['hw/ub/ub_ubc.c']['sha256'],
+          'old/false publication identity')
+    check(r['control_log'] == c['artifacts']['control'], 'control outside reviewed case')
+    d = md.descriptor_binding(r['control_log'], r['control_line'])
+    check(all(d['fields'][k] == v for k, v in fields.items()), 'metadata/descriptor mismatch')
+    check(d['node'] in ('nodeA', 'nodeB') and d['node'] == r['guest_node'] and d['boot_id'] == r['guest_boot_id'] and
+          d['incarnation'] == r['guest_incarnation'], 'worker/boot/incarnation mismatch')
+    owner = next(s for s in starts if s['node'] == d['node'])
+    check(r['qemu_owner'] == {'pid': owner['pid'], 'birth': owner['birth']} and
+          any(i['node'] == d['node'] and i['boot_id'] == d['boot_id'] for i in ids), 'wrong QEMU/boot owner')
+    _reference_path(r['qemu_log'], run / (d['node'] + '.qemu.log'))
+    lines = bound(r['qemu_log'], 64 << 20).decode('ascii').splitlines()
+    n = r['qemu_line']; check(type(n) is int and 0 <= n < len(lines), 'event missing')
+    line = lines[n]; backing = None
+    if r['metadata_kind'] == 'bootstrap':
+        m = re.fullmatch(r'SIM_DEC: OBMM bootstrap publish node=(\d+) cna=(\d+) uba=([0-9a-f]+) backing=([0-9a-f]+) token=(\d+) size=([0-9a-f]+)', line)
+        check(m is not None, 'successful actual bootstrap event required')
+        observed = dict(node_id=int(m[1]), export_cna=int(m[2]), remote_uba=int(m[3], 16), token_id=int(m[5]), size=int(m[6], 16))
+        backing = int(m[4], 16)
+    else:
+        m = re.fullmatch(r'SIM_DEC: OBMM export retired mem_id=(\d+) owner_cna=0x([0-9a-f]+) uba=([0-9a-f]+) token=(\d+) size=(\d+) generation=(\d+)', line)
+        check(m is not None, 'successful actual retired event required')
+        observed = dict(export_mem_id=int(m[1]), export_cna=int(m[2], 16), remote_uba=int(m[3], 16), token_id=int(m[4]), size=int(m[5]), generation=int(m[6]))
+    check(all(fields[k] == v for k, v in observed.items()), 'event/export mismatch')
+    _reference_path(r['worker_stdout'], run / ('worker-' + d['node'] + '.stdout.log'))
+    marker = 'obmm-worker generation=%d phase=published segment=%d export=%d' % (d['work_generation'], fields['generation'], fields['export_mem_id'])
+    check(bound(r['worker_stdout'], 1 << 20).decode('ascii').splitlines().count(marker) == 1, 'unique worker publication required')
+    check(set(r['journal_captures']) == {'nodeA', 'nodeB'}, 'both complete journals required')
+    journals = document(r['journal_summary'])
+    check(set(journals['journals']) == {'nodeA', 'nodeB'}, 'both journal summaries required')
+    decoded = {}
+    for node, ref in r['journal_captures'].items():
+        check(ref['format'] == 'captured-serial-v1', 'serial capture only')
+        _reference_path(ref['source'], run / (node + '.serial.log'))
+        frames = md.journal_frames(ref); summary = journals['journals'][node]
+        check(frames and all(f['node'] == node for f in frames) and frames == summary['frames'] and
+              (ref['bytes'], ref['sha256']) == (summary['bytes'], summary['sha256']) and
+              summary['capture_end']['complete'] == '1' and summary['capture_end']['status'] == 'complete',
+              'independent complete per-node journal differs')
+        decoded[node] = frames
+    matches = [f for f in decoded[d['node']] if f['phase'] == 'published' and f['key'] == d['key'] and
+               f['incarnation'] == d['incarnation'] and f['work_generation'] == d['work_generation'] and f['work_size'] == fields['size']]
+    check(len(matches) == 1, 'unique journal publication binding required')
+    return {'descriptor': d, 'event_line_sha256': digest(line.encode()), 'journal_frame_sha256': matches[0]['frame_sha256'],
+            'both_journals_independently_verified': True, 'backing_uba_metadata': backing}
