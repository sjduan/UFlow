+#!/usr/bin/env python3
+"""Append-only, externally pinned bootstrap/retired metadata registration.
+
+No FM ring, status, notification or payload contents are read. Retired metadata
+registration is a platform observation, never an SDK or ledger release ACK.
+"""
+import os
+from pathlib import Path
+import re
+import stat
+import uuid
+import time
+import struct
+import argparse
+import json
+
+from uflow_qemu_evidence import (INTERFACE, QEMU_COMMIT, FIXED, HELPER_SHA, TRUTHS,
+    EvidenceError, bound, canonical, check, decode, digest, document, frozen_helper,
+    identity, immutable_json, read, reviewed, fixed_bindings, CURRENT_ROOT)
+
+BOOT = ('export_mem_id', 'remote_uba', 'size', 'generation', 'flags', 'node_id',
+        'node_count', 'export_cna', 'token_id')
+RETIRED = ('export_mem_id', 'generation', 'remote_uba', 'size', 'export_cna', 'token_id')
+SOURCE_SHA = 'cf803e8e898764002bea02307ff4f94d20320fac44226fa1b54c40f5154cf043'
+
+
+def journal_frames(reference):
+    """Verify captured metadata frames without decoding secret descriptor fields."""
+    if reference.get('format') == 'captured-serial-v1':
+        source = bound(reference['source'], 64 << 20)
+        lines = [line.decode('ascii') for line in source.splitlines() if line.startswith(b'UFPOOL_JOURNAL_')]
+        check(sum(line.startswith('UFPOOL_JOURNAL_BEGIN ') for line in lines) == 1 and
+              sum(line.startswith('UFPOOL_JOURNAL_END ') for line in lines) == 1 and
+              lines[0].startswith('UFPOOL_JOURNAL_BEGIN ') and lines[-1].startswith('UFPOOL_JOURNAL_END '),
+              'unique complete ordered journal capture required')
+        raw = bytearray()
+        for line in lines[1:-1]:
+            match = re.fullmatch(r'UFPOOL_JOURNAL_CHUNK offset=(\d+) hex=([0-9a-f]+)', line)
+            check(match is not None and int(match[1]) == len(raw) and len(match[2]) % 2 == 0,
+                  'journal chunk offset/encoding mismatch')
+            raw.extend(bytes.fromhex(match[2]));check(len(raw) <= 65536, 'journal capture bound exceeded')
+        end = dict(word.split('=', 1) for word in lines[-1].split()[1:])
+        check(end.get('status') == 'complete' and end.get('complete') == '1' and
+              int(end['bytes']) == len(raw), 'incomplete journal capture')
+        value = 1469598103934665603
+        for byte in raw: value = ((value ^ byte) * 1099511628211) & ((1 << 64) - 1)
+        check(value == int(end['fnv64'], 16), 'serial capture checksum mismatch')
+        raw = bytes(raw)
+        check(len(raw) == reference['bytes'] and digest(raw) == reference['sha256'], 'journal capture hash mismatch')
+    else:
+        raw = bound(reference, 64 << 10)
+    check(len(raw) % 1024 == 0, 'torn worker journal frame')
+    frames = []
+    for offset in range(0, len(raw), 1024):
+        frame = raw[offset:offset + 1024]
+        check(frame[:24] == b'obmm-worker-ledger-v3'.ljust(24, b'\0'), 'wrong worker journal ABI')
+        value = 14695981039346656037
+        for byte in frame[:1016]:
+            value = ((value ^ byte) * 1099511628211) & ((1 << 64) - 1)
+        check(value == struct.unpack_from('<Q', frame, 1016)[0], 'worker journal frame checksum mismatch')
+        def word(start, end):
+            data = frame[start:end]
+            head, separator, tail = data.partition(b'\0')
+            check(separator and not tail.strip(b'\0'), 'noncanonical journal string')
+            return head.decode('ascii')
+        sequence = struct.unpack_from('<Q', frame, 24)[0]
+        check(sequence == len(frames) + 1, 'journal frame sequence mismatch')
+        frames.append({'sequence': sequence, 'phase': word(32, 64), 'node': word(64, 128),
+            'key': word(128, 224), 'incarnation': struct.unpack_from('<Q', frame, 224)[0],
+            'work_generation': struct.unpack_from('<Q', frame, 248)[0],
+            'work_size': struct.unpack_from('<Q', frame, 256)[0], 'frame_sha256': digest(frame),
+            'frame_FNV64_valid': True})
+    return frames
+
+
+def parse_metadata(data, kind):
+    check(kind in ('bootstrap', 'retired') and 0 < len(data) <= 4096, 'unknown metadata schema/size')
+    try:
+        lines = data.decode('ascii').splitlines()
+    except UnicodeError as error:
+        raise EvidenceError('metadata must be ASCII integers') from error
+    check(data.endswith(b'\n') and b'\0' not in data, 'partial metadata rejected')
+    if kind == 'bootstrap':
+        check(lines and lines.pop(0) == '[obmm_export]', 'exact bootstrap section required')
+    fields = {}
+    for line in lines:
+        check(line and len(line) <= 128 and line.count('=') == 1, 'malformed metadata row')
+        key, value = line.split('=')
+        check(key not in fields, 'duplicate metadata key')
+        check(re.fullmatch(r'0|[1-9][0-9]{0,19}', value), 'noncanonical unsigned metadata integer')
+        fields[key] = int(value)
+    expected = BOOT if kind == 'bootstrap' else RETIRED
+    check(set(fields) == set(expected), 'unknown or missing metadata fields')
+    for key, value in fields.items():
+        maximum = (1 << 32) if key in ('flags', 'node_id', 'node_count', 'export_cna', 'token_id') else (1 << 64)
+        check(0 <= value < maximum, 'metadata integer overflow')
+        check(value or key in ('flags', 'node_id'), 'zero export identity')
+    if kind == 'bootstrap':
+        check(2 <= fields['node_count'] <= 8 and fields['node_id'] < fields['node_count'], 'bad metadata node geometry')
+    return fields
+
+
+def relative_name(kind, fields):
+    if kind == 'bootstrap':
+        return Path('obmm_bootstrap') / ('node%d-generation%d.ini' % (fields['node_id'], fields['generation']))
+    return Path('obmm_retired') / ('cna%08x-uba%016x-token%08x-generation%016x-export%016x.retired' %
+        tuple(fields[key] for key in ('export_cna', 'remote_uba', 'token_id', 'generation', 'export_mem_id')))
+
+
+def descriptor_binding(control_reference, line_number):
+    """Decode only allowed integer slices of the fixed MSOB v2 descriptor.
+
+    Offset 92 (token_value) is never decoded or returned. The original opaque
+    descriptor and control record are bound by digests rather than re-exported.
+    """
+    lines = bound(control_reference, 16 << 20).splitlines()
+    check(type(line_number) is int and 0 <= line_number < len(lines), 'control evidence line missing')
+    event = decode(lines[line_number])
+    check(event.get('event') == 'lower-control' and event.get('operation') == 122 and
+          event.get('origin', {}).get('role') == 'worker', 'actual worker publish operation required')
+    request, response = event['request_metadata'], event['response_metadata']
+    check(event.get('status') == 0 and response.get('status') == 'ok' and response.get('state') == 'active', 'successful worker publish required')
+    text = request.get('descriptor_hex', '')
+    check(type(text) is str and re.fullmatch('[0-9a-f]{192}', text) and text == response.get('descriptor_hex'), 'descriptor ABI/echo mismatch')
+    def number(offset, size):
+        return int(text[offset * 2:(offset + size) * 2], 16)
+    check(number(0, 4) == 0x4d534f42 and number(4, 4) == 2 and number(8, 4) == 96 and number(12, 4) == 0,
+          'fixed MSOB descriptor ABI required')
+    values = {key: number(offset, size) for key, offset, size in (
+        ('export_mem_id', 16, 8), ('remote_uba', 24, 8), ('size', 32, 8), ('token_id', 40, 4),
+        ('export_cna', 44, 4), ('generation', 48, 8), ('node_id', 68, 4), ('node_count', 72, 4))}
+    # This version admits the pinned kernel's ordinary zero bootstrap flags,
+    # not the descriptor's distinct access_flags or gsva_token_value fields.
+    values['flags'] = 0
+    check(request['key'] == response['key'] and int(response['size_bytes']) == values['size'] and
+          int(request['address']) == values['remote_uba'], 'worker descriptor identity mismatch')
+    return {'fields': values, 'key': request['key'], 'work_generation': int(request['generation']),
+            'node': event['node'], 'boot_id': event['boot_id'], 'incarnation': int(request['incarnation']),
+            'worker_pid': event['origin']['pid'], 'worker_birth': event['origin']['birth'],
+            'control_line_sha256': digest(lines[line_number]), 'opaque_descriptor_hex_sha256': digest(text.encode()),
+            'token_value_decoded_or_exported': False}
+
+
+def verify_publication(request, fields):
+    check(request['qemu_commit'] == QEMU_COMMIT and request['qemu_binary_sha256'] == FIXED['qemu_binary'] and
+          request['writer_source_sha256'] == SOURCE_SHA, 'metadata source/binary mismatch')
+    fixed_bindings(request['fixed_bindings'])
+    check(request['writer_source']['sha256'] == SOURCE_SHA, 'writer source reference mismatch')
+    bound(request['writer_source'])
+    d = descriptor_binding(request['control_log'], request['control_line'])
+    check(all(d['fields'][key] == value for key, value in fields.items()), 'metadata and worker descriptor differ')
+    check(d['node'] == request['guest_node'] and d['boot_id'] == request['guest_boot_id'] and
+          d['incarnation'] == request['guest_incarnation'], 'worker owner/boot mismatch')
+    starts = decode(bound(request['guest_starts']))
+    owner = [row for row in starts if row['node'] == d['node']]
+    check(len(owner) == 1 and {'pid': owner[0]['pid'], 'birth': owner[0]['birth']} == request['qemu_owner'] and
+          owner[0]['argv'][0] == request['fixed_bindings']['qemu_binary']['path'], 'wrong historical QEMU owner')
+    identities = decode(bound(request['guest_identities']))
+    check(sum(row['node'] == d['node'] and row['boot_id'] == d['boot_id'] for row in identities) == 1,
+          'worker boot is not a historical Guest identity')
+    check(Path(request['qemu_log']['path']) == Path(request['fm_root']).parent / (d['node'] + '.qemu.log'),
+          'event log outside named QEMU owner/run')
+    lines = bound(request['qemu_log'], 64 << 20).decode('ascii', errors='strict').splitlines()
+    n = request['qemu_line']
+    check(type(n) is int and 0 <= n < len(lines), 'publish/retire event absent')
+    line = lines[n]
+    if request['metadata_kind'] == 'bootstrap':
+        match = re.fullmatch(r'SIM_DEC: OBMM bootstrap publish node=(\d+) cna=(\d+) uba=([0-9a-f]+) backing=([0-9a-f]+) token=(\d+) size=([0-9a-f]+)', line)
+        check(match is not None, 'actual successful bootstrap event required')
+        node, cna, uba, backing, token, size = match.groups()
+        observed = {'node_id': int(node), 'export_cna': int(cna), 'remote_uba': int(uba, 16),
+                    'token_id': int(token), 'size': int(size, 16)}
+    else:
+        match = re.fullmatch(r'SIM_DEC: OBMM export retired mem_id=(\d+) owner_cna=0x([0-9a-f]+) uba=([0-9a-f]+) token=(\d+) size=(\d+) generation=(\d+)', line)
+        check(match is not None, 'actual successful retire event required')
+        memid, cna, uba, token, size, generation = match.groups()
+        observed = {'export_mem_id': int(memid), 'export_cna': int(cna, 16), 'remote_uba': int(uba, 16),
+                    'token_id': int(token), 'size': int(size), 'generation': int(generation)}
+    check(all(fields[key] == value for key, value in observed.items()), 'QEMU event/export mismatch')
+    worker = bound(request['worker_stdout'], 1 << 20).decode('ascii').splitlines()
+    marker = 'obmm-worker generation=%d phase=published segment=%d export=%d' % (
+        d['work_generation'], fields['generation'], fields['export_mem_id'])
+    check(worker.count(marker) == 1, 'unique actual worker publication missing')
+    journal = document(request['journal_summary'])
+    entry = journal['journals'][d['node']]
+    check(entry['capture_end']['complete'] == '1' and entry['capture_end']['status'] == 'complete' and
+          entry['sha256'] and entry['bytes'] > 0, 'complete captured worker journal required')
+    capture = request['journal_capture']
+    check((capture['bytes'], capture['sha256']) == (entry['bytes'], entry['sha256']), 'journal capture identity mismatch')
+    check(journal_frames(capture) == entry['frames'], 'independent journal decoding differs from reviewed summary')
+    matches = [row for row in entry['frames'] if row['phase'] == 'published' and row['key'] == d['key'] and
+               row['work_generation'] == d['work_generation'] and row['work_size'] == fields['size'] and
+               row['incarnation'] == d['incarnation'] and row['node'] == d['node']]
+    check(len(matches) == 1 and matches[0]['frame_FNV64_valid'] is True and matches[0]['frame_sha256'],
+          'captured journal does not bind published export')
+    return {'descriptor': d, 'event_line_sha256': digest(line.encode()),
+            'journal_summary_sha256': request['journal_summary']['sha256'],
+            'journal_frame_sha256': matches[0]['frame_sha256'],
+            'backing_uba_metadata': int(backing, 16) if request['metadata_kind'] == 'bootstrap' else None}
+
+
+def validate_registration(request_path, external_sha, helper_path):
+    request = reviewed(request_path, external_sha)
+    check(request.get('kind') == 'metadata-registration-request-v1', 'wrong registration request')
+    root = Path(request['fm_root'])
+    check(root.is_absolute() and root.name == 'fm' and root.parent.name == request['run'], 'wrong run/FM owner')
+    expected = request['file_identity']
+    check({'path', 'dev', 'inode', 'uid', 'file_type', 'bytes', 'mtime_ns', 'content_sha256',
+           'kernel_inode_aliases'} <= expected.keys(), 'complete metadata identity pin required')
+    check(expected['file_type'] == stat.S_IFREG and expected['uid'] == os.geteuid() and
+          0 < expected['bytes'] <= 4096, 'metadata owner/type/size rejected')
+    path = Path(expected['path'])
+    # Exact two-level schema and no .tmp paths are established before content read.
+    rel = path.relative_to(root)
+    check(len(rel.parts) == 2 and rel.parts[0] in ('obmm_bootstrap', 'obmm_retired') and
+          '.tmp.' not in rel.name and path.resolve() == path, 'metadata path escape/temporary publication')
+    data, observed = read(path, 4096, metadata=True, expected=expected)
+    check(digest(data) == expected['content_sha256'], 'metadata content pin mismatch')
+    fields = parse_metadata(data, request['metadata_kind'])
+    check(rel == relative_name(request['metadata_kind'], fields), 'metadata basename/generation mismatch')
+    proof = verify_publication(request, fields)
+    helper = frozen_helper(helper_path)
+    aliases = helper.file_identity_aliases(path, observed)
+    check(sorted(aliases) == sorted(expected['kernel_inode_aliases']), 'metadata inode alias mismatch')
+    return {'schema': 1, 'interface': INTERFACE, 'kind': 'validated-dynamic-metadata-v1',
+            'run': request['run'], 'fm_root': str(root), 'metadata_kind': request['metadata_kind'],
+            'file': {**observed, 'path': str(path), 'kernel_inode_aliases': aliases, 'content_sha256': digest(data)},
+            'fields': fields, 'publication_binding': proof, 'request_manifest_sha256': external_sha,
+            'request_manifest_path': str(request_path), 'source_commit': QEMU_COMMIT,
+            'QEMU_binary_sha256': FIXED['qemu_binary'], 'frozen_helper_sha256': HELPER_SHA,
+            **TRUTHS}
+
+
+def registry_history(directory, expected_head=None):
+    root = Path(directory)
+    if not root.exists():
+        check(expected_head in (None, '0' * 64), 'missing pinned registry history')
+        return []
+    check(root.resolve() == root and stat.S_ISDIR(root.lstat().st_mode), 'registry directory alias rejected')
+    files = sorted(root.iterdir())
+    check(len(files) <= 256 and all(re.fullmatch(r'[0-9]{6}\.json', p.name) for p in files), 'torn/unknown registry entry')
+    chain, previous = [], '0' * 64
+    for number, path in enumerate(files, 1):
+        data, _ = read(path, 1 << 20)
+        row = decode(data)
+        check(path.name == '%06d.json' % number and row['sequence'] == number and row['previous_sha256'] == previous,
+              'registry gap/duplicate/parent conflict')
+        check(row.get('schema') == 1 and row['interface'] == INTERFACE and row['kind'] == 'metadata-registry-entry-v1', 'wrong registry schema')
+        previous = digest(data)
+        chain.append((row, previous))
+    check(expected_head is None or previous == expected_head, 'stale registry external head/replay')
+    return chain
+
+
+def append_registration(directory, expected_head, entry):
+    root = Path(directory)
+    check(root.is_absolute() and root.resolve() == root and 'fm' not in root.parts,
+          'registry must be normalized new private host storage')
+    if root.is_relative_to(CURRENT_ROOT):
+        check(root.is_relative_to(Path(CURRENT_ROOT) / 'implementation/qemu-domain-v1'),
+              'original production registry is outside private write scope')
+    check(entry.get('kind') == 'validated-dynamic-metadata-v1' and entry.get('interface') == INTERFACE and
+          all(entry.get(key) is value for key, value in TRUTHS.items()), 'validated candidate-only registration required')
+    request = reviewed(entry['request_manifest_path'], entry['request_manifest_sha256'])
+    again = validate_registration(entry['request_manifest_path'], entry['request_manifest_sha256'],
+                                  request['fixed_bindings']['physical_helper']['path'])
+    check(again == entry, 'registration must be freshly validated before append')
+    history = registry_history(root)
+    actual_head = history[-1][1] if history else '0' * 64
+    for row, pin in history:
+        old = row['metadata']
+        same_event = (old['publication_binding']['event_line_sha256'], old['publication_binding']['descriptor']['control_line_sha256']) == (
+                      entry['publication_binding']['event_line_sha256'], entry['publication_binding']['descriptor']['control_line_sha256'])
+        if old['file']['path'] == entry['file']['path'] or same_event:
+            check(old == entry and expected_head in (row['previous_sha256'], actual_head), 'conflicting metadata path/event identity')
+            return {'sequence': row['sequence'], 'head_sha256': actual_head, 'idempotent': True}
+    check(actual_head == expected_head, 'stale registry external head/replay')
+    root.mkdir(parents=True, exist_ok=True)
+    row = {'schema': 1, 'interface': INTERFACE, 'kind': 'metadata-registry-entry-v1',
+           'sequence': len(history) + 1, 'previous_sha256': expected_head, 'metadata': entry}
+    temporary = root / ('.publishing-' + uuid.uuid4().hex)
+    raw = canonical(row) + b'\n'
+    with temporary.open('xb') as stream:
+        stream.write(raw); stream.flush(); os.fsync(stream.fileno())
+    temporary.chmod(0o444)
+    target = root / ('%06d.json' % row['sequence'])
+    try:
+        os.link(temporary, target)  # atomic no-replace publication
+    finally:
+        temporary.unlink()
+    fd = os.open(root, os.O_DIRECTORY | os.O_RDONLY)
+    try: os.fsync(fd)
+    finally: os.close(fd)
+    return {'sequence': row['sequence'], 'head_sha256': digest(raw), 'idempotent': False}
+
+
+def _companion_audit(original_reference, registry_directory, registry_head, helper_path, births, endpoints):
+    original = document(original_reference)
+    check(type(original.get('files')) is list and len(original['files']) <= 4096, 'original carrier set required')
+    helper = frozen_helper(helper_path)
+    dynamic = []
+    for row, _ in registry_history(registry_directory, registry_head):
+        item = row['metadata']
+        check(item['kind'] == 'validated-dynamic-metadata-v1', 'unvalidated metadata registry item')
+        again = validate_registration(item['request_manifest_path'], item['request_manifest_sha256'], helper_path)
+        check(again == item, 'metadata changed after registration')
+        dynamic.append(item['file'])
+    files = original['files'] + dynamic
+    check(len({row['path'] for row in files}) == len(files), 'duplicate carrier/metadata union')
+    roots = {Path(row['path']).parents[0] for row in original['files']}
+    # Original roots are the named run/fm directories, not arbitrary scan roots.
+    check(all(root.name == 'fm' and root.parent.parent.name == 'runs' for root in roots), 'invalid original FM roots')
+    roots.update(Path(item['fm_root']) for row, _ in registry_history(registry_directory, registry_head)
+                 for item in [row['metadata']])
+    inodes, actual = set(), []
+    for row in files:
+        path = Path(row['path']);aliases = row.get('kernel_inode_aliases')
+        check(aliases and [row['dev'], row['inode']] in aliases, 'carrier alias identity missing')
+        inodes.update(tuple(pair) for pair in aliases)
+        try: info = path.lstat()
+        except FileNotFoundError:
+            check(row in original['files'], 'registered metadata disappeared')
+            actual.append({'path': str(path), 'state': 'original-already-absent'});continue
+        check(path.resolve() == path and (info.st_dev, info.st_ino, info.st_uid, stat.S_IFMT(info.st_mode), info.st_size) ==
+              (row['dev'], row['inode'], row['uid'], row['file_type'], row['bytes']), 'carrier replaced/changed')
+        check(sorted(helper.file_identity_aliases(path, row)) == sorted(aliases), 'carrier backing alias mismatch')
+        actual.append({'path': str(path), 'state': 'retained', 'blocks_bytes': info.st_blocks * 512})
+    paths = {row['path'] for row in files};count = 0
+    deadline = time.monotonic() + 15
+    for root in roots:
+        if not root.exists():continue
+        for path in root.rglob('*'):
+            count += 1;check(count <= 8192 and time.monotonic() < deadline, 'FM union enumeration bound exceeded')
+            info = path.lstat()
+            check(not stat.S_ISLNK(info.st_mode) and info.st_uid == os.geteuid(), 'FM symlink/owner rejected')
+            check(stat.S_ISDIR(info.st_mode) or str(path) in paths, 'unknown extra outside exact registry union')
+    check(not any(helper.identity(int(pid)) == born for pid, born in births.items()), 'original owner birth still alive')
+    holders = helper.holders(inodes)
+    check(not holders['holders'] and not holders['denied'], 'held or invisible FD/VMA closure')
+    live = {line.split()[-1] for line in Path('/proc/net/unix').read_text().splitlines()[1:] if len(line.split()) >= 8}
+    for row in endpoints:
+        path = Path(row['path']);check(str(path) not in live, 'control socket active')
+        if path.exists():
+            info = path.lstat()
+            check(stat.S_ISSOCK(info.st_mode) and (info.st_dev, info.st_ino, info.st_uid) ==
+                  (row['dev'], row['inode'], row['uid']), 'control endpoint replaced')
+    return {'schema': 1, 'interface': INTERFACE, 'status': 'PASS_READONLY_COMPANION_AUDIT_ONLY',
+            'original_carriers': len(original['files']), 'validated_dynamic_metadata': len(dynamic),
+            'exact_union_files': len(files), 'files': actual, 'holders': holders,
+            'registry_head_sha256': registry_head, 'original_manifest_sha256': original_reference['sha256'],
+            'frozen_helper_sha256': HELPER_SHA, 'all_named_births_gone': True, 'controls_kernel_inactive': True,
+            'FM_contents_except_registered_metadata_read': False, 'files_unlinked': False,
+            'original_failed_ca044_relabelled_PASS': False, **TRUTHS}
+
+
+def companion_audit(plan_path, external_sha):
+    plan = reviewed(plan_path, external_sha)
+    check(plan.get('kind') == 'readonly-companion-plan-v1', 'reviewed companion plan required')
+    result = _companion_audit(plan['original_carriers'], plan['registry_directory'], plan['registry_head_sha256'],
+                              plan['helper_path'], plan['births'], plan['control_endpoints'])
+    result['reviewed_plan_sha256'] = external_sha
+    return result
+
+
+def quarantine_metadata_observation(path, fm_root):
+    """Stat-only diagnostic for partial publications; never part of an audit union."""
+    path, root = Path(path), Path(fm_root)
+    rel = path.relative_to(root)
+    check(len(rel.parts) == 2 and rel.parts[0] in ('obmm_bootstrap', 'obmm_retired') and '.tmp.' in path.name,
+          'only named metadata temporary paths can be quarantined')
+    info = path.lstat()
+    check(stat.S_ISREG(info.st_mode) and info.st_uid == os.geteuid() and 0 <= info.st_size <= 4096 and path.resolve() == path,
+          'temporary metadata identity rejected')
+    return {'status': 'INCOMPLETE_QUARANTINED_METADATA', 'path': str(path), 'identity': identity(info),
+            'contents_read': False, 'admitted_to_union': False, **TRUTHS}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('action', choices=('register', 'audit'))
+    parser.add_argument('--manifest', required=True)
+    parser.add_argument('--manifest-sha256', required=True)
+    parser.add_argument('--output', required=True)
+    parser.add_argument('--helper')
+    parser.add_argument('--registry')
+    parser.add_argument('--previous-head')
+    args = parser.parse_args()
+    try:
+        if args.action == 'register':
+            check(args.helper and args.registry and args.previous_head, 'register helper/registry/previous-head required')
+            entry = validate_registration(args.manifest, args.manifest_sha256, args.helper)
+            result = append_registration(args.registry, args.previous_head, entry)
+        else:
+            result = companion_audit(args.manifest, args.manifest_sha256)
+        immutable_json(args.output, result)
+    except (EvidenceError, OSError, KeyError, ValueError, TypeError) as error:
+        parser.exit(2, 'REJECT_METADATA_EVIDENCE: ' + str(error) + '\n')
+    print(json.dumps({'status': result.get('status', 'REGISTERED_METADATA_ONLY')}))
+
+
+if __name__ == '__main__':
+    main()
