+#!/usr/bin/env python3
+"""Validate real frozen-supervisor result ownership, without inventing history."""
+import builtins
+import hashlib
+import os
+from pathlib import Path
+import re
+import types
+
+ROOT = Path('/workspace/uflow/runs/mem-service-shared-pool-20261108')
+INTERFACE = 'mem-service-observed-ownership-v3'
+SUPERVISOR = {
+    'task_supervisor.py': '7b23344b2cd9c51504e2389682f31b6dfa2e9567ed5a8bfda49dfb73ddf70827',
+    'task_lifecycle.py': '9370260295844d433ac9273a255304b6b5e66d52c26b58cde758460dd594ad8c',
+    'task_resources.py': 'bdc057af7a5790c7ab181289072326b7a81fc397d6d08c6a6b5e08066e01f607',
+}
+RUNNER_SHA = 'c1b7115df2c0973e4ffcd689bef35af4aa457467223b15c6277a1e8479084727'
+EV_SHA = '0dc9cbe9909bca7d53dcc6aa58b72f72942e699999ecf420055528cbd98c0995'
+path = Path(__file__).resolve().parent / 'uflow_qemu_evidence.py'
+raw = path.read_bytes()
+if hashlib.sha256(raw).hexdigest() != EV_SHA:
+    raise ValueError('frozen evidence dependency mismatch')
+ev = types.ModuleType('_ownership_v3_fresh_evidence'); ev.__file__ = str(path)
+exec(compile(raw, str(path), 'exec'), ev.__dict__)
+
+
+def _named(ref, path, maximum=2 << 20):
+    ev.check(ref['path'] == str(path), 'ownership evidence outside exact named role')
+    return ev.decode(ev.bound(ref, maximum))
+
+
+def validate_descriptor(descriptor, run, helper_path, starts=None, capture=None):
+    """Data-only descriptor must come from the externally reviewed case context.
+
+    The primary supervisor result is a real observation from pinned code. The
+    top E0 result adds supervisor_actual_exit_code; it is not a second history.
+    Optional history is separately bound when actually emitted, never generated.
+    """
+    required = {'schema', 'interface', 'kind', 'run', 'expected_exit', 'monitor_result', 'run_result',
+                'monitor_config', 'supervisor_start', 'launch_config', 'E0_runner', 'supervisor_sources', 'optional_history'}
+    ev.check(set(descriptor) == required and descriptor['schema'] == 3 and descriptor['interface'] == INTERFACE and
+             descriptor['kind'] == 'monitor-result-ownership-v3', 'tagged actual monitor-result ownership required')
+    ev.check(type(run) is str and re.fullmatch('c[0-9]{3}', run) and descriptor['run'] == run and
+             type(descriptor['expected_exit']) is int, 'actual named run and expected exit required')
+    root = ROOT / 'runs' / run
+    monitor = _named(descriptor['monitor_result'], root / 'monitor/result.json')
+    top = _named(descriptor['run_result'], root / 'result.json')
+    config = _named(descriptor['monitor_config'], root / 'monitor/config.json')
+    start = _named(descriptor['supervisor_start'], root / 'monitor/supervisor-start.json')
+    ev.check(start == {'pid': monitor['supervisor_pid'], 'birth': monitor['supervisor_birth']}, 'supervisor birth/source mismatch')
+    extras = set(top['processes']) - set(monitor)
+    expected_extras = {'supervisor_actual_exit_code'}
+    if extras == {'supervisor_actual_exit_code', 'ownership_history', 'adapter'}:
+        # An actually emitted historical adapter annotation is optional evidence,
+        # not a substitute for or modification of any primary monitor member.
+        ev.check(descriptor['optional_history'] is not None and
+                 top['processes']['ownership_history'] == descriptor['optional_history']['path'] == str(root/'monitor/ownership-history.json') and
+                 top['processes']['adapter'] == 'static birth-keyed build identity retirement; accepted lifecycle and pidfd signalling unchanged',
+                 'unknown historical adapter annotation')
+        expected_extras = extras
+    ev.check(extras == expected_extras and top['processes'].get('supervisor_actual_exit_code') == 0 and
+             {k: v for k, v in top['processes'].items() if k not in expected_extras} == monitor,
+             'top E0 process result differs from primary supervisor observations')
+    launch_path = Path(descriptor['launch_config']['path'])
+    ev.check(launch_path.is_relative_to(ROOT / 'implementation') and launch_path.name == run + '.json', 'original named E0 launch config required')
+    launch = ev.document(descriptor['launch_config'])
+    runner = descriptor['E0_runner']; ev.check(runner['sha256'] == RUNNER_SHA, 'frozen E0 source mismatch')
+    ev.bound(runner, 128 << 10)
+    ev.check(launch['root'] == str(ROOT) and launch['job'] == run and launch['kind'] in ('guest', 'host', 'build') and
+             0 < launch['run_seconds'] <= 3600 and launch['supervisor_sha256'] == SUPERVISOR, 'original E0 admission/source mismatch')
+    ev.check(set(descriptor['supervisor_sources']) == set(SUPERVISOR), 'complete frozen supervisor source closure required')
+    for name, pin in SUPERVISOR.items():
+        source = descriptor['supervisor_sources'][name]
+        ev.check(source['path'] == str(Path(launch['supervisor_root']) / name) and source['sha256'] == pin,
+                 'actual supervisor source identity mismatch')
+        ev.bound(source, 128 << 10)
+    ev.check(config['argv'] == ['/usr/local/python3.11.14/bin/python3.11', '-B', '-s', runner['path'], '--actor', str(launch_path)] and
+             config['root'] == str(root / 'monitor') and config['graceful_ready'] == str(root / 'ready.json') and
+             config['run_seconds'] == launch['run_seconds'] and config['private_shm'] is False and
+             0 < config['memory_bytes'] <= 32 << 30 and config['max_processes'] <= 128 and
+             (config['grace_seconds'], config['term_seconds'], config['kill_seconds']) == (10, 10, 5),
+             'monitor does not belong to the frozen bounded E0 admission')
+    ev.check(monitor['schema'] == 1 and monitor['actual_task_exit_code'] == descriptor['expected_exit'] and
+             monitor['process_tree_empty'] is True and monitor['task_resources_closed'] is True and
+             not monitor['remaining'] and not monitor['evidence_errors'] and monitor['isolation_error'] is None,
+             'primary monitor closure incomplete')
+    owned = monitor['owned_births']
+    ev.check(type(owned) is dict and len(owned) <= 128 and
+             all(re.fullmatch('[1-9][0-9]*', pid) and type(born) is int and born > 0 for pid, born in owned.items()),
+             'actual primary observed birth map required')
+    births = {(int(pid), born) for pid, born in owned.items()}
+    births.update(((monitor['supervisor_pid'], monitor['supervisor_birth']), (monitor['task_pid'], monitor['task_birth'])))
+    ev.check(all(type(pid) is int and pid > 0 and type(born) is int and born > 0 for pid, born in births), 'invalid primary process identity')
+    for ref, name in ((starts, 'guest-starts.json'), (capture, 'own-qemu-metadata.json')):
+        if ref is not None:
+            value = _named(ref, root / name)
+            required_births = [(row['pid'], row['birth']) for row in value] if ref is starts else [(value['owner']['pid'], value['owner']['birth'])]
+            ev.check(all(pair in births for pair in required_births), 'inline Guest/collector identity outside actual primary owned tree')
+    history_path = root / 'monitor/ownership-history.json'; history_ref = descriptor['optional_history']
+    if history_ref is None:
+        ev.check(not history_path.exists(), 'existing optional history must be explicitly bound')
+        history = 'absent-not-reconstructed'
+    else:
+        value = _named(history_ref, history_path)
+        observations = value['observed_identities']
+        ev.check(type(observations) is list and len(observations) <= 512 and
+                 all(type(row['pid']) is int and row['pid'] > 0 and type(row['birth']) is int and row['birth'] > 0 and
+                     row['uid'] == os.geteuid() for row in observations), 'optional actual history types/bound/owner')
+        births.update((row['pid'], row['birth']) for row in observations)
+        history = 'present-separately-bound'
+    helper = ev.frozen_helper(helper_path)
+    ev.check(all(helper.identity(pid) != born for pid, born in births), 'original observed process birth still alive')
+    return {'schema': 3, 'interface': INTERFACE, 'kind': 'validated-actual-monitor-ownership-v3', 'run': run,
+            'births': sorted([list(row) for row in births]), 'primary_source': descriptor['monitor_result'], 'top_result': descriptor['run_result'],
+            'frozen_supervisor_sha256': SUPERVISOR['task_supervisor.py'], 'optional_history': history,
+            'original_actual_exit': monitor['actual_task_exit_code'], 'all_named_births_gone': True,
+            'SDK_ACK_inferred_from_death': False, 'ownership_history_reconstructed': False,
+            'authority_to_mutate_ledger': False, 'authority_to_launch_Guest': False}
+
+
+def validate_ownership(path, external_sha, helper_path, starts=None, capture=None):
+    raw, _ = ev.read(path, 128 << 10)
+    ev.check(type(external_sha) is str and re.fullmatch('[0-9a-f]{64}', external_sha) and ev.digest(raw) == external_sha,
+             'externally reviewed actual ownership descriptor required')
+    descriptor = ev.decode(raw)
+    return validate_descriptor(descriptor, descriptor['run'], helper_path, starts, capture)
