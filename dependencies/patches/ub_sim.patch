+def append_registration(directory, expected_head, entry):
+    check(entry.get('kind') == 'validated-profile-metadata-v4' and entry.get('HOST_fixture_only') is False,
+          'HOST fixture/quarantine cannot enter production registry')
+    again = _revalidate(entry)
+    check(entry == again, 'fresh registration differs')
+    root = Path(directory)
+    check(str(root) == str(PREFIX / 'registry' / entry['run']) and root.resolve() == root, 'wrong new registry root')
+    root.mkdir(parents=True, exist_ok=True)
+    fd = os.open(root / '.lock', os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW | os.O_NONBLOCK, 0o600)
+    try:
+        check(stat.S_ISREG(os.fstat(fd).st_mode) and os.fstat(fd).st_nlink == 1, 'invalid registry lock')
+        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        # Determine the current head without accepting a caller-selected prefix.
+        files = sorted(root.glob('[0-9][0-9][0-9][0-9][0-9][0-9].json'))
+        head = digest(ev.read(files[-1], 1 << 20)[0]) if files else '0' * 64
+        rows = registry_history(root, head)
+        for old, _ in rows:
+            m = old['metadata']
+            if m['file']['path'] == entry['file']['path'] or m['publication_binding']['event_line_sha256'] == entry['publication_binding']['event_line_sha256']:
+                check(m == entry and expected_head in (old['previous_sha256'], head), 'conflicting duplicate metadata/event')
+                return {'sequence': old['sequence'], 'head_sha256': head, 'idempotent': True}
+        check(expected_head == head, 'stale append head')
+        row = {'schema': 4, 'interface': INTERFACE, 'kind': 'profile-registry-entry-v4', 'sequence': len(rows) + 1,
+               'previous_sha256': head, 'metadata': entry}
+        raw = ev.canonical(row) + b'\n'; temp = root / ('.publishing-' + uuid.uuid4().hex)
+        try:
+            with temp.open('xb') as stream:
+                stream.write(raw); stream.flush(); os.fsync(stream.fileno())
+            temp.chmod(0o444); os.link(temp, root / ('%06d.json' % row['sequence']))
+        finally:
+            if temp.exists(): temp.unlink()
+        d = os.open(root, os.O_DIRECTORY | os.O_RDONLY)
+        try: os.fsync(d)
+        finally: os.close(d)
+        return {'sequence': row['sequence'], 'head_sha256': digest(raw), 'idempotent': False}
+    finally:
+        os.close(fd)
