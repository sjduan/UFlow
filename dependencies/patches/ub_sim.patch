+def historical_inventory():
+    """Derive immutable historical 62; NEVER replay terminal eligibility/accounting."""
+    p = OLD / 'terminal-release-v2/candidate.json'; raw, _ = ev.read(p, 128 << 10)
+    check(digest(raw) == CANDIDATE_SHA, 'accepted historical candidate replaced')
+    candidate = ev.decode(raw); check(candidate['source_graph']['sha256'] == GRAPH_SHA, 'historical graph drift')
+    graph = document(candidate['source_graph']); cp = document(graph['prior_companion'])
+    plan = reviewed_old(candidate['request'])
+    original = document(cp['original_carriers'])['files']; current = document(plan['carriers'])['files']
+    history = md.registry_history(cp['registry_directory'], cp['registry_head_sha256'])
+    check(len(original) == 50 and len(current) == 10 and len(history) == 1, 'historical carrier/registry counts differ')
+    normal = history[0][0]['metadata']
+    check(md.validate_registration(normal['request_manifest_path'], normal['request_manifest_sha256'], cp['helper_path']) == normal,
+          'genuine old normal registration changed')
+    physical = OLD / 'inputs-r001/c064-supplemental-physical.json'; raw, _ = ev.read(physical, 128 << 10)
+    check(digest(raw) == PHYSICAL_SHA, 'original physical input drift')
+    observed = {r['path']: r for r in ev.decode(raw)['files_stat_and_aliases']}
+    marker = candidate['marker_terminal_classification']
+    extra = {k: marker[k] for k in ('path', 'dev', 'inode', 'uid', 'file_type', 'bytes', 'mtime_ns', 'content_sha256')}
+    extra['kernel_inode_aliases'] = observed[extra['path']]['kernel_inode_aliases']
+    files = original + [normal['file']] + current + [extra]
+    check(len(files) == len({r['path'] for r in files}) == 62 and set(observed) == {r['path'] for r in files}, 'historical exact62 mismatch')
+    births = {(int(pid), b) for pid, b in cp['births'].items()}
+    for job in ('c060', 'c063', 'c064', 'c065', 'c066', 'c067', 'c068', 'cb058'):
+        result = ev.decode(ev.read(ROOT / 'runs' / job / 'result.json', 2 << 20)[0])['processes']
+        check(result['process_tree_empty'] and result['task_resources_closed'] and not result['remaining'] and
+              not result['evidence_errors'] and result['isolation_error'] is None, 'historical monitor incomplete')
+        births.update(((result['supervisor_pid'], result['supervisor_birth']), (result['task_pid'], result['task_birth'])))
+        births.update((int(pid), b) for pid, b in result['owned_births'].items())
+        path = ROOT / 'runs' / job / 'monitor/ownership-history.json'
+        if path.exists():
