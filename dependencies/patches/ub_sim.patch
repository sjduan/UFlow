++    stl_be_p(bytes + 8, 96);
++    stq_be_p(bytes + 16, c->q[MC_EXPORT]);
++    stq_be_p(bytes + 24, native->key.home_va);
++    stq_be_p(bytes + 32, native->key.size);
++    stl_be_p(bytes + 40, native->backing_token_id);
++    stl_be_p(bytes + 44, native->home_cna);
++    stq_be_p(bytes + 48, native->key.segment_id);
++    stq_be_p(bytes + 56, native->key.epoch);
++    /* MSOB segment flags (7) are distinct from GSVA key flags (0). */
++    stl_be_p(bytes + 64, c->n[MC_FLAGS]);
++    stl_be_p(bytes + 68, c->n[MC_NODE]);
++    stl_be_p(bytes + 72, c->n[MC_NODES]);
++    stl_be_p(bytes + 76, native->key.cache_policy);
++    stl_be_p(bytes + 80, native->key.p_tag);
++    stl_be_p(bytes + 84, native->access_flags);
