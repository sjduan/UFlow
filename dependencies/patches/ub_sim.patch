@@ -0,0 +1,32 @@
+#include <stdio.h>
+#include "mem_service_client.h"
+
+/* Installed public SDK consumer. This probe has no allocation or payload API. */
+int main(int argc, char **argv)
+{
+    struct mem_service_client client;
+    struct mem_service_wire_client_options options;
+    enum mem_service_wire_status status = MEM_SERVICE_WIRE_STATUS_INTERNAL;
+    int rc;
+
+    if (argc != 2) {
+        return 2;
+    }
+    mem_service_wire_client_options_init(&options);
+    options.timeout_ms = 1000;
+    options.max_attempts = 1;
+    mem_service_client_init_with_options(&client, argv[1], &options);
+    rc = mem_service_client_health(&client, &status);
+    if (rc != 0 || status != MEM_SERVICE_WIRE_STATUS_OK) {
+        fprintf(stderr, "public SDK health rc=%d status=%u\n", rc, (unsigned)status);
+        return 1;
+    }
+    rc = mem_service_client_ready(&client, &status);
+    if (rc != 0 || status != MEM_SERVICE_WIRE_STATUS_OK) {
+        fprintf(stderr, "public SDK ready rc=%d status=%u\n", rc, (unsigned)status);
+        return 1;
+    }
+    printf("public_sdk_api=%u public_sdk_abi=%u payload_operations=0\n",
+           MEM_SERVICE_CLIENT_API_VERSION, MEM_SERVICE_CLIENT_ABI_VERSION);
+    return 0;
+}
