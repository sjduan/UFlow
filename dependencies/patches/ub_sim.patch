@@ -0,0 +1,411 @@
+#!/usr/bin/env python3
+"""Externally reviewed current-case terminal evidence, never an accounting action.
+
+Contexts contain data and immutable source references. Consumers must bind an
+independently accepted context digest; a caller's self-hash is not admission.
+No prior terminal predicate or already consumed predecessor is evaluated here.
+"""
+import builtins
+import hashlib
+import os
+from pathlib import Path
+import re
+import stat
+import struct
+import time
+import types
+
+ROOT = Path('/workspace/uflow/runs/mem-service-shared-pool-20261108')
+INTERFACE = 'mem-service-current-private-domain-v3'
+PINS = {
+    'uflow_qemu_evidence.py':'0dc9cbe9909bca7d53dcc6aa58b72f72942e699999ecf420055528cbd98c0995',
+    'uflow_qemu_metadata.py':'3edf6eb9e99cfe1a194d273bd11ae0e21f2ddcd3fff7fed2fd835ec9f5c227e5',
+    'uflow_qemu_fixed_launch.py':'949cd0866da8f1ad7b555dc6cf0f0a77574b82ea0499f34a6951fa5c3bb2b12b',
+    'uflow_profile_metadata_v2.py':'d512f1d5b9dbfe7e2c89d8dc4f11fe807fc480a222b1a0f69600b23afa021ecf',
+}
+# OWNERSHIP_PIN is fixed by the source release generator before publication.
+OWNERSHIP_PIN = '826e4a4373c46a4c90ce9012d94bd1107114551f83c15d50c159f722a8f8065a'
+
+
+def _dependencies():
+    pins = {**PINS, 'uflow_monitor_ownership_v3.py':OWNERSHIP_PIN}
+    here = Path(__file__).resolve().parent; bodies = {}; modules = {}
+    for name, pin in pins.items():
+        path = here/name
+        if path.resolve() != path or not stat.S_ISREG(path.lstat().st_mode) or not 0 < path.stat().st_size < 128 << 10:
+            raise ValueError('ordinary same-release fixed source dependency required')
+        raw = path.read_bytes()
+        if hashlib.sha256(raw).hexdigest() != pin: raise ValueError('source dependency drift: '+name)
+        bodies[name] = raw
+    for name, raw in bodies.items():
+        m = types.ModuleType('_recovery_v3_'+name[:-3]); m.__file__ = str(here/name)
+        def importer(key, *args, **kwargs):
+            if key+'.py' in modules: return modules[key+'.py']
+            return builtins.__import__(key, *args, **kwargs)
+        m.__dict__['__builtins__'] = {**vars(builtins), '__import__':importer}
+        exec(compile(raw, m.__file__, 'exec'), m.__dict__); modules[name] = m
+    return modules
+
+
+_D = _dependencies()
+ev = _D['uflow_qemu_evidence.py']; md = _D['uflow_qemu_metadata.py']
+launch_tools = _D['uflow_qemu_fixed_launch.py']; legacy = _D['uflow_profile_metadata_v2.py']
+ownership = _D['uflow_monitor_ownership_v3.py']
+check, bound, document, read, digest, decode = ev.check, ev.bound, ev.document, ev.read, ev.digest, ev.decode
+FALSE_FACTS = {k:False for k in ('normal_metadata_publication_proven','normal_native_or_SDK_release_ACK',
+    'journal_A_complete','journal_B_complete','ledger_mutated','fences_applied','new_allocation_authority',
+    'FM_payload_destroyed','authority_to_mutate_ledger','authority_to_launch_new_Guest')}
+
+
+def reference(path, maximum=4<<20):
+    raw, _ = read(path, maximum)
+    return {'path':str(path), 'bytes':len(raw), 'sha256':digest(raw)}
+
+
+def reviewed(path, external_sha):
+    raw, _ = read(path, 256<<10)
+    check(type(external_sha) is str and re.fullmatch('[0-9a-f]{64}',external_sha) and digest(raw)==external_sha,
+          'independently accepted context digest required')
+    c = decode(raw)
+    check(set(c)=={'schema','interface','kind','run','observation','confinement_ancestry','ownership','expected','helper'} and
+          c['schema']==3 and c['interface']==INTERFACE and c['kind']=='captured-current-private-domain-context-v3' and
+          re.fullmatch('c[0-9]{3}',c['run']), 'exact production context, no caller readiness/force/fixture flags')
+    observation = document(c['observation'])
+    check(observation['kind']=='observed-c081-context-inputs-only' and observation['current_terminal_eligibility_claimed'] is False,
+          'primary immutable observation required')
+    return c, observation['references']
+
+
+def source_runtime(c, refs):
+    build = document(refs['build']); manifest = document(refs['source_manifest'])
+    compiled = document(refs['compiled_build']); cm = document(refs['compiled_source_manifest'])
+    expected = c['expected']; source = Path(build['source'])
+    check(source.is_relative_to(ROOT/'implementation') and build['source_commit']==manifest['commit']==expected['source_commit'] and
+          build['source_manifest_sha256']==refs['source_manifest']['sha256'] and
+          build['compiled_source_commit']==cm['commit']==compiled['source_commit'] and
+          build['compiled_generation']==expected['compiled_generation'] and
+          len(manifest['files'])==expected['source_file_count'], 'actual current/compiled source graph mismatch')
+    embedded = set(); occurrences = 0; rust = []
+    for name, row in manifest['files'].items():
+        relative = Path(name); check(not relative.is_absolute() and '..' not in relative.parts,'source escape')
+        path = source/relative; body = bound({'path':str(path),'bytes':row['bytes'],'sha256':row['sha256']},16<<20,allow_empty=True)
+        check(stat.S_IMODE(path.stat().st_mode)==int(row['mode'],8)&0o777,'source mode drift')
+        if name.startswith('crates/uf-daemon/') and name.endswith('.rs'):
+            rust.append(name); check(row==cm['files'][name],'reused daemon Rust input differs')
+            for member in re.findall(rb'include_(?:str|bytes)!\(\s*"([^"]+)"\s*\)',body):
+                included = (path.parent/member.decode()).resolve(); check(included.is_relative_to(source),'include escape')
+                embedded.add(str(included.relative_to(source))); occurrences += 1
+    check((len(rust),len(embedded),occurrences)==tuple(expected['daemon_inputs']),'complete compiled Rust/embedded input set differs')
+    for name in embedded|{'Cargo.lock','Cargo.toml'}: check(manifest['files'][name]==cm['files'][name],'compiled embedded/Cargo input drift')
+    base = document(refs['image_build'])
+    check(build['component_reuse']['base_receipt_sha256']==refs['image_build']['sha256'] and
+          build['daemon_sha256']==compiled['daemon_sha256']==expected['daemon_sha256'] and
+          all(build[key]==base[key] for key in ('image','image_sha256','agent_sha256','source_inputs','official_worker')),
