@@ -0,0 +1,254 @@
+#!/usr/bin/env python3
+"""Validate a pinned host-only kernel candidate before any runtime mutation.
+
+The expected producer manifest SHA256 must come from the reviewed handoff.
+This module only reads files; it never starts a Guest or changes a lineage.
+"""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import stat
+import zlib
+
+INTERFACE = 'mem-service-private-kernel-profile-v1'
+PROFILE = 'mem-service-gsva-separated-v1'
+KERNEL = 'c2def7c931e6451d89727dec0c6f892abe28ba00'
+BASE_IMAGE = '18f81737d7e2a7bdaa0b72a3c86bf5b2c7ff3fd742434437ffa8926be5deb4fd'
+BASE_CONFIG = 'f0400a59db1d9eddecdc57a828b887075aa611a07f19e369371029af755152d8'
+FLAG = 'CONFIG_UB_UMMU_SVA_SEPARATED_PAGES'
+REQUIRED = ('CONFIG_UB_UMMU_CORE', 'CONFIG_UB_UMMU_CORE_DRIVER', FLAG,
+            'CONFIG_UB_UBUS', 'CONFIG_IOMMU_API', 'CONFIG_IKCONFIG')
+DELTA = {FLAG: {'before': 'n', 'after': 'y'}}
+MAX_IMAGE = 128 << 20
+MAX_CONFIG = 2 << 20
+
+
+class ProfileError(ValueError):
+    pass
+
+
+def require(condition, reason):
+    if not condition:
+        raise ProfileError(reason)
+
+
+def sha256(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def unique_object(pairs):
+    value = {}
+    for key, item in pairs:
+        require(key not in value, 'duplicate JSON field')
+        value[key] = item
+    return value
+
+
+def json_bytes(data):
+    try:
+        return json.loads(data, object_pairs_hook=unique_object)
+    except (UnicodeError, json.JSONDecodeError) as error:
+        raise ProfileError('invalid JSON') from error
+
+
+def open_regular(path):
+    """Reject devices, FIFOs and links before opening; a raced FIFO cannot block."""
+    path = Path(path)
+    require(stat.S_ISREG(path.lstat().st_mode), 'regular input file required')
+    return os.open(path, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0) | getattr(os, 'O_NONBLOCK', 0))
+
+
+def read_file(path, maximum):
+    path = Path(path)
+    try:
+        descriptor = open_regular(path)
+        with os.fdopen(descriptor, 'rb') as stream:
+            before = os.fstat(stream.fileno())
+            require(stat.S_ISREG(before.st_mode) and 0 < before.st_size <= maximum,
+                    'file missing, empty, non-regular or oversized')
+            data = stream.read(maximum + 1)
+            after = os.fstat(stream.fileno())
+            require(len(data) == before.st_size and len(data) <= maximum,
+                    'file size changed or read exceeded bound')
+            require((before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) ==
+                    (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns), 'file changed while reading')
+            return data
+    except OSError as error:
+        raise ProfileError('required file unavailable: ' + str(path)) from error
+
+
+def checked_output(record, maximum):
+    require(type(record) is dict and set(('path', 'bytes', 'sha256')) <= record.keys(), 'incomplete output record')
+    require(type(record['path']) is str and 0 < len(record['path']) <= 4096, 'invalid output path')
+    path = Path(record['path'])
+    require(path.is_absolute(), 'absolute output path required')
+    require(type(record['bytes']) is int and 0 < record['bytes'] <= maximum, 'invalid output size')
+    require(type(record['sha256']) is str and re.fullmatch('[0-9a-f]{64}', record['sha256']), 'invalid output digest')
+    # Stream large ELF files instead of retaining their bytes in the consumer.
+    try:
+        descriptor = open_regular(path)
+        with os.fdopen(descriptor, 'rb') as stream:
+            info = os.fstat(stream.fileno())
+            require(stat.S_ISREG(info.st_mode) and info.st_size == record['bytes'], 'output size/type mismatch')
+            digest = hashlib.sha256()
+            for _ in range((maximum >> 20) + 1):
+                chunk = stream.read(1 << 20)
+                if not chunk:
+                    break
+                digest.update(chunk)
+            else:
+                raise ProfileError('output read exceeded bound')
+            after = os.fstat(stream.fileno())
+            require((info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns) ==
+                    (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns), 'output changed during hashing')
+            require(digest.hexdigest() == record['sha256'], 'output hash mismatch')
+    except OSError as error:
+        raise ProfileError('required output unavailable: ' + str(path)) from error
+    return path
+
+
+def bound_bytes(record, maximum):
+    data = read_file(record['path'], maximum)
+    require(len(data) == record['bytes'] and sha256(data) == record['sha256'], 'bound file bytes changed')
+    return data
+
+
+def extract_ikconfig(image):
+    require(64 <= len(image) <= MAX_IMAGE and image[56:60] == b'ARM\x64', 'not a bounded arm64 Image')
+    require(image.count(b'IKCFG_ST') == image.count(b'IKCFG_ED') == 1, 'missing or duplicate embedded config')
+    start = image.index(b'IKCFG_ST') + 8
+    stop = image.index(b'IKCFG_ED')
+    require(0 < stop - start <= MAX_CONFIG, 'invalid embedded config span')
+    try:
+        decoder = zlib.decompressobj(31)
+        config = decoder.decompress(image[start:stop], MAX_CONFIG + 1)
+        require(0 < len(config) <= MAX_CONFIG, 'embedded config exceeds bound')
+        require(decoder.eof and not decoder.unused_data and not decoder.unconsumed_tail,
+                'truncated, concatenated or oversized embedded config')
+    except zlib.error as error:
+        raise ProfileError('invalid embedded gzip/CRC') from error
+    parse_config(config)
+    return config
+
+
+def parse_config(data):
+    require(0 < len(data) <= MAX_CONFIG and data.endswith(b'\n') and b'\0' not in data, 'invalid config length/termination')
+    try:
+        lines = data.decode('utf-8').splitlines()
+    except UnicodeError as error:
+        raise ProfileError('config is not UTF-8') from error
+    require(len(lines) <= 100000, 'config line count exceeded')
+    values = {}
+    for line in lines:
+        require(len(line) <= 4096, 'config line exceeded bound')
+        if not line or (line.startswith('#') and not line.startswith('# CONFIG_')):
+            continue
+        match = re.fullmatch(r'(CONFIG_[A-Za-z0-9_]+)=(.+)', line)
+        disabled = re.fullmatch(r'# (CONFIG_[A-Za-z0-9_]+) is not set', line)
+        require(match is not None or disabled is not None, 'malformed config entry')
+        key, value = match.groups() if match else (disabled.group(1), 'n')
+        require(key not in values, 'duplicate config symbol')
+        values[key] = value
+    require(values, 'empty config symbol table')
+    return values
+
+
+def validate(manifest_path, expected_manifest_sha256, image_path):
+    require(type(expected_manifest_sha256) is str and re.fullmatch('[0-9a-f]{64}', expected_manifest_sha256),
+            'reviewed manifest digest required')
+    raw = read_file(manifest_path, 256 << 10)
+    require(sha256(raw) == expected_manifest_sha256, 'producer manifest hash mismatch')
+    manifest = json_bytes(raw)
+    require(type(manifest) is dict and type(manifest.get('schema')) is int and manifest['schema'] == 1, 'wrong manifest schema')
+    require(manifest.get('interface') == INTERFACE and manifest.get('profile_id') == PROFILE, 'wrong profile identity')
+    require(manifest.get('kernel_commit') == KERNEL, 'wrong kernel source commit')
+    require(manifest.get('base_Image_sha256') == BASE_IMAGE and
+            manifest.get('base_embedded_config_sha256') == BASE_CONFIG, 'wrong base profile binding')
+    require(manifest.get('resolved_config_diff') == DELTA, 'unexpected resolved configuration delta')
+    require(manifest.get('required_builtin_config') == list(REQUIRED), 'required builtin set changed')
+    require(manifest.get('runtime_tested') is False, 'host-only profile cannot assert runtime success')
+    require(manifest.get('authority_to_boot_or_replace_existing_Image') is False, 'host candidate cannot grant boot authority')
+    outputs = manifest.get('outputs')
+    needed = {'Image', 'vmlinux', 'System.map', '.config', 'base.config', 'source_manifest', 'source_ls_tree',
+              'compiler', 'build_commands', 'build_recipe', 'symbol_evidence', 'core_matt.o', 'obmm_export.o', 'old_baseline'}
+    require(type(outputs) is dict and needed <= outputs.keys() and len(outputs) <= 24, 'incomplete artifact closure')
+    require(all(type(outputs[key]) is dict and {'path', 'bytes', 'sha256'} <= outputs[key].keys() for key in needed),
+            'incomplete artifact record')
+    selected = Path(image_path)
+    require(selected.is_absolute() and str(selected) == outputs['Image']['path'], 'selected Image is not a manifest member')
+    require(outputs['Image']['sha256'] != BASE_IMAGE, 'old disabled Image rejected')
+    for name in needed:
+        maximum = MAX_IMAGE if name == 'Image' else MAX_CONFIG if name in ('.config', 'base.config') else 2 << 30 if name == 'vmlinux' else 32 << 20
+        checked_output(outputs[name], maximum)
+    embedded = extract_ikconfig(bound_bytes(outputs['Image'], MAX_IMAGE))
+    require(sha256(embedded) == manifest.get('embedded_config_sha256') == outputs['.config']['sha256'],
+            'embedded config does not equal resolved config')
+    base = bound_bytes(outputs['base.config'], MAX_CONFIG)
+    require(sha256(base) == BASE_CONFIG, 'base config bytes do not match old embedded config')
+    before, after = parse_config(base), parse_config(embedded)
+    actual = {key: {'before': before.get(key), 'after': after.get(key)} for key in sorted(before.keys() | after.keys())
+              if before.get(key) != after.get(key)}
+    require(actual == DELTA, 'actual Image changed another config symbol')
+    require(all(after.get(key) == 'y' for key in REQUIRED), 'required Image builtin disabled')
+    source = json_bytes(bound_bytes(outputs['source_manifest'], 1 << 20))
+    require(type(source) is dict, 'source manifest must be an object')
+    require(outputs['source_manifest']['sha256'] == manifest.get('source_manifest_sha256'), 'source manifest binding changed')
+    require(source.get('kernel_commit') == KERNEL and re.fullmatch('[0-9a-f]{40}', str(source.get('tree', ''))) and
+            source.get('git_ls_tree_sha256') == outputs['source_ls_tree']['sha256'],
+            'source object closure mismatch')
+    compiler = json_bytes(bound_bytes(outputs['compiler'], 1 << 20))
+    require(type(compiler) is dict, 'compiler record must be an object')
+    provenance = manifest.get('compiler_and_build_argv')
+    require(type(provenance) is dict and provenance.get('compiler_sha256') == outputs['compiler']['sha256'] and
+            provenance.get('build_commands_sha256') == outputs['build_commands']['sha256'] and
+            provenance.get('build_recipe_sha256') == outputs['build_recipe']['sha256'] and
+            provenance.get('parallel_workers') == 4, 'compiler/argv/recipe closure mismatch')
+    require(str(compiler.get('dumpmachine', '')).startswith('aarch64') and
+            re.fullmatch('[0-9a-f]{64}', str(compiler.get('sha256', ''))) and compiler.get('version'), 'compiler provenance incomplete')
+    commands = [json_bytes(line) for line in bound_bytes(outputs['build_commands'], 1 << 20).splitlines()]
+    require(0 < len(commands) <= 32 and all(type(row) is dict for row in commands), 'bounded build command records required')
+    require(any(row.get('argv', [])[:1] == ['make'] and 'Image' in row['argv'] and 'vmlinux' in row['argv'] and
+                '-j4' in row['argv'] and 'ARCH=arm64' in row['argv'] and
+                row['argv'][1:3] == ['-C', source.get('source_root')] for row in commands), 'bounded kernel build argv missing')
+    symbols = json_bytes(bound_bytes(outputs['symbol_evidence'], 4 << 20))
+    require(type(symbols) is dict, 'symbol evidence must be an object')
+    require(manifest.get('real_symbol_and_obmm_call_evidence') == outputs['symbol_evidence']['sha256'], 'symbol evidence not bound')
+    require(symbols.get('objects') == {key: outputs[key]['sha256'] for key in ('core_matt.o', 'obmm_export.o', 'vmlinux')},
+            'symbol evidence refers to different objects')
+    require(re.search(r'\b[Tt]\s+ummu_sva_matt_map\s*$', symbols.get('core_matt_nm', ''), re.M), 'core_matt map definition absent')
+    require(re.search(r'\b[Tt]\s+ummu_sva_matt_map\s*$', symbols.get('vmlinux_nm', ''), re.M), 'linked kernel map definition absent')
+    require(re.search(r'R_AARCH64_CALL26\s+[^\n]*\bummu_sva_matt_map\b', symbols.get('obmm_relocations', '')),
+            'OBMM real map call relocation absent')
+    require('ummu_sva_matt_map' in symbols.get('linked_obmm_call', '') and
+            re.search(r'\bbl\b[^\n]*<ummu_sva_matt_map>', symbols['linked_obmm_call']), 'linked OBMM call to map absent')
+    baseline = json_bytes(bound_bytes(outputs['old_baseline'], 4 << 20))
+    require(type(baseline) is dict, 'baseline evidence must be an object')
+    require(manifest.get('old_baseline_unchanged') == outputs['old_baseline']['sha256'] and
+            baseline.get('before') == baseline.get('after') and baseline.get('old_Image_sha256') == BASE_IMAGE and
+            baseline.get('old_embedded_config_sha256') == BASE_CONFIG and baseline.get('old_source_commit') == KERNEL,
+            'old baseline closure mismatch')
+    return {'status': 'PASS_HOST_PROFILE_ONLY', 'interface': INTERFACE, 'profile_id': PROFILE,
+            'producer_manifest_sha256': expected_manifest_sha256, 'Image': str(selected),
+            'Image_sha256': outputs['Image']['sha256'], 'embedded_config_sha256': sha256(embedded),
+            'required_builtin_config': {key: after[key] for key in REQUIRED}, 'runtime_tested': False,
+            'authority_to_boot_or_replace_existing_Image': False}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--manifest', required=True)
+    parser.add_argument('--manifest-sha256', required=True)
+    parser.add_argument('--image', required=True)
+    args = parser.parse_args()
+    try:
+        result = validate(args.manifest, args.manifest_sha256, args.image)
+    except (ProfileError, KeyError, TypeError) as error:
+        parser.exit(2, 'REJECT_KERNEL_PROFILE: ' + str(error) + '\n')
+    print(json.dumps(result))
+
+
+if __name__ == '__main__':
+    main()
