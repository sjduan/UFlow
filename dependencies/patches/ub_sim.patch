+    def test_fd_and_vma_holders(self):
+        helper = m.ev.frozen_helper(HELPER)
+        row = m.document(self.case['artifacts']['carriers'])['files'][0]
+        row = next(r for r in m.document(self.case['artifacts']['carriers'])['files'] if r['path'].endswith('.ring'))
+        pairs = {tuple(v) for v in row['kernel_inode_aliases']}
+        with open(row['path'], 'rb') as f:
+            self.assertTrue(helper.holders(pairs)['holders'])
+            mapping = mmap.mmap(f.fileno(), 4096, access=mmap.ACCESS_READ)
+        try:
+            self.assertTrue(helper.holders(pairs)['holders'])
+            with self.assertRaisesRegex(ValueError, 'FD/VMA holder'): m.validate_fixture_union(self.plan['path'], self.plan['sha256'])
+        finally: mapping.close()
+
+
+if __name__ == '__main__': unittest.main(verbosity=2)
diff --git a/guest-linux/aarch64/scripts/uflow_build_supervisor.py b/guest-linux/aarch64/scripts/uflow_build_supervisor.py
new file mode 100755
index 0000000000000000000000000000000000000000..3f00211794d4a5eb116b714797406b957f0fa40d
--- /dev/null
+++ b/guest-linux/aarch64/scripts/uflow_build_supervisor.py
@@ -0,0 +1,131 @@
+#!/usr/bin/env python3
+"""Use the accepted lifecycle monitor with birth-keyed retirement for builds.
+
+Compiler processes churn rapidly. A proven dead identity leaves the live map;
+its immutable history remains. A replacement numeric PID gains no authority
+from that history: the accepted monitor must independently discover it in the
+private descendant tree or delegated cgroup before it can ever be signalled.
+"""
+import argparse
+import hashlib
+import importlib
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import time
+
+
+def retire_dead(known, birth):
+    retired = []
+    for pid, row in list(known.items()):
+        current = birth(pid)
+        if current != row['birth']:
+            retired.append({**row, 'retirement': 'absent' if current is None else 'numeric-PID-reused',
+                            'replacement_birth_not_authorized': current})
+            del known[pid]
+    return retired
+
+
+def core_module(root, hashes):
+    root = Path(root).resolve()
+    if set(hashes) != {'task_supervisor.py', 'task_lifecycle.py', 'task_resources.py'}:
+        raise ValueError('complete accepted supervisor closure required')
+    for name, expected in hashes.items():
+        if hashlib.sha256((root / name).read_bytes()).hexdigest() != expected:
+            raise ValueError('accepted supervisor source drift')
+    sys.path.insert(0, str(root))
+    core = importlib.import_module('task_supervisor')
+    if Path(core.__file__).resolve() != root / 'task_supervisor.py':
+        raise ValueError('accepted monitor module path drift')
+    return core
+
+
+def monitor_type(core):
+    class BuildSupervisor(core.OwnedSupervisor):
+        def __init__(self, config):
+            super().__init__(config)
+            self.history, self.retirements = {}, []
+
+        def capture(self):
+            for row in self.known.values():
+                self.history[(row['pid'], row['birth'])] = dict(row)
+            if len(self.history) > 50000:
+                raise RuntimeError('build identity history bound exceeded')
+
+        def refresh(self):
+            self.capture()
+            self.retirements.extend(retire_dead(self.known, core.birth))
+            alive = super().refresh()
+            self.capture()
+            return alive
+
+        def event(self, event, **values):
+            if event not in ('owned-birth', 'owned-cgroup-birth'):
+                with (self.root / 'build-critical-events.jsonl').open('a') as stream:
+                    stream.write(json.dumps({'event': event, 'monotonic_ns': time.monotonic_ns(), **values})+'\n')
+            super().event(event, **values)
+
+        def run(self):
+            try:
+                result = super().run()
+            finally:
+                self.capture()
+                with (self.root / 'ownership-history.json').open('x') as stream:
+                    json.dump({'observed_identities': list(self.history.values()), 'retirements': self.retirements,
+                               'replacement_admission': 'only accepted private descendants/cgroup traversal',
+                               'frozen_supervisor_modified': False}, stream)
+            result['ownership_history'] = str(self.root / 'ownership-history.json')
+            result['retired_identity_count'] = len(self.retirements)
+            return result
+    return BuildSupervisor
+
+
+def run_external(argv, root, *, accepted_root, accepted_hashes, **bounds):
+    core = core_module(accepted_root, accepted_hashes)
+    root = Path(root)
+    root.mkdir()
+    config = {'argv': list(argv), 'root': str(root.resolve()), 'launcher_pid': os.getpid(),
+              'launcher_birth': core.birth(os.getpid()), 'cgroup_parent': None, 'file_limit': 1024,
+              'private_cleanup_seconds': 15, **bounds}
+    if config.get('graceful_ready') is not None:
+        config['graceful_ready'] = str(config['graceful_ready'])
+    config = core.bounded_spec(config)
+    config_path = root / 'config.json'
+    config_path.write_text(json.dumps(config))
+    binding = root / 'accepted-source.json'
+    binding.write_text(json.dumps({'root': str(accepted_root), 'hashes': accepted_hashes}))
+    with (root / 'supervisor.log').open('xb') as log:
+        monitor = subprocess.Popen([sys.executable, '-B', '-s', str(Path(__file__).resolve()),
+                                   '--config', str(config_path), '--binding', str(binding)], stdout=log, stderr=subprocess.STDOUT)
+        born = core.birth(monitor.pid)
+        (root / 'supervisor-start.json').write_text(json.dumps({'pid': monitor.pid, 'birth': born}))
+        maximum = config['run_seconds'] + max(config['grace_seconds'], config['close_seconds']) + config['term_seconds'] + config['kill_seconds'] + 33
+        try:
+            code = monitor.wait(timeout=maximum)
+        except subprocess.TimeoutExpired:
+            raise RuntimeError('build monitor exceeded bound; retain quarantine') from None
+    result = json.loads((root / 'result.json').read_bytes()) if (root / 'result.json').exists() else None
+    if code != 0 or result is None:
+        raise RuntimeError('build monitor failed; retain original boundary and receipts')
+    result.update(supervisor_pid=monitor.pid, supervisor_birth=born, supervisor_actual_exit_code=code,
+                  ownership_history=str(root / 'ownership-history.json'),
+                  adapter='static birth-keyed build identity retirement; accepted lifecycle and pidfd signalling unchanged')
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--config', type=Path, required=True)
+    parser.add_argument('--binding', type=Path, required=True)
+    args = parser.parse_args()
+    binding = json.loads(args.binding.read_bytes())
+    core = core_module(binding['root'], binding['hashes'])
+    result = monitor_type(core)(json.loads(args.config.read_bytes())).run()
+    print(json.dumps({'process_tree_empty': result['process_tree_empty'], 'status': result['status']}))
+    raise SystemExit(0 if result['task_resources_closed'] else 9)
+
+
+if __name__ == '__main__':
+    main()
