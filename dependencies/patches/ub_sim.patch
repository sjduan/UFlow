+"""Task boundary guards and real Linux failure-to-reap coverage without NPU use."""
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+import time
+import unittest
+from unittest import mock
+
+SCRIPT = Path(__file__).resolve().parents[1] / 'scripts/uflow_env_runner.py'
+spec = importlib.util.spec_from_file_location('uflow_env_runner', SCRIPT)
+runner = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(runner)
+NAMES = ('task_supervisor.py', 'task_lifecycle.py', 'task_resources.py')
+
+
+@unittest.skipUnless(sys.platform.startswith('linux'), 'same-UID Linux task roots required')
+class ConfigGuards(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix='t', dir=os.environ.get('UFLOW_TEST_WORK_DIR'))
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name).resolve()
+        self.sup = self.root / 'supervisor'
+        self.sup.mkdir()
+        for name in NAMES:
+            (self.sup / name).write_text('# source identity fixture\n')
+        self.config = {'root': str(self.root), 'job': 'unit-001', 'kind': 'host', 'run_seconds': 30,
+                       'supervisor_root': str(self.sup),
+                       'supervisor_sha256': {n: hashlib.sha256((self.sup / n).read_bytes()).hexdigest() for n in NAMES},
+                       'commands': [{'argv': [sys.executable, '-c', 'print(1)'], 'cwd': str(self.root)}]}
+        self.path = self.root / 'config.json'
+
+    def load(self):
+        self.path.write_text(json.dumps(self.config))
+        return runner.load(self.path)
+
+    def test_valid_config(self):
+        self.assertEqual(self.load()[1], self.root)
+
+    def test_escape_cwd_rejected(self):
+        self.config['commands'][0]['cwd'] = str(self.root.parent)
+        with self.assertRaises(ValueError):
+            self.load()
+
+    def test_socket_path_rejected_before_launch(self):
+        self.config['root'] = str(self.root / ('x' * 80))
+        Path(self.config['root']).mkdir()
+        with self.assertRaises(ValueError):
+            self.load()
+
+    def test_unbound_supervisor_rejected(self):
+        (self.sup / NAMES[0]).write_text('changed')
+        with self.assertRaises(ValueError):
+            self.load()
+
+    def test_incomplete_supervisor_rejected(self):
+        del self.config['supervisor_sha256'][NAMES[0]]
+        with self.assertRaises(ValueError):
+            self.load()
+
+    def test_unbounded_runtime_rejected(self):
+        for duration in (0, -1, 3601, float('inf'), float('nan'), True):
+            with self.subTest(duration=duration):
+                self.config['run_seconds'] = duration
+                with self.assertRaises(ValueError):
+                    self.load()
+
+    def test_guest_group_cap(self):
+        self.config.update(kind='guest', run_seconds=1801)
+        with self.assertRaises(ValueError):
+            self.load()
+
+    def test_close_and_command_caps(self):
+        for key, duration in (('close_seconds', 11), ('term_seconds', 11), ('kill_seconds', 6)):
+            with self.subTest(key=key):
+                self.config[key] = duration
+                with self.assertRaises(ValueError):
+                    self.load()
+                del self.config[key]
+        self.config['commands'][0]['seconds'] = 31
+        with self.assertRaises(ValueError):
+            self.load()
+
+
+@unittest.skipUnless(sys.platform.startswith('linux') and os.environ.get('UFLOW_TEST_SUPERVISOR'),
+                     'real Linux tests require explicit accepted supervisor source')
+class RealProcesses(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix='t', dir=os.environ.get('UFLOW_TEST_WORK_DIR'))
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name).resolve()
+        (self.root / 'runs').mkdir()
+        self.sup = Path(os.environ['UFLOW_TEST_SUPERVISOR']).resolve()
+        self.addCleanup(self.capture)
+
+    def capture(self):
+        if os.environ.get('UFLOW_TEST_EVIDENCE_DIR'):
+            target = Path(os.environ['UFLOW_TEST_EVIDENCE_DIR']) / self._testMethodName
+            shutil.copytree(self.root, target, symlinks=True)
+
+    def execute(self, code, *, kind='host', seconds=30, command_seconds=None):
+        config = {'root': str(self.root), 'job': 'real-001', 'kind': kind, 'run_seconds': seconds,
+                  'close_seconds': .15, 'term_seconds': .15, 'kill_seconds': 1,
+                  'supervisor_root': str(self.sup),
+                  'supervisor_sha256': {n: hashlib.sha256((self.sup / n).read_bytes()).hexdigest() for n in NAMES},
+                  'commands': [{'argv': [sys.executable, '-B', '-s', '-c', code], 'cwd': str(self.root)}]}
+        if command_seconds is not None:
+            config['commands'][0]['seconds'] = command_seconds
+        path = self.root / 'config.json'
+        path.write_text(json.dumps(config))
+        start = time.monotonic()
+        p = subprocess.run([sys.executable, '-B', '-s', str(SCRIPT), str(path)], capture_output=True, timeout=15)
+        result_path = self.root / 'runs/real-001/result.json'
+        return p, json.loads(result_path.read_bytes()) if result_path.exists() else None, time.monotonic() - start
+
+    def test_normal_wait_and_live_log(self):
+        p, result, _ = self.execute('print("actual child output", flush=True)')
+        self.assertEqual(p.returncode, 0, p.stderr)
+        self.assertEqual(result['processes']['actual_task_exit_code'], 0)
+        self.assertTrue(result['processes']['process_tree_empty'])
+        self.assertIn('actual child output', (self.root / 'runs/real-001/command-00.log').read_text())
+
+    def test_build_monitor_retains_dead_identity_history(self):
+        p, result, _ = self.execute(
+            'import os,time\n'
+            'for _ in range(20):\n'
+            ' p=os.fork()\n'
+            ' if p==0: time.sleep(.03); os._exit(0)\n'
+            ' os.waitpid(p,0)\n', kind='build')
+        self.assertEqual(p.returncode, 0, p.stderr)
+        self.assertTrue(result['processes']['process_tree_empty'])
+        history = json.loads((self.root / 'runs/real-001/monitor/ownership-history.json').read_bytes())
+        self.assertGreater(len(history['observed_identities']), 2)
+        self.assertTrue(history['retirements'])
+        self.assertFalse(history['frozen_supervisor_modified'])
+
+    def test_build_notice_reaps_hanging_child(self):
+        p, result, duration = self.execute(
+            'import os,signal\n'
+            'signal.signal(signal.SIGTERM,signal.SIG_IGN)\n'
+            'os.write(int(os.environ["UFLOW_ENV_CLOSE_FD"]),b"!")\n'
+            'while True: signal.pause()\n', kind='build', seconds=120)
+        self.assertNotEqual(p.returncode, 0)
+        self.assertLess(duration, 5)
+        self.assertTrue(result['processes']['process_tree_empty'])
+        self.assertIn(-9, result['processes']['actual_wait_statuses'].values())
+
+    def test_notice_precedes_hanging_diagnostics_and_exact_reap(self):
+        backing = self.root / 'shared-fm'
+        backing.write_bytes(b'not-private-SHM')
+        p, result, duration = self.execute(
+            'import os,signal\n'
+            'signal.signal(signal.SIGTERM,signal.SIG_IGN)\n'
+            'os.write(int(os.environ["UFLOW_ENV_CLOSE_FD"]),b"!")\n'
+            'while True: signal.pause()\n', seconds=120)
+        self.assertNotEqual(p.returncode, 0)
+        self.assertLess(duration, 5)
+        actual = result['processes']
+        self.assertTrue(actual['process_tree_empty'])
+        self.assertEqual(actual['remaining'], {})
+        self.assertIn(-9, actual['actual_wait_statuses'].values())
+        self.assertFalse(actual['SDK_ACK_inferred_from_death'])
+        self.assertEqual(backing.read_bytes(), b'not-private-SHM')
+        self.assertEqual(actual['stop_reason'], 'task-closing-notice')
+
+    def test_closed_stdout_cannot_hide_command_timeout(self):
+        p, result, duration = self.execute(
+            'import os,signal\n'
+            'signal.signal(signal.SIGTERM,signal.SIG_IGN)\n'
+            'os.close(1);os.close(2)\n'
+            'while True: signal.pause()\n', seconds=120, command_seconds=.25)
+        self.assertNotEqual(p.returncode, 0)
+        self.assertLess(duration, 5)
+        self.assertTrue(result['processes']['process_tree_empty'])
+        self.assertIn(-9, result['processes']['actual_wait_statuses'].values())
+
+    def test_guest_lock_rejected_without_launch(self):
+        import fcntl
+        coordination = self.root / 'coordination'
+        coordination.mkdir()
+        with (coordination / 'guest-execution.lock').open('a+') as lock:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            p, result, _ = self.execute('raise Exception("must not launch")', kind='guest')
+        self.assertNotEqual(p.returncode, 0)
+        self.assertIsNone(result)
+        self.assertFalse((self.root / 'runs/real-001/ready.json').exists())
+
+    def test_unresolved_guest_fence_rejected_without_launch(self):
+        coordination = self.root / 'coordination'
+        coordination.mkdir()
+        (coordination / 'guest-process-quarantine.json').write_text('{"unresolved_process_boundary":true}')
+        p, result, _ = self.execute('raise Exception("must not launch")', kind='guest')
+        self.assertNotEqual(p.returncode, 0)
+        self.assertIsNone(result)
+        self.assertFalse((self.root / 'runs/real-001/ready.json').exists())
+
+    def test_usage_excludes_external_base_and_deduplicates_hardlink(self):
+        base = self.root.parent / (self.root.name + '-base')
+        base.mkdir()
+        self.addCleanup(lambda: base.rmdir())
+        (self.root / 'base-link').symlink_to(base, target_is_directory=True)
+        first = self.root / 'owned'
+        first.write_bytes(b'x' * 4096)
