+def extract_function(source, name):
+    """Lexical definition extraction; braces in strings/comments do not count."""
+    definitions = []
+    for m in re.finditer(r'(?m)^(?:static\s+)?(?:inline\s+)?[\w *]+\b' + re.escape(name) + r'\s*\(', source):
+        start = source.find('{', m.end()); semi = source.find(';', m.end())
+        if start < 0 or 0 <= semi < start:
+            continue
+        pos, depth, state = start, 0, 'code'
+        while pos < len(source):
+            c, pair = source[pos], source[pos:pos + 2]
+            if state == 'line':
+                if c == '\n': state = 'code'
+            elif state == 'comment':
+                if pair == '*/': state = 'code'; pos += 1
+            elif state in ('"', "'"):
+                if c == '\\': pos += 1
+                elif c == state: state = 'code'
+            elif pair == '//': state = 'line'; pos += 1
+            elif pair == '/*': state = 'comment'; pos += 1
+            elif c in ('"', "'"): state = c
+            elif c == '{': depth += 1
+            elif c == '}':
+                depth -= 1
+                if depth == 0:
+                    definitions.append(source[m.start():pos + 1]); break
+            pos += 1
+    check(len(definitions) == 1, 'unique writer definition required: ' + name)
+    return definitions[0]
+
