+"""CPU-only bounded IKCONFIG checks and real candidate negative validation."""
+import copy
+import ast
+import gzip
+import importlib.util
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+SCRIPT = Path(__file__).resolve().parents[1] / 'scripts/uflow_kernel_profile.py'
+spec = importlib.util.spec_from_file_location('kernel_profile', SCRIPT)
+profile = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(profile)
+
+
+def image(config, packed=None):
+    header = bytearray(64)
+    header[56:60] = b'ARM\x64'
+    return bytes(header) + b'IKCFG_ST' + (gzip.compress(config) if packed is None else packed) + b'IKCFG_ED'
+
+
+class EmbeddedConfig(unittest.TestCase):
+    def test_extracts_gzip_and_validates_symbols(self):
+        config = b'CONFIG_FOO=y\n# CONFIG_BAR is not set\nCONFIG_MT792x_LIB=m\n# CONFIG_SCSI_DC395x is not set\n'
+        self.assertEqual(profile.extract_ikconfig(image(config)), config)
+        self.assertEqual(profile.parse_config(config), {'CONFIG_FOO': 'y', 'CONFIG_BAR': 'n',
+                                                       'CONFIG_MT792x_LIB': 'm', 'CONFIG_SCSI_DC395x': 'n'})
+
+    def test_missing_start_end_and_wrong_arm_header_rejected(self):
+        good = image(b'CONFIG_FOO=y\n')
+        for bad in (good.replace(b'IKCFG_ST', b'XXXXXXXX'), good.replace(b'IKCFG_ED', b'YYYYYYYY'),
+                    b'\0' * 64 + good[64:]):
+            with self.subTest(kind=bad[-8:]), self.assertRaises(profile.ProfileError):
+                profile.extract_ikconfig(bad)
+
+    def test_duplicate_markers_rejected(self):
+        good = image(b'CONFIG_FOO=y\n')
+        for marker in (b'IKCFG_ST', b'IKCFG_ED'):
+            with self.subTest(marker=marker), self.assertRaisesRegex(profile.ProfileError, 'duplicate'):
+                profile.extract_ikconfig(good + marker)
+
+    def test_duplicate_config_symbol_rejected_even_if_same(self):
+        for config in (b'CONFIG_FOO=y\nCONFIG_FOO=y\n', b'CONFIG_FOO=y\n# CONFIG_FOO is not set\n'):
+            with self.subTest(config=config), self.assertRaisesRegex(profile.ProfileError, 'duplicate'):
+                profile.extract_ikconfig(image(config))
+
+    def test_truncated_gzip_crc_and_concatenated_stream_rejected(self):
+        config = b'CONFIG_FOO=y\n'
+        packed = gzip.compress(config)
+        for blob in (packed[:-3], packed[:-1] + bytes([packed[-1] ^ 255]), packed + gzip.compress(config)):
+            with self.subTest(bytes=len(blob)), self.assertRaises(profile.ProfileError):
+                profile.extract_ikconfig(image(config, blob))
+
+    def test_compression_bomb_exceeds_output_limit(self):
+        with self.assertRaisesRegex(profile.ProfileError, 'bound'):
+            profile.extract_ikconfig(image(b'#' * (profile.MAX_CONFIG + 1)))
+
+    def test_missing_final_newline_and_malformed_entries_rejected(self):
+        for config in (b'CONFIG_FOO=y', b'CONFIG_FOO\n', b'CONFIG_FOO=\n', b'CONFIG_FOO=y\n\0'):
+            with self.subTest(config=config), self.assertRaises(profile.ProfileError):
+                profile.extract_ikconfig(image(config))
+
+    def test_duplicate_manifest_keys_and_non_object_rejected(self):
+        with self.assertRaisesRegex(profile.ProfileError, 'duplicate'):
+            profile.json_bytes(b'{"schema":1,"schema":1}')
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'manifest.json'
+            body = b'[]'
+            path.write_bytes(body)
+            with self.assertRaises(profile.ProfileError):
+                profile.validate(path, profile.sha256(body), str(path))
+
+    def test_regular_files_only_and_fifo_cannot_block(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            regular = root / 'regular'
+            regular.write_bytes(b'ok')
+            self.assertEqual(profile.read_file(regular, 2), b'ok')
+            with self.assertRaises(profile.ProfileError):
+                profile.read_file(regular, 1)
+            if hasattr(os, 'mkfifo'):
+                fifo = root / 'fifo'
+                os.mkfifo(fifo)
+                with self.assertRaisesRegex(profile.ProfileError, 'regular'):
+                    profile.read_file(fifo, 1024)
+                link = root / 'link'
+                link.symlink_to(regular)
+                with self.assertRaisesRegex(profile.ProfileError, 'regular'):
+                    profile.read_file(link, 1024)
+
+
+class ActualCandidate(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        name = os.environ.get('UFLOW_KERNEL_PROFILE_MANIFEST')
+        if not name:
+            raise unittest.SkipTest('actual host profile not supplied; parser tests remain independent')
+        cls.path = Path(name)
+        cls.raw = cls.path.read_bytes()
+        cls.manifest = json.loads(cls.raw)
+        cls.image = cls.manifest['outputs']['Image']['path']
+
+    def check(self, value, selected=None, digest=None):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'manifest.json'
+            body = json.dumps(value).encode()
+            path.write_bytes(body)
+            return profile.validate(path, digest or profile.sha256(body), selected or self.image)
+
+    def test_real_candidate_full_closure_passes_without_runtime(self):
+        result = profile.validate(self.path, profile.sha256(self.raw), self.image)
+        self.assertEqual(result['status'], 'PASS_HOST_PROFILE_ONLY')
+        self.assertFalse(result['runtime_tested'])
+        self.assertFalse(result['authority_to_boot_or_replace_existing_Image'])
+
+    def test_wrong_manifest_hash_rejected(self):
+        with self.assertRaisesRegex(profile.ProfileError, 'manifest hash'):
+            self.check(self.manifest, digest='0' * 64)
+
+    def test_wrong_profile_version_kernel_and_runtime_claim_rejected(self):
+        for key, value in (('profile_id', 'other'), ('interface', 'v0'), ('kernel_commit', '0' * 40),
+                           ('schema', True), ('runtime_tested', True), ('authority_to_boot_or_replace_existing_Image', True)):
+            bad = copy.deepcopy(self.manifest)
+            bad[key] = value
+            with self.subTest(key=key), self.assertRaises(profile.ProfileError):
+                self.check(bad)
+
+    def test_wrong_selected_image_path_and_missing_file_rejected(self):
+        with self.assertRaisesRegex(profile.ProfileError, 'manifest member'):
+            self.check(self.manifest, selected=self.image + '.unbound')
+        bad = copy.deepcopy(self.manifest)
+        bad['outputs']['Image']['path'] = self.image + '.missing'
+        with self.assertRaisesRegex(profile.ProfileError, 'unavailable'):
+            self.check(bad, selected=bad['outputs']['Image']['path'])
+
+    def test_wrong_image_hash_rejected_even_with_rehashed_manifest(self):
+        bad = copy.deepcopy(self.manifest)
+        bad['outputs']['Image']['sha256'] = '0' * 64
+        with self.assertRaisesRegex(profile.ProfileError, 'hash mismatch'):
+            self.check(bad)
+
+    def test_actual_old_disabled_image_rejected(self):
+        old = Path(os.environ['UFLOW_KERNEL_PROFILE_OLD_IMAGE'])
+        self.assertEqual(profile.sha256(old.read_bytes()), profile.BASE_IMAGE)
+        config = profile.parse_config(profile.extract_ikconfig(old.read_bytes()))
+        self.assertEqual(config[profile.FLAG], 'n')
+        bad = copy.deepcopy(self.manifest)
+        bad['outputs']['Image'].update(path=str(old), bytes=old.stat().st_size, sha256=profile.BASE_IMAGE)
+        with self.assertRaisesRegex(profile.ProfileError, 'old disabled'):
+            self.check(bad, selected=str(old))
+
+    def test_missing_required_closure_and_config_delta_rejected(self):
+        bad = copy.deepcopy(self.manifest)
+        del bad['outputs']['obmm_export.o']
+        with self.assertRaisesRegex(profile.ProfileError, 'closure'):
+            self.check(bad)
+        bad = copy.deepcopy(self.manifest)
+        bad['resolved_config_diff']['CONFIG_ARM64_VA_BITS'] = {'before': '48', 'after': '52'}
+        with self.assertRaisesRegex(profile.ProfileError, 'delta'):
+            self.check(bad)
+
+    def test_public_cli_positive_and_wrong_external_pin(self):
+        argv = [sys.executable, '-B', str(SCRIPT), '--manifest', str(self.path), '--image', self.image,
+                '--manifest-sha256']
+        result = subprocess.run(argv + [profile.sha256(self.raw)], capture_output=True, text=True, timeout=30)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertEqual(json.loads(result.stdout)['status'], 'PASS_HOST_PROFILE_ONLY')
+        rejected = subprocess.run(argv + ['0' * 64], capture_output=True, text=True, timeout=10)
+        self.assertEqual(rejected.returncode, 2)
+        self.assertIn('producer manifest hash mismatch', rejected.stderr)
+
+
+class FixedLauncherInterface(unittest.TestCase):
+    def test_existing_group_takes_kernel_from_explicit_config_without_start(self):
+        name = os.environ.get('UFLOW_FIXED_GUEST_GROUP')
+        if not name:
+            self.skipTest('fixed deployed Guest group not supplied')
+        path = Path(name)
+        source = path.read_text()
+        tree = ast.parse(source)
+        function = next(node for node in tree.body if isinstance(node, ast.FunctionDef) and node.name == 'run')
+        argv = next(node.value for node in ast.walk(function) if isinstance(node, ast.Assign) and
+                    any(isinstance(target, ast.Name) and target.id == 'argv' for target in node.targets))
+        values = argv.elts
+        index = next(index for index, node in enumerate(values) if isinstance(node, ast.Constant) and node.value == '-kernel')
+        self.assertEqual(ast.dump(values[index + 1]), ast.dump(ast.parse("config['kernel']", mode='eval').body))
+        group_spec = importlib.util.spec_from_file_location('fixed_guest_group', path)
+        group = importlib.util.module_from_spec(group_spec)
+        group_spec.loader.exec_module(group)
+        with tempfile.TemporaryDirectory(prefix='kp-') as directory:
+            root = Path(directory)
+            output = root / 'runs/kp001'
+            output.mkdir(parents=True)
+            config = {'root': str(root), 'output': str(output), 'kernel': '/private/versioned/candidate/Image',
+                      'nodes': [{'id': node, 'memory_mib': 2048, 'vcpus': 2,
+                                 'boot_argv': ['-initrd', '/fixture/image']} for node in ('nodeA', 'nodeB')]}
+            previous = os.environ.get('UFLOW_ENV_CLOSE_FD')
+            os.environ['UFLOW_ENV_CLOSE_FD'] = '123456'
+            try:
+                self.assertEqual(group.validate(config), (root, output))
+            finally:
+                if previous is None:
+                    del os.environ['UFLOW_ENV_CLOSE_FD']
+                else:
+                    os.environ['UFLOW_ENV_CLOSE_FD'] = previous
+
+
+if __name__ == '__main__':
+    unittest.main()
