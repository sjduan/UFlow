++    *physical_page = 0;
++    if (!ummu || !udev || !ummu->ummu_devs || !tid || tid == UINT32_MAX ||
++        (iova & 0xfff)) {
++        return -EINVAL;
++    }
++    dev = g_hash_table_lookup(ummu->ummu_devs, udev);
++    if (!dev || dev->ummu != ummu || dev->udev != udev) {
++        return -ENODEV;
++    }
++    ret = ummu_decode_config_tid(dev, &cfg, &event, tid);
++    if (ret) {
++        return ret;
++    }
++    if (cfg.st_mode != TECTE_ST_MODE_S1) {
++        return -EACCES;
++    }
++    ummu_ptw(&cfg, iova, &entry, &ptw);
++    if (ptw.type != UMMU_PTW_ERR_NONE ||
++        entry.target_as != &address_space_memory ||
++        entry.addr_mask < 0xfff || entry.addr_mask == UINT64_MAX ||
++        (entry.addr_mask & (entry.addr_mask + 1)) ||
++        (iova & ~entry.addr_mask) != entry.iova ||
++        (entry.translated_addr & entry.addr_mask)) {
++        return -EFAULT;
++    }
++    *physical_page = entry.translated_addr | (iova & entry.addr_mask);
++    return 0;
+ }
