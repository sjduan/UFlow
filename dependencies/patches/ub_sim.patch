+#!/usr/bin/env python3
+"""Typed HOST-only CPU-QEMU domain-loss candidate, with no ledger authority."""
+import argparse
+import json
+import os
+from pathlib import Path
+
+from uflow_qemu_evidence import (CURRENT_ROOT, CURRENT_STATE_SHA, INTERFACE, QEMU_COMMIT,
+    KERNEL_COMMIT, FIXED, TRUTHS, EvidenceError, bound, canonical, check, decode,
+    digest, document, fixed_bindings, immutable_json, reviewed)
+from uflow_qemu_metadata import companion_audit
+import uflow_qemu_fixed_launch as fixed_launch
+
+SOURCE_PINS = {
+    'hw/ub/ub_ubc.c': 'cf803e8e898764002bea02307ff4f94d20320fac44226fa1b54c40f5154cf043',
+    'hw/ub/ub_link.c': 'de54a3e8a80e81fb52940e3dd4ecf66b38b40d6c18f5201631cce198b47f33cd',
+    'hw/core/machine.c': '9f8a1f482278c8eeed7f3f862f1bfa3bce063187fbfc5373c7a0e7b2140a6888',
+    'backends/hostmem-ram.c': 'a74c689f09fa4cba45ff3a5f4c2114c7055162697d385f888a726ea97477b767',
+    'system/physmem.c': 'fe8d9f15127f0a49e11417b98858facff336c7467cf220a963a682f13b7a78a6',
+    'drivers/ub/obmm/obmm_export_from_pool.c': '5703d9cb0d20664995c6d6abd397bbc96d205bb842745fbc6d7b158c4213c862',
+    'drivers/ub/obmm/obmm_export_from_user.c': '0fa3d4fe690aca660eda57d2fcdeee48b74d3ae4cd86be77a642ac04b05a7681',
+}
+IDS = [110, 111, 112]
+CAPACITIES = {110: 2 << 20, 111: 2 << 20, 112: 48 << 20}
+POOL = 'c5318ca4-ea66-4c54-99f0-63aa596860e6'
+EPOCH = '8c17edb8-a97f-4f1e-a851-cbc9ad5405cd'
+SESSION = '5da08f53-360f-419f-8929-0764be92d5d1'
+
+
+def source_graph(reference):
+    graph = document(reference, 'fixed-cpu-qemu-source-graph-v1')
+    check(graph['qemu_commit'] == QEMU_COMMIT and graph['kernel_commit'] == KERNEL_COMMIT, 'wrong source commits')
+    check(set(graph['files']) == set(SOURCE_PINS), 'complete fixed backing source closure missing')
+    for name, pin in SOURCE_PINS.items():
+        row = graph['files'][name]
+        check(row['sha256'] == pin, 'wrong fixed source: ' + name)
+        bound(row)
+    return graph
+
+
+def state_scope(reference, captured):
+    raw = bound(reference)
+    if captured:
+        check(reference['sha256'] == CURRENT_STATE_SHA, 'current c044 state changed')
+        check(reference['path'] == CURRENT_ROOT + '/runs/c044/state/state.json', 'snapshot replay is not current authority path')
+    state = decode(raw)
+    wanted = {'budget_bytes': 128 << 20, 'charged_bytes': 64 << 20, 'retained_bytes': 12 << 20,
+              'active_bytes': 52 << 20, 'creation_reserved_bytes': 64 << 20, 'active_reserved_bytes': 0}
+    check(all(state.get(key) == value for key, value in wanted.items()), 'conservative 128MiB responsibility changed')
+    ledger = state['resource_ledger']
+    resources = {row['object_id']: row for row in ledger['resources']}
+    check(len(resources) == len(ledger['resources']) and all(key in resources for key in IDS), 'resource identity set incomplete')
+    for key, size in CAPACITIES.items():
+        row = resources[key]
+        check(row['nbytes'] == size and row['retained'] is None and row['backing']['kind'] == 'provider' and
+              row['backing']['provider'] == 'mem_service_obmm' and row['backing']['realm'].startswith('simulated:'),
+              'eligible resource backing/size mismatch')
+    protected = [row for key, row in resources.items() if key not in IDS]
+    check(len(protected) == 6 and sum(row['nbytes'] for row in protected) == 12 << 20 and
+          all(row['retained'] is not None for row in protected), 'historical retained12 not protected')
+    check(ledger['reserved_bytes'] == 64 << 20 and len(ledger['retained_uncertain_reservations']) == 1,
+          'historical CreationUnknown64 not protected')
+    pools = state['pools'];check(len(pools) == 1, 'exact current pool required')
+    pool = pools[0]
+    check((pool['pool_id'], pool['pool_epoch'], pool['provider_session'], pool['resource_id'], pool['placement_id'],
+           pool['binding_id'], pool['resource_generation'], pool['nbytes']) ==
+          (POOL, EPOCH, SESSION, 112, 10002, 40002, 1, 48 << 20), 'pool/epoch/session/resource binding changed')
+    check(pool['release_result'] is None and len(pool['clients']) == 3 and
+          all(row['state'] == 'Mapped' for row in pool['clients']), 'original unresolved client obligations changed')
+    return state, pool, resources
+
+
+def argument_geometry(starts, bindings):
+    check(type(starts) is list and len(starts) == 2 and {row['node'] for row in starts} == {'nodeA', 'nodeB'},
+          'exact two historical QEMU owners required')
+    for row in starts:
+        argv = row['argv'];check(type(argv) is list and argv[0] == bindings['qemu_binary']['path'], 'wrong actual QEMU binary argv')
+        value_options = {'-M', '-cpu', '-m', '-smp', '-kernel', '-qmp', '-chardev', '-serial', '-initrd', '-append'}
+        bare_options = {'-nodefaults', '-nographic'}
+        options = {}; cursor = 1
+        while cursor < len(argv):
+            key = argv[cursor]
+            check(key in value_options | bare_options and key not in options, 'unknown/duplicate QEMU option')
+            if key in value_options:
+                check(cursor + 1 < len(argv), 'missing QEMU option value')
+                options[key] = argv[cursor + 1];cursor += 2
+            else:
+                options[key] = True;cursor += 1
+        check(set(options) == value_options | bare_options and options['-cpu'] == 'cortex-a57', 'incomplete fixed QEMU argv')
+        banned = ('-enable-kvm', '-accel', '-object', '-mem-path', '-incoming', '-snapshot', '-loadvm', '-savevm',
+                  '-drive', '-blockdev', '-device', '-monitor', '-readconfig', '-add-fd', '-numa')
+        check(not any(value in banned or 'vfio' in value or 'memory-backend=' in value or 'accel=kvm' in value
+                      for value in argv), 'external backing/migration/hardware argv rejected')
+        check(argv[argv.index('-kernel') + 1] == bindings['kernel_Image']['path'] and
+              argv[argv.index('-M') + 1] == 'virt,gic-version=3,its=on,ummu=on,ub-cluster-mode=on' and
+              argv[argv.index('-m') + 1] == '2048M' and argv[argv.index('-smp') + 1] == '2', 'wrong fixed CPU Guest geometry')
+        check('-initrd' in argv and '-nodefaults' in argv and '-nographic' in argv, 'historical boot argv incomplete')
+
+
+def admission(config_ref, monitor_ref, starts, root, captured):
+    config = document(config_ref);monitor = document(monitor_ref)
+    check(config['kind'] == 'guest' and config['root'] == root and config['job'] == 'c044' and
+          0 < config['run_seconds'] <= 1800, 'historical fixed E0 guest configuration missing')
+    argv = monitor['argv']
+    check('--actor' in argv and argv[-1] == config_ref.get('historical_path', config_ref['path']) and
+          any(value.endswith('/uflow_env_runner.py') for value in argv), 'actual E0 actor/config does not match history')
+    check(monitor['private_shm'] is False and monitor['memory_bytes'] <= 32 << 30 and
+          monitor['run_seconds'] == config['run_seconds'], 'wrong historical supervisor ABI')
+    check(all(row['birth'] >= monitor['launcher_birth'] for row in starts), 'QEMU owner predates E0 admission')
+    if captured:
+        check((monitor['launcher_pid'], monitor['launcher_birth']) == (1809156, 1323758632), 'wrong actual E0 FLOCK owner')
+    # In the independently pinned E0 source, kind=guest takes both heavy locks
+    # plus the execution flock before the actor can start either QEMU. This is
+    # source+executed-config+owner/child evidence, not caller exclusive_locks=3.
+    return {'owner_pid': monitor['launcher_pid'], 'owner_birth': monitor['launcher_birth'],
+            'source_bound_historical_FLOCKs': ['heavy-0.lock', 'heavy-1.lock', 'guest-execution.lock']}
+
+
+def runtime_closure(reference, starts, identities, bindings):
+    observations = document(reference, 'historical-cpu-qemu-runtime-v1')
+    rows = observations['owners']
+    check(len(rows) == 2 and {row['node'] for row in rows} == {'nodeA', 'nodeB'}, 'missing runtime owning context')
+    check(rows[0]['host_boot_id'] == rows[1]['host_boot_id'] and rows[0]['namespaces'] == rows[1]['namespaces'],
+          'owning contexts are not in the same historical host/container namespaces')
+    for start in starts:
+        row = next(value for value in rows if value['node'] == start['node'])
+        check((row['pid'], row['birth'], row['argv']) == (start['pid'], start['birth'], start['argv']), 'runtime argv/owner mismatch')
+        check(row['loaded_exe_sha256'] == FIXED['qemu_binary'] and row['uid'] == 0, 'loaded QEMU binary/uid not proved')
+        namespaces = row['namespaces']
+        check(set(namespaces) == {'pid', 'mnt', 'user'} and all(type(value) is int and value > 0 for value in namespaces.values())
+              and row['host_boot_id'], 'historical namespace/boot capture missing')
+        env = row['effective_environment']
+        check(env['UB_FM_NODE_ID'] == start['node'] and env['UB_FM_SHARED_DIR'] == observations['fm_root'] and
+              env['LD_PRELOAD'] is None and env['LD_AUDIT'] is None and env['QEMU_RAM_PATH'] is None,
+              'historical effective environment/backing escape')
+        capture = document(row['capture'], 'proc-qmp-cpu-capture-v1')
+        check((capture['pid'], capture['birth'], capture['namespaces'], capture['argv'], capture['exe_sha256'],
+               capture['effective_environment']) == (row['pid'], row['birth'], namespaces, start['argv'],
+                                                   FIXED['qemu_binary'], env), 'raw runtime capture mismatch')
+        check(capture['query_kvm']['return']['enabled'] is False and
+              capture['qom_backend_type']['return'] == 'memory-backend-ram', 'actual TCG/private RAM not proved')
+        memdev = capture['query_memdev']['return']
+        check(len(memdev) == 1 and memdev[0]['size'] == 2048 << 20 and memdev[0]['share'] is False and
+              not memdev[0].get('mem-path') and not memdev[0].get('fd'), 'file/memfd/shared RAM backend rejected')
+        maps = capture['ramblock_anonymous_maps']
+        ordered = sorted(maps, key=lambda item: item['start'])
+        check(all(left['end'] <= right['start'] for left, right in zip(ordered, ordered[1:])), 'overlapping duplicate RAM mappings')
+        check(maps and sum(item['end'] - item['start'] for item in maps) >= 2048 << 20 and
+              all(item['start'] < item['end'] and item['perms'] == 'rw-p' and item['inode'] == 0 and
+                  item['path'] is None for item in maps), 'RAMBlock/private-anonymous VMA closure missing')
+        controls = capture['lifecycle_commands']
+        check(controls and set(controls) <= {'qmp_capabilities', 'query-status', 'quit', 'system_powerdown',
+              'query-kvm', 'query-memdev', 'qom-get'} and not capture['other_management_endpoints'],
+              'migration/snapshot/save or unaccounted management context')
+        check(sum(item['node'] == start['node'] and item['boot_id'] == row['guest_boot_id'] for item in identities) == 1,
+              'Guest owner/boot ABI mismatch')
+    return observations
+
+
+def owner_backing_closure(backing_ref, owner_ref, starts, identities, pool, resources):
+    backing = document(backing_ref, 'cpu-qemu-backing-closure-v1')
+    owners = document(owner_ref, 'cpu-qemu-all-owners-v1')
+    expected = {row['node']: (row['pid'], row['birth']) for row in starts}
+    check(len(owners['qemu_owners']) == 2 and {row['node']: (row['pid'], row['birth']) for row in owners['qemu_owners']} == expected,
+          'incomplete or additional owning QEMU contexts')
+    check(not owners['external_native_owners'] and not backing['external_files_or_memfds'] and
+          not backing['migration_snapshot_save_targets'], 'external backing/owner escape not excluded')
+    check(len(owners['client_owners']) == len(pool['clients']) and
+          {row['client_session'] for row in owners['client_owners']} == {row['client_session'] for row in pool['clients']},
+          'all three Mapped client obligations must remain bound')
+    check(len(backing['resources']) == len(IDS) and {row['object_id'] for row in backing['resources']} == set(IDS), 'wrong eligible backing scope')
+    for row in backing['resources']:
+        check(row['nbytes'] == CAPACITIES[row['object_id']] and row['source'] in ('guest-kernel-pool', 'guest-user-pages') and
+              row['address_space'] == 'owning-QEMU-guest-physical' and set(row['nodes']) == {'nodeA', 'nodeB'},
+              'resource not closed over both owning Guest RAM contexts')
+        check(row['provider_session'] == SESSION and row['resource_identity'] == resources[row['object_id']]['backing'],
+              'provider resource/epoch/owner mismatch')
+    return {'owner_evidence_sha256': owner_ref['sha256'], 'backing_evidence_sha256': backing_ref['sha256']}
+
+
+def produce(plan_path, external_sha):
+    plan = reviewed(plan_path, external_sha)
+    check(plan.get('kind') == 'cpu-qemu-domain-request-v1', 'wrong domain request')
+    mode = plan['evidence_mode'];check(mode in ('captured-runtime', 'fixed-launch-source', 'synthetic-fixture'), 'explicit evidence mode required')
+    captured = mode == 'captured-runtime'
+    current_domain = mode != 'synthetic-fixture'
+    legacy = mode == 'fixed-launch-source' or (mode == 'synthetic-fixture' and plan.get('evidence_method') == 'fixed-launch-source')
+    check((plan['root'] == CURRENT_ROOT) == current_domain and plan['run'] == 'c044', 'fixture cannot impersonate current domain')
+    if current_domain:
+        check(plan['guest_starts']['path'] == CURRENT_ROOT + '/runs/c044/guest-starts.json' and
+              plan['guest_identities']['path'] == CURRENT_ROOT + '/runs/c044/guest-identities.json' and
+              plan['historical_guest_config']['path'] == CURRENT_ROOT + '/implementation/config-c044-prestart-v1/guest.json' and
+              plan['historical_monitor_config']['path'] == CURRENT_ROOT + '/runs/c044/monitor/config.json',
+              'historical current-domain evidence path mismatch')
+    missing, facts = [], {}
+    def assess(name, function):
+        try:
+            facts[name] = function()
+            return facts[name]
+        except (EvidenceError, KeyError, ValueError, TypeError, IndexError, OSError) as error:
+            missing.append({'evidence': name, 'reason': str(error)[:500]})
+            return None
+    assess('fixed_source_and_binaries', lambda: (fixed_bindings(plan['fixed_bindings']), source_graph(plan['source_graph']))[1])
+    scope = assess('state_and_scope', lambda: state_scope(plan['state'], current_domain))
+    starts = assess('actual_historical_argv', lambda: decode(bound(plan['guest_starts'])))
+    identities = assess('actual_Guest_identities', lambda: decode(bound(plan['guest_identities'])))
+    if starts is not None:
+        assess('CPU_only_argument_geometry', lambda: argument_geometry(starts, plan['fixed_bindings']))
+        assess('historical_E0_three_FLOCK_admission', lambda: admission(plan['historical_guest_config'],
+               plan['historical_monitor_config'], starts, CURRENT_ROOT if legacy else plan['root'], current_domain))
+    if starts is not None and identities is not None:
+        if legacy:
+            if scope is not None:
+                assess('fixed_launch_source_environment_backing_and_owners', lambda: fixed_launch.validate(
+                    plan['fixed_launch'], plan, starts, identities, scope[0], scope[1], scope[2]))
+        else:
+            assess('actual_effective_environment_RAM_and_management', lambda: runtime_closure(plan['runtime_observations'], starts, identities, plan['fixed_bindings']))
+            if scope is not None:
+                assess('complete_backing_and_all_owners', lambda: owner_backing_closure(plan['backing_observations'],
+                       plan['owner_observations'], starts, identities, scope[1], scope[2]))
+    physical = assess('fresh_exact_physical_closure', lambda: companion_audit(plan['companion_plan']['path'],
+                    plan['companion_plan']['sha256']))
+    if current_domain and physical is not None:
+        def current_union():
+            check(physical['original_carriers'] == 50 and physical['validated_dynamic_metadata'] == 1 and
+                  physical['exact_union_files'] == 51 and all(Path(row['path']).is_relative_to(Path(CURRENT_ROOT) / 'runs')
+                  for row in physical['files']), 'fixture/subset is not the original c044 carrier union')
+        assess('current_domain_full_carrier_scope', current_union)
+    check(all(value is False for key, value in TRUTHS.items() if key != 'unknown_client_and_operation_history_preserved'), 'internal authority invariant')
+    summary = None if physical is None else {key: physical[key] for key in ('exact_union_files', 'registry_head_sha256',
+              'original_manifest_sha256', 'frozen_helper_sha256', 'all_named_births_gone', 'controls_kernel_inactive')}
+    status = 'INCOMPLETE' if missing else 'PASS_HOST_CANDIDATE_ONLY'
+    # A fixture exercises the entire predicate but can never assert current
+    # domain eligibility, regardless of the state/resource numbers it uses.
+    current = current_domain and not missing
+    result = {'schema': 1, 'interface': INTERFACE, 'kind': 'terminal-cpu-domain-loss-host-candidate-v1',
+        'status': status, 'evidence_mode': mode, 'root': plan['root'], 'run': 'c044',
+        'evidence_method': 'fixed-launch-source' if legacy else 'captured-runtime',
+        'source_derived_inference': legacy, 'historical_proc_or_QMP_capture_claimed': captured,
+        'fixed_launch_proof': facts.get('fixed_launch_source_environment_backing_and_owners') if legacy else None,
+        'evidence_manifest_path': str(plan_path), 'evidence_manifest_sha256': external_sha,
+        'state_sha256': plan['state']['sha256'], 'only_eligible_resource_ids': IDS,
+        'candidate_scope_capacity_bytes': 52 << 20, 'current_eligible_capacity_bytes': (52 << 20) if current else 0,
+        'applies_to_current_domain': current, 'missing_evidence': missing, 'physical_closure': summary,
+        'protected_historical_retained_bytes': 12 << 20, 'protected_historical_reserved_bytes': 64 << 20,
+        'B_total_before_or_after_this_tool': 128 << 20, 'A_historical_unqueried_bytes': 128 << 20,
+        'normal_history_state_transition_performed': False, **TRUTHS}
+    result['evidence_recovery_limits'] = [
+        'Historical loaded executable, namespaces, effective environment, actual private RAM backend, RAMBlock mappings and management captures must be independently reviewed for both original PID/birth contexts.',
+        'All three client owners and all three eligible resources need source-bound backing and complete owning-domain observations; absence of file FD/VMA holders alone does not prove this.',
+        'Original owners are dead; do not fabricate historical captures from current source defaults or restart the old Guest. Missing historical evidence remains INCOMPLETE unless independently recovered.',
+    ] if missing else []
+    result['candidate_id'] = digest(canonical(result))
+    return result
+
+
+def validate_candidate(path, external_sha, *, for_current_domain=True):
+    candidate = document({'path': str(path), 'bytes': Path(path).stat().st_size, 'sha256': external_sha})
+    check(candidate.get('interface') == INTERFACE and candidate.get('status') == 'PASS_HOST_CANDIDATE_ONLY', 'incomplete/wrong candidate rejected')
+    check(all(candidate.get(key) is value for key, value in TRUTHS.items()), 'candidate has ledger/native authority claims')
+    if for_current_domain:
+        check(candidate['evidence_mode'] in ('captured-runtime', 'fixed-launch-source') and candidate['applies_to_current_domain'] and
+              candidate['root'] == CURRENT_ROOT and candidate['state_sha256'] == CURRENT_STATE_SHA, 'fixture or replay is not current-domain evidence')
+    fresh = produce(candidate['evidence_manifest_path'], candidate['evidence_manifest_sha256'])
+    check(fresh == candidate, 'candidate replay/state/source/registry/closure changed')
+    return candidate
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--manifest', required=True)
+    parser.add_argument('--manifest-sha256', required=True)
+    parser.add_argument('--output', required=True)
+    args = parser.parse_args()
+    try:
+        result = produce(args.manifest, args.manifest_sha256)
+        immutable_json(args.output, result)
+    except (EvidenceError, OSError, KeyError, ValueError, TypeError) as error:
+        parser.exit(2, 'REJECT_DOMAIN_EVIDENCE: ' + str(error) + '\n')
+    print(json.dumps({'status': result['status'], 'candidate_id': result['candidate_id'],
+                      'authority_to_mutate_ledger': False, 'missing_evidence': result['missing_evidence']}))
+    if result['status'] == 'INCOMPLETE':
+        raise SystemExit(3)
+
+
+if __name__ == '__main__':
+    main()
