+"""Actual private profile validation and tampered-reference rejection on HOST."""
+import copy
+import hashlib
+import json
+import os
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'scripts'))
+from uflow_qemu_profile import validate
+from uflow_qemu_evidence import EvidenceError
+
+
+class ActualProfile(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.path=Path(os.environ['UFLOW_PRIVATE_QEMU_PROFILE'])
+        cls.manifest=json.loads(cls.path.read_bytes())
+        cls.sha=hashlib.sha256(cls.path.read_bytes()).hexdigest()
+        cls.root=Path(os.environ['UFLOW_PRIVATE_QEMU_TEST_ROOT']);cls.root.mkdir()
+        cls.binary=cls.manifest['qemu_binary']['path']
+
+    def tampered(self,change):
+        with tempfile.TemporaryDirectory(dir=self.root) as directory:
+            root=Path(directory);m=copy.deepcopy(self.manifest);change(m,root)
+            p=root/'manifest.json';p.write_bytes(json.dumps(m).encode())
+            with self.assertRaises((EvidenceError,KeyError)):
+                validate(p,hashlib.sha256(p.read_bytes()).hexdigest(),self.binary)
+
+    def test_actual_source_object_control_and_candidate_closure(self):
+        result=validate(self.path,self.sha,self.binary)
+        self.assertEqual(result['status'],'PASS_HOST_QEMU_PROFILE_ONLY')
+        self.assertFalse(result['runtime_tested'])
+        self.assertFalse(result['authority_to_boot_or_replace_existing_binary'])
+        self.assertGreater(result['reused_inputs_verified'],1000)
+
+    def test_external_manifest_pin_is_required(self):
+        with self.assertRaisesRegex(EvidenceError,'external manifest'):
+            validate(self.path,'0'*64,self.binary)
+
+    def test_old_runtime_cannot_be_selected(self):
+        with self.assertRaisesRegex(EvidenceError,'selected executable'):
+            validate(self.path,self.sha,self.manifest['original_binary']['path'])
+
+    def test_changed_source_hash_rejected(self):
+        self.tampered(lambda m,r:m['sources']['hw/ub/ub_ummu.c']['candidate'].update(sha256='0'*64))
+
+    def test_claimed_runtime_test_is_not_a_host_profile(self):
+        self.tampered(lambda m,r:m.update(runtime_tested=True))
+
+    def test_wrong_control_binary_rejected(self):
+        self.tampered(lambda m,r:m['baseline_binary'].update(sha256=m['qemu_binary']['sha256']))
+
+    def test_unreviewed_link_flag_change_rejected(self):
+        def change(m,root):
+            row=m['candidate_command'];v=json.loads(Path(row['path']).read_bytes());v['argv'].append('-s')
+            p=root/'candidate-command.json';p.write_bytes(json.dumps(v).encode())
+            m['candidate_command']={'path':str(p),'bytes':p.stat().st_size,'sha256':hashlib.sha256(p.read_bytes()).hexdigest()}
+        self.tampered(change)
+
+    def test_omitted_thin_archive_member_cannot_be_hidden(self):
+        def change(m,root):
+            values=json.loads(Path(m['reused_input_identities']['path']).read_bytes())
+            thin=json.loads(Path(m['thin_archive_members']['path']).read_bytes())
+            archive,names=next(iter(thin.items()));member=Path(names[0])
+            if not member.is_absolute():member=Path(archive).parent/member
+            values.pop(str(member.resolve()))
+            p=root/'reused.json';p.write_bytes(json.dumps(values).encode())
+            m['reused_input_identities']={'path':str(p),'bytes':p.stat().st_size,'sha256':hashlib.sha256(p.read_bytes()).hexdigest()}
+        self.tampered(change)
+
+
+if __name__=='__main__':unittest.main()
