--- /dev/null
+++ b/guest-linux/aarch64/scripts/uflow_gsva_scatter_host.py
@@ -0,0 +1,62 @@
+#!/usr/bin/env python3
+"""Compile real candidate translation functions in bounded synthetic HOST tests."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+
+from uflow_c064_platform import extract_function
+from uflow_qemu_evidence import check,decode,digest,immutable_json,read
+
+
+def run(profile_path,external_sha,base,candidate,fixture,output,*,sanitizers=('address','undefined')):
+    body,_=read(profile_path,128<<10);check(digest(body)==external_sha,'external candidate profile hash mismatch')
+    profile=decode(body)
+    check(profile['interface']=='mem-service-gsva-scatter-source-v1' and profile['profile_id']=='gsva-scatter-home-v1' and
+          profile['runtime_tested'] is False and profile['authority_to_replace_runtime'] is False,'source-only candidate profile required')
+    base,candidate,output=Path(base),Path(candidate),Path(output);output.mkdir()
+    for name,row in profile['files'].items():
+        before,_=read(base/name,2<<20);after,_=read(candidate/name,2<<20)
+        check(digest(before)==row['base_sha256'] and digest(after)==row['candidate_sha256'],'source profile member mismatch')
+    ummu=(candidate/'hw/ub/ub_ummu.c').read_text();ubc=(candidate/'hw/ub/ub_ubc.c').read_text()
+    functions=[extract_function(ummu,'ummu_dma_s1_translate_page'),extract_function(ubc,'gsva_arm_mmu_translate_full')]
+    check('g_dma_tid_override' not in functions[0] and 'ummu_decode_config_tid' in functions[0], 'new CPU translation must use explicit local TID')
+    template=Path(fixture).read_text();marker='/* INSERT_VERIFIED_PRODUCTION_FUNCTIONS */'
+    check(template.count(marker)==1,'synthetic HOST harness insertion marker missing')
+    generated=template.replace(marker,'\n'.join(functions));source=output/'production-functions-test.c';source.write_bytes(generated.encode())
+    compiler=shutil.which('gcc');check(compiler is not None,'existing native HOST GCC required')
+    check(set(sanitizers)<= {'address','undefined'},'unsupported sanitizer selection')
+    argv=[compiler,'-std=gnu11','-O2','-g','-Wall','-Wextra','-Werror','-fno-omit-frame-pointer','-fstack-protector-strong']
+    if sanitizers:argv.append('-fsanitize='+','.join(sanitizers))
+    argv+=['-o',str(output/'sg-host-test'),str(source)]
+    env=dict(os.environ,ASAN_OPTIONS='detect_leaks=1:abort_on_error=1',UBSAN_OPTIONS='halt_on_error=1:print_stacktrace=1')
+    built=subprocess.run(argv,capture_output=True,timeout=60,env=env)
+    for name,data in [('compile.stdout',built.stdout),('compile.stderr',built.stderr)]:
+        with (output/name).open('xb') as f:f.write(data)
+    check(built.returncode==0,'synthetic production-function HOST compilation failed; original diagnostics retained')
+    tested=subprocess.run([str(output/'sg-host-test')],capture_output=True,timeout=30,env=env)
+    for name,data in [('test.stdout',tested.stdout),('test.stderr',tested.stderr)]:
+        with (output/name).open('xb') as f:f.write(data)
+    check(tested.returncode==0 and b'HOST_SYNTHETIC_SG_ALL_PASS' in tested.stdout,'HOST mapping unit test failed; original diagnostics retained')
+    report={'schema':1,'status':'PASS_HOST_SYNTHETIC_MAPPING_UNITS','profile_sha256':external_sha,'compiler_argv':argv,
+            'production_function_sha256':[digest(function.encode()) for function in functions],
+            'production_source_sha256':{name:row['candidate_sha256'] for name,row in profile['files'].items()},
+            'sanitizers':list(sanitizers),'actual_functions_compiled':2,
+            'synthetic_cases':tested.stdout.decode().splitlines(),'runtime_tested':False,
+            'new_Guest_or_QEMU_process':False,'live_memory_or_kernel_access':False,'authority_to_replace_runtime':False}
+    immutable_json(output/'result.json',report);return report
+
+
+def main():
+    p=argparse.ArgumentParser(description=__doc__)
+    for name in ('profile','profile-sha256','base','candidate','fixture','output'):p.add_argument('--'+name,required=True)
+    p.add_argument('--sanitizers',default='address,undefined',choices=['address,undefined','none'])
+    args=p.parse_args();report=run(args.profile,args.profile_sha256,args.base,args.candidate,args.fixture,args.output,
+                                 sanitizers=() if args.sanitizers=='none' else ('address','undefined'))
+    print(json.dumps({'status':report['status'],'actual_functions_compiled':2,'cases':len(report['synthetic_cases'])}))
+
+
+if __name__=='__main__':main()
diff --git a/guest-linux/aarch64/scripts/uflow_guest_audit.py b/guest-linux/aarch64/scripts/uflow_guest_audit.py
new file mode 100755
index 0000000000000000000000000000000000000000..5065a001334a1524ef60b3e4001bbfbb00976032
--- /dev/null
+++ b/guest-linux/aarch64/scripts/uflow_guest_audit.py
@@ -0,0 +1,187 @@
+#!/usr/bin/env python3
+"""Audit exact exited Guest identities and their registered FM files/endpoints.
+
+FM files are retained with their actual disk charge. Only proven original stale
+control sockets are unlinked. No allocation lifecycle or lower ACK is inferred.
+"""
+import argparse
+import ctypes
+import fcntl
+import json
+import mmap
+import os
+from pathlib import Path
+import stat
+import time
+
+
+def identity(pid):
+    try:
+        path = Path('/proc', str(pid))
+        return int((path / 'stat').read_text().rpartition(')')[2].split()[19])
+    except (FileNotFoundError, ProcessLookupError):
+        return None
+
+
+def file_identity_aliases(path, expected):
+    """Bind overlay stat identity to its kernel VMA identity without reading data."""
+    canonical = (expected['dev'], expected['inode'])
+    if expected['file_type'] != stat.S_IFREG:
+        return [list(canonical)]
+    fd = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
+    libc = ctypes.CDLL(None, use_errno=True)
+    libc.mmap.argtypes = (ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_longlong)
+    libc.mmap.restype = ctypes.c_void_p
+    libc.munmap.argtypes = (ctypes.c_void_p, ctypes.c_size_t)
+    libc.munmap.restype = ctypes.c_int
+    address = None
+    try:
+        info = os.fstat(fd)
+        if (info.st_dev, info.st_ino, info.st_uid) != (*canonical, expected['uid']):
+            raise RuntimeError('FM pin identity drift')
+        # mmap is lazy and read-only. No byte is dereferenced, including for
+        # zero-length metadata files, whose access would otherwise SIGBUS.
+        address = libc.mmap(None, 4096, mmap.PROT_READ, mmap.MAP_SHARED, fd, 0)
+        if address == ctypes.c_void_p(-1).value:
+            address = None
+            raise OSError(ctypes.get_errno(), 'readonly FM identity mmap')
+        backing = None
+        for line in Path('/proc/self/maps').read_text().splitlines():
+            fields = line.split(maxsplit=5)
+            start, end = (int(x, 16) for x in fields[0].split('-'))
+            if start <= address < end:
+                major, minor = (int(x, 16) for x in fields[3].split(':'))
+                backing = (os.makedev(major, minor), int(fields[4]))
+                break
+        if backing is None or not backing[1]:
+            raise RuntimeError('kernel VMA identity not observable')
+        after = Path(path).lstat()
+        if (after.st_dev, after.st_ino, after.st_uid) != (*canonical, expected['uid']):
+            raise RuntimeError('FM pathname changed during identity pin')
+        return [list(value) for value in sorted({canonical, backing})]
+    finally:
+        unmap_error = None
+        if address is not None and libc.munmap(address, 4096) != 0:
+            unmap_error = OSError(ctypes.get_errno(), 'readonly FM identity munmap')
+        os.close(fd)
+        if unmap_error is not None:
+            raise unmap_error
+
+
+def holders(inodes):
+    deadline = time.monotonic() + 15
+    matches, denied, processes, descriptors = [], [], 0, 0
+    for process in Path('/proc').iterdir():
+        if not process.name.isdigit():
+            continue
+        processes += 1
+        if processes > 6000 or time.monotonic() >= deadline:
+            raise RuntimeError('exact-inode holder audit exceeded process/time bound')
+        pid = int(process.name)
+        born = identity(pid)
+        try:
+            with os.scandir(process / 'fd') as stream:
+                for entry in stream:
+                    descriptors += 1
+                    if descriptors > 1000000 or time.monotonic() >= deadline:
+                        raise RuntimeError('exact-inode FD audit bound exceeded')
+                    try:
+                        info = entry.stat()
+                        if (info.st_dev, info.st_ino) in inodes:
+                            matches.append({'pid': pid, 'birth': born, 'kind': 'FD', 'fd': entry.name})
+                    except (FileNotFoundError, ProcessLookupError):
+                        pass
+            with (process / 'maps').open() as stream:
+                for line in stream:
+                    fields = line.split(maxsplit=5)
+                    if len(fields) < 5:
+                        continue
+                    major, minor = (int(x, 16) for x in fields[3].split(':'))
+                    if (os.makedev(major, minor), int(fields[4])) in inodes:
+                        matches.append({'pid': pid, 'birth': born, 'kind': 'VMA'})
+        except (FileNotFoundError, ProcessLookupError):
+            continue
+        except PermissionError:
+            denied.append({'pid': pid, 'birth': born})
+    return {'holders': matches, 'denied': denied, 'processes_observed': processes, 'FD_entries_observed': descriptors,
+            'elapsed_deadline_seconds': 15, 'no_other_process_commands_or_environment_read': True}
+
+
+def audit(root, job):
+    root = root.resolve()
+    if not root.is_dir() or root.stat().st_uid != os.geteuid() or not job or any(c not in 'abcdefghijklmnopqrstuvwxyz0123456789-_' for c in job):
+        raise ValueError('literal same-UID task identity required')
+    output = root / 'runs' / job
+    result = json.loads((output / 'result.json').read_bytes())['processes']
+    if not result['process_tree_empty'] or not result['task_resources_closed']:
+        raise RuntimeError('unresolved task process boundary; retain all resources')
+    alive = {pid: born for pid, born in result['owned_births'].items() if identity(pid) == born}
+    if alive:
+        raise RuntimeError('original owned process still alive; retain all resources')
+    files = json.loads((output / 'fm-carrier-active.json').read_bytes())['files']
+    endpoints = json.loads((output / 'control-endpoints-active.json').read_bytes())
+    inodes = set()
+    file_states = []
+    for row in files:
+        path = Path(row['path'])
+        if not path.is_relative_to(output / 'fm'):
+            raise RuntimeError('FM source outside exact job')
+        aliases = row.get('kernel_inode_aliases')
+        if not aliases or [row['dev'], row['inode']] not in aliases:
+            raise RuntimeError('missing kernel-pinned FM inode aliases; retain')
+        inodes.update(tuple(alias) for alias in aliases)
+        try:
+            info = path.lstat()
+        except FileNotFoundError:
+            file_states.append({**row, 'state': 'already-absent', 'retained_actual_blocks_bytes': 0})
+            continue
+        if stat.S_IFMT(info.st_mode) != row['file_type'] or (info.st_dev, info.st_ino, info.st_uid) != (row['dev'], row['inode'], os.geteuid()):
+            raise RuntimeError('FM identity drift; retain')
+        file_states.append({**row, 'state': 'retained-closed-file', 'retained_actual_blocks_bytes': info.st_blocks * 512})
+    registered = {x['path'] for x in files}
+    for path in (output / 'fm').rglob('*'):
+        info = path.lstat()
+        if not stat.S_ISDIR(info.st_mode) and str(path) not in registered:
+            raise RuntimeError('unregistered FM file remains; retain and reconcile')
+    observed = holders(inodes)
+    if observed['holders'] or observed['denied']:
+        raise RuntimeError('FM holder audit inconclusive; retain all resources')
+    live_unix = {line.split()[-1] for line in Path('/proc/net/unix').read_text().splitlines()[1:] if len(line.split()) >= 8}
+    if any(row['path'] in live_unix for row in files if row['file_type'] == stat.S_IFSOCK):
+        raise RuntimeError('FM socket is still kernel-active; retain')
+    removed = []
+    for row in endpoints:
+        path = Path(row['path'])
+        if path.parent != output or str(path) in live_unix:
+            raise RuntimeError('control endpoint still active or outside job; retain')
+        if not path.exists():
+            continue
+        info = path.lstat()
+        if not stat.S_ISSOCK(info.st_mode) or (info.st_dev, info.st_ino, info.st_uid) != (row['dev'], row['inode'], row['uid']):
+            raise RuntimeError('control endpoint identity drift; retain')
+        path.unlink()
+        removed.append(row)
+    lock_path = root / 'coordination/guest-execution.lock'
+    with lock_path.open('a+') as lock:
+        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        fcntl.flock(lock, fcntl.LOCK_UN)
+    value = {'status': 'original-processes-FDs-and-control-sockets-closed', 'original_births_gone': True,
+             'holder_audit': observed, 'control_sockets_removed': removed, 'Guest_execution_lock_reacquired_and_released': True,
+             'FM_files': file_states, 'FM_retained_actual_blocks_bytes': sum(x['retained_actual_blocks_bytes'] for x in file_states),
+             'shared_FM_unlinked': False, 'logical_allocation_ACK_inferred': False}
+    with (output / 'post-close-audit.json').open('x') as stream:
+        json.dump(value, stream, indent=2)
+    print(json.dumps({'job': job, 'status': value['status'], 'FM_registered_files': len(files),
+                      'FM_files_retained': sum(x['state'] == 'retained-closed-file' for x in file_states)}))
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('root', type=Path)
+    parser.add_argument('job')
+    args = parser.parse_args()
+    audit(args.root, args.job)
+
+
+if __name__ == '__main__':
+    main()
