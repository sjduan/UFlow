diff --git a/guest-linux/aarch64/patches/managed-lease-cache-v1/files/include/hw/ub/uflow_managed_cache_core.h b/guest-linux/aarch64/patches/managed-lease-cache-v1/files/include/hw/ub/uflow_managed_cache_core.h
new file mode 100644
index 0000000000000000000000000000000000000000..591f9f38ca442978cf648935c86458ea9cc08af8
--- /dev/null
+++ b/guest-linux/aarch64/patches/managed-lease-cache-v1/files/include/hw/ub/uflow_managed_cache_core.h
@@ -0,0 +1,226 @@
+/* UFlow Catalog-managed read grants. Caller serializes state under the BQL.
+ * Transport/native permission validation is supplied by the real GSVA wrapper.
+ * Cache data is never authority; fills always use strict Guest remote I/O.
+ */
+#ifndef UFLOW_MANAGED_CACHE_CORE_H
+#define UFLOW_MANAGED_CACHE_CORE_H
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define UFLOW_MC_PAGE 4096u
+#define UFLOW_MC_SLOTS 2048u
+#define UFLOW_MC_HISTORY 512u
+enum { UFLOW_MC_OK = 0, UFLOW_MC_MISS = 1, UFLOW_MC_BUSY = 2,
+       UFLOW_MC_DENIED = 3, UFLOW_MC_REPLAY = 4, UFLOW_MC_FULL = 5 };
+
+typedef struct UFlowMcPage {
+    uint64_t start;
+    uint32_t length;
+    bool valid;
+    uint8_t bytes[UFLOW_MC_PAGE];
+} UFlowMcPage;
+
+typedef struct UFlowMcCounters {
+    uint64_t reads, hits, fills, remote_bytes, successful_bytes, evictions, invalidations;
+    uint64_t late_discards, remote_failures;
+    bool saturated;
+} UFlowMcCounters;
+
+typedef struct UFlowManagedCache {
+    bool active, revoking;
+    uint64_t epoch, generation, offset, length;
+    uint32_t in_flight, pages, used;
+    uint8_t id[32], operation[32];
+    uint64_t generations[UFLOW_MC_HISTORY];
+    uint8_t closed_ids[UFLOW_MC_HISTORY][32];
+    uint8_t operations[UFLOW_MC_HISTORY][32];
+    UFlowMcCounters counters;
+    UFlowMcPage *slots;
+} UFlowManagedCache;
+
+typedef int (*UFlowMcFetch)(void *opaque, uint64_t offset,
+                            uint8_t *bytes, uint32_t length);
+typedef bool (*UFlowMcNativeValid)(void *opaque);
+
+static inline void uflow_mc_count(UFlowManagedCache *m, uint64_t *v,
+                                  uint64_t amount)
+{
+    if (amount > UINT64_MAX - *v) {
+        *v = UINT64_MAX;
+        m->counters.saturated = true;
+    } else {
+        *v += amount;
+    }
+}
+
+static inline void uflow_mc_invalidate(UFlowManagedCache *m)
+{
+    if (!m || !m->active) {
+        return;
+    }
+    if (m->epoch == UINT64_MAX) {
+        m->revoking = true;
+    } else {
+        m->epoch++;
+    }
+    for (uint32_t i = 0; m->slots && i < UFLOW_MC_SLOTS; i++) {
+        m->slots[i].valid = false;
+    }
+    m->pages = 0;
+    uflow_mc_count(m, &m->counters.invalidations, 1);
+}
+
+static inline int uflow_mc_begin(UFlowManagedCache *m, uint64_t generation,
+                                 const uint8_t id[32], const uint8_t operation[32],
+                                 uint64_t offset, uint64_t length)
+{
+    if (!m || !generation || !length || length > UINT64_MAX - offset) {
+        return UFLOW_MC_DENIED;
+    }
+    if (m->active || m->in_flight) {
+        return UFLOW_MC_BUSY;
+    }
+    for (uint32_t i = 0; i < m->used; i++) {
+        if (m->generations[i] == generation ||
+            !memcmp(m->closed_ids[i], id, 32) ||
+            !memcmp(m->operations[i], operation, 32)) {
+            return UFLOW_MC_REPLAY;
+        }
+    }
+    if (m->used == UFLOW_MC_HISTORY || m->epoch == UINT64_MAX) {
+        return UFLOW_MC_FULL;
+    }
+    if (!m->slots) {
+        m->slots = calloc(UFLOW_MC_SLOTS, sizeof(*m->slots));
+        if (!m->slots) {
+            return UFLOW_MC_FULL;
+        }
+    }
+    m->active = true;
+    m->revoking = false;
+    m->generation = generation;
+    m->offset = offset;
+    m->length = length;
+    memcpy(m->id, id, 32);
+    memcpy(m->operation, operation, 32);
+    memset(&m->counters, 0, sizeof(m->counters));
+    uflow_mc_invalidate(m);
+    return UFLOW_MC_OK;
+}
+
+static inline bool uflow_mc_overlap(const UFlowManagedCache *m,
+                                    uint64_t offset, uint64_t length)
+{
+    return m && m->active && length && length <= UINT64_MAX - offset &&
+        offset < m->offset + m->length && m->offset < offset + length;
+}
+
+static inline int uflow_mc_end(UFlowManagedCache *m, uint64_t generation,
+                               const uint8_t id[32])
+{
+    if (!m || !generation) {
+        return UFLOW_MC_DENIED;
+    }
+    if (!m->active) {
+        for (uint32_t i = 0; i < m->used; i++) {
+            if (m->generations[i] == generation &&
+                !memcmp(m->closed_ids[i], id, 32)) {
+                return UFLOW_MC_OK;
+            }
+        }
+        return UFLOW_MC_DENIED;
+    }
+    if (m->generation != generation || memcmp(m->id, id, 32)) {
+        return UFLOW_MC_DENIED;
+    }
+    m->revoking = true;
+    uflow_mc_invalidate(m);
+    if (m->in_flight) {
+        return UFLOW_MC_BUSY;
+    }
+    /* Begin reserved one replay-history slot; no new begin can race an end. */
+    m->generations[m->used] = generation;
+    memcpy(m->closed_ids[m->used], m->id, 32);
+    memcpy(m->operations[m->used], m->operation, 32);
+    m->used++;
+    m->active = false;
+    return UFLOW_MC_OK;
+}
+
+static inline int uflow_mc_read(UFlowManagedCache *m, uint64_t offset,
+                                uint8_t *out, uint32_t length,
+                                UFlowMcFetch fetch, UFlowMcNativeValid valid,
+                                void *opaque)
+{
+    uint32_t done = 0;
+    if (!m || !m->active || !length || offset < m->offset ||
+        offset - m->offset > m->length ||
+        length > m->length - (offset - m->offset)) {
+        return UFLOW_MC_MISS;
+    }
+    if (m->revoking || m->in_flight || !out || !fetch || !valid ||
+        !valid(opaque)) {
+        return UFLOW_MC_DENIED;
+    }
+    uflow_mc_count(m, &m->counters.reads, 1);
+    while (done < length) {
+        uint64_t at = offset + done;
+        uint64_t base = at - at % UFLOW_MC_PAGE;
+        uint64_t start = base > m->offset ? base : m->offset;
+        uint64_t end = m->offset + m->length;
+        uint32_t amount;
+        UFlowMcPage *page;
+        if (UINT64_MAX - base >= UFLOW_MC_PAGE &&
+            end > base + UFLOW_MC_PAGE) {
+            end = base + UFLOW_MC_PAGE;
+        }
+        amount = end - at < length - done ? end - at : length - done;
+        page = &m->slots[(base / UFLOW_MC_PAGE) % UFLOW_MC_SLOTS];
+        if (!page->valid || page->start != start ||
+            page->length != end - start) {
+            uint8_t bytes[UFLOW_MC_PAGE];
+            uint64_t epoch = m->epoch;
+            int result;
+            m->in_flight++;
+            uflow_mc_count(m, &m->counters.fills, 1);
+            uflow_mc_count(m, &m->counters.remote_bytes, end - start);
+            result = fetch(opaque, start, bytes, end - start);
+            m->in_flight--;
+            if (result != 0) {
+                uflow_mc_count(m, &m->counters.remote_failures, 1);
+                return UFLOW_MC_DENIED;
+            }
+            uflow_mc_count(m, &m->counters.successful_bytes, end - start);
+            if (!m->active || m->revoking || m->epoch != epoch ||
+                !valid(opaque)) {
+                uflow_mc_count(m, &m->counters.late_discards, 1);
+                return UFLOW_MC_DENIED;
+            }
+            if (page->valid) {
+                uflow_mc_count(m, &m->counters.evictions, 1);
+            } else {
+                m->pages++;
+            }
+            page->start = start;
+            page->length = end - start;
+            memcpy(page->bytes, bytes, page->length);
+            page->valid = true;
+        } else {
+            uflow_mc_count(m, &m->counters.hits, 1);
+        }
+        memcpy(out + done, page->bytes + at - start, amount);
+        done += amount;
+    }
+    return UFLOW_MC_OK;
+}
+
+static inline void uflow_mc_destroy(UFlowManagedCache *m)
+{
+    if (m) {
+        free(m->slots);
+        memset(m, 0, sizeof(*m));
+    }
+}
+#endif
