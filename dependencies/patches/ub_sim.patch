+def _case(path, pin, fixture=False):
+    c = reviewed(path, pin, 'HOST-fixture-case-v2' if fixture else 'captured-runtime-case-v2')
+    check(c['evidence_mode'] == ('HOST-fixture-only' if fixture else 'captured-runtime'), 'fixture/production separation')
+    run = _run_root(c['run_path'], fixture)
+    result = validate_profile()
+    check(c['profile_manifest_sha256'] == PROFILE_SHA and c['writer_source_sha256'] == WRITER_SHA,
+          'case profile/writer stale')
+    roles = {'collector', 'matrix', 'metadata_consumer', 'profile_gate', 'source_manifest', 'launch_config', 'group', 'E0_runner'}
+    check(set(c['runtime_sources']) == roles, 'complete independently reviewed runtime source closure required')
+    for role, ref in c['runtime_sources'].items():
+        p = Path(ref['path'])
+        check(p.is_relative_to(ROOT / 'implementation') or (role in ('group', 'E0_runner') and p.is_relative_to(ROOT / 'env')),
+              'runtime source outside task scope')
+        bound(ref, 8 << 20)
+    check(c['runtime_sources']['group']['sha256'] == ev.FIXED['guest_group'] and
+          c['runtime_sources']['E0_runner']['sha256'] == ev.FIXED['E0_runner'], 'frozen launch source drift')
+    config = ev.decode(bound(c['runtime_sources']['launch_config'], 128 << 10))
+    check(config['output'] == str(run) and config['qemu_binary'] == result['qemu_binary'] and
+          {n['id'] for n in config['nodes']} == {'nodeA', 'nodeB'} and len(config['nodes']) == 2,
+          'actual launch selection differs from case')
+    artifacts = {'starts': 'guest-starts.json', 'identities': 'guest-identities.json', 'capture': 'own-qemu-metadata.json',
+                 'control': 'pool-events.jsonl', 'carriers': 'fm-carrier-active.json', 'endpoints': 'control-endpoints-active.json',
+                 'result': 'result.json', 'ownership': 'monitor/ownership-history.json'}
+    check(set(c['artifacts']) == set(artifacts), 'complete case evidence roles required')
+    for role, name in artifacts.items():
+        _reference_path(c['artifacts'][role], run / name)
+        bound(c['artifacts'][role], 16 << 20)
+    check(c['registry_directory'] == str(PREFIX / ('fixture-registry' if fixture else 'registry') / run.name),
+          'unique new registry namespace required')
+    return c, run, result, config
