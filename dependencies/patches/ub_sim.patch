+def save(path, value):
+    raw = m.ev.canonical(value) + b'\n'
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open('xb') as f: f.write(raw)
+    return {'path': str(path), 'bytes': len(raw), 'sha256': m.digest(raw)}
