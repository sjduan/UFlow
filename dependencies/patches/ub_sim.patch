++        c->q[MC_UBA] > UINT64_MAX - c->q[MC_SIZE] ||
++        c->q[MC_OFFSET] > c->q[MC_SIZE] ||
++        c->q[MC_LENGTH] > c->q[MC_SIZE] - c->q[MC_OFFSET] ||
++        !c->q[MC_EXPORT] || !c->q[MC_SEGMENT] || !c->q[MC_EPOCH] ||
++        !c->n[MC_BACKING] || !c->n[MC_HOME] || !c->n[MC_TOKEN] ||
++        c->n[MC_POLICY] != 1 || c->n[MC_FLAGS] != 7 ||
++        !(c->n[MC_ACCESS] & 1) || c->n[MC_NODES] < 2 ||
++        c->n[MC_NODES] > 8 || c->n[MC_NODE] >= c->n[MC_NODES]) {
