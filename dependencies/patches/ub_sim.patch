+"""Real current-domain checks and isolated altered-request rejection on HOST."""
+import copy
+import hashlib
+import json
+import os
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'scripts'))
+from uflow_terminal_domain_v2 import evaluate_terminal_v2,validate_candidate,FALSE_FACTS
+from uflow_qemu_evidence import EvidenceError
+
+
+class TerminalContracts(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.path=Path(os.environ['UFLOW_TERMINAL_V2_REQUEST']);cls.plan=json.loads(cls.path.read_bytes())
+        cls.sha=hashlib.sha256(cls.path.read_bytes()).hexdigest()
+        cls.candidate=Path(os.environ['UFLOW_TERMINAL_V2_CANDIDATE'])
+        cls.root=Path(os.environ['UFLOW_TERMINAL_V2_TEST_ROOT']);cls.root.mkdir()
+
+    def altered(self,change):
+        with tempfile.TemporaryDirectory(dir=self.root) as directory:
+            p=Path(directory)/'request.json';v=copy.deepcopy(self.plan);change(v)
+            p.write_bytes(json.dumps(v).encode());result=evaluate_terminal_v2(p,hashlib.sha256(p.read_bytes()).hexdigest())
+            self.assertEqual(result['status'],'INCOMPLETE');self.assertEqual(result['current_eligible_capacity_bytes'],0)
+            for name in FALSE_FACTS:self.assertIs(result[name],False)
+            return result
+
+    def test_actual_candidate_is_freshly_revalidated(self):
+        result=validate_candidate(self.candidate,hashlib.sha256(self.candidate.read_bytes()).hexdigest())
+        self.assertEqual(result['status'],'PASS_HOST_TERMINAL_DOMAIN_CANDIDATE_ONLY')
+        self.assertEqual(result['current_eligible_capacity_bytes'],52<<20)
+        self.assertEqual([r['object_id'] for r in result['eligible_rows']],[113,114,115])
+        self.assertEqual(result['protected_historical_bytes'],76<<20)
+        self.assertEqual(result['v1_metadata_verdict'],'INCOMPLETE')
+        for name in FALSE_FACTS:self.assertIs(result[name],False)
+
+    def test_wrong_external_request_pin_fails_closed(self):
+        result=evaluate_terminal_v2(self.path,'0'*64)
+        self.assertEqual(result['status'],'INCOMPLETE');self.assertEqual(result['current_eligible_capacity_bytes'],0)
+
+    def test_caller_complete_or_force_flags_cannot_become_evidence(self):
+        for flag in ('complete','ready','force'):
+            with self.subTest(flag=flag):self.altered(lambda p:p.update({flag:True}))
+
+    def test_old_c044_state_cannot_be_replayed(self):
+        self.altered(lambda p:p['state'].update(path=str(Path(p['state']['path']).parents[2]/'c044/state/state.json'),
+                     sha256='b6592a7442e7cb8540f340168a215fe6cc8cf669c7e87fedb7403ced2fc6c307'))
+
+    def test_unreviewed_source_graph_cannot_be_accepted(self):
+        self.altered(lambda p:p['source_graph'].update(sha256='0'*64))
+
+    def test_foreign_capture_and_external_RAM_claim_cannot_be_accepted(self):
+        self.altered(lambda p:p['capture'].update(path=str(self.root/'synthetic-external-file-RAM.json'),sha256='0'*64))
+
+    def test_foreign_or_replaced_actual_QEMU_log_cannot_be_used(self):
+        self.altered(lambda p:p['qemu_logs']['nodeA'].update(sha256='0'*64))
+
+    def test_forged_eligible_row_is_rejected_by_fresh_validator(self):
+        with tempfile.TemporaryDirectory(dir=self.root) as directory:
+            p=Path(directory)/'forged.json';v=json.loads(self.candidate.read_bytes());v['eligible_rows'][0]['backing']['generation']+=1
+            p.write_bytes(json.dumps(v).encode())
+            with self.assertRaisesRegex(EvidenceError,'fresh terminal predicate differs'):
+                validate_candidate(p,hashlib.sha256(p.read_bytes()).hexdigest())
+
+    def test_current_readonly_FD_holder_blocks_terminal_candidate(self):
+        # Only metadata is observed. No byte of the retained ring is read,
+        # written or mapped by this test; the actual original file is retained.
+        ring=Path(self.plan['carriers']['path']).parent/'fm/nodeA_ubcdev0__1_to_nodeB_ubcdev0__1.ring'
+        fd=os.open(ring,os.O_RDONLY|os.O_CLOEXEC|os.O_NOFOLLOW)
+        try:
+            result=evaluate_terminal_v2(self.path,self.sha)
+            self.assertEqual(result['status'],'INCOMPLETE');self.assertEqual(result['current_eligible_capacity_bytes'],0)
+            self.assertIn('held/hidden FD or VMA',result['missing_evidence'][0]['reason'])
+        finally:os.close(fd)
+
+
+if __name__=='__main__':unittest.main()
