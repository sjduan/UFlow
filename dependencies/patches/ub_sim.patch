+"""Deterministic PID-reuse counterexamples; no host PID namespace changes."""
+import importlib.util
+from pathlib import Path
+import unittest
+
+SOURCE = Path(__file__).resolve().parents[1] / 'scripts/uflow_build_supervisor.py'
+spec = importlib.util.spec_from_file_location('uflow_build_supervisor', SOURCE)
+build = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(build)
+
+
+class IdentityRetirement(unittest.TestCase):
+    def test_dead_identity_preserved_without_replacement_admission(self):
+        old = {'pid': 42, 'birth': 100, 'uid': 1}
+        known = {42: old.copy()}
+        retired = build.retire_dead(known, lambda pid: 200)
+        self.assertEqual(known, {})
+        self.assertEqual(retired[0]['birth'], 100)
+        self.assertEqual(retired[0]['replacement_birth_not_authorized'], 200)
+        self.assertEqual(retired[0]['retirement'], 'numeric-PID-reused')
+
+    def test_live_identity_not_retired(self):
+        known = {42: {'pid': 42, 'birth': 100}}
+        self.assertEqual(build.retire_dead(known, lambda pid: 100), [])
+        self.assertIn(42, known)
+
+    def test_unobservable_identity_is_not_pronounced_dead(self):
+        known = {42: {'pid': 42, 'birth': 100}}
+        def denied(pid):
+            raise PermissionError('not observable')
+        with self.assertRaises(PermissionError):
+            build.retire_dead(known, denied)
+        self.assertIn(42, known)
+
+
+if __name__ == '__main__':
+    unittest.main()
