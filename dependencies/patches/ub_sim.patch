+def validate_profile():
+    """Actual accepted producer, actual source/object/link closure; no QEMU run."""
+    path = OLD / 'release-v2/profile-manifest.json'
+    m = ev.decode(ev.read(path, 8 << 20)[0])
+    result = profile.validate(str(path), PROFILE_SHA, m['qemu_binary']['path'])
+    check(result['status'] == 'PASS_HOST_QEMU_PROFILE_ONLY' and
+          result['qemu_binary_sha256'] == BINARY_SHA, 'corrected actual profile required')
+    source = m['sources']['hw/ub/ub_ubc.c']
+    check(source['candidate']['sha256'] == WRITER_SHA and source['base']['sha256'] == md.SOURCE_SHA,
+          'actual candidate writer identity required')
+    before, after = bound(source['base'], 2 << 20).decode(), bound(source['candidate'], 2 << 20).decode()
+    names = ('sim_dec_obmm_bootstrap_dir', 'sim_dec_obmm_bootstrap_path', 'sim_dec_obmm_retired_dir',
+             'sim_dec_obmm_retired_path', 'sim_dec_handle_obmm_bootstrap_publish', 'sim_dec_handle_obmm_export_retire')
+    hashes = {}
+    for name in names:
+        a, b = extract_function(before, name), extract_function(after, name)
+        check(a == b, 'writer semantics changed: ' + name)
+        hashes[name] = digest(b.encode())
+    return {**result, 'writer_source': source['candidate'], 'unchanged_writer_functions': hashes}
