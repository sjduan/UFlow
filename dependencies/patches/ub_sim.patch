+def registry_history(directory, expected_head):
+    root = Path(directory); previous = '0' * 64; rows = []
+    check(root.parent == PREFIX / 'registry' and re.fullmatch('c[0-9]{3}', root.name) and root.resolve() == root,
+          'new production registry namespace required')
+    if root.exists():
+        files = sorted(p for p in root.iterdir() if p.name != '.lock')
+        check(len(files) <= 256 and all(re.fullmatch('[0-9]{6}\.json', p.name) for p in files), 'torn/unknown registry')
+        for number, p in enumerate(files, 1):
+            raw, _ = ev.read(p, 1 << 20); r = ev.decode(raw)
+            check(p.name == '%06d.json' % number and r['schema'] == 4 and r['interface'] == INTERFACE and
+                  r['kind'] == 'profile-registry-entry-v4' and r['sequence'] == number and r['previous_sha256'] == previous,
+                  'registry schema/chain gap/conflict')
+            entry = r['metadata']; check(entry['run'] == root.name, 'registry case/run conflict')
+            check(entry == _revalidate(entry),
+                  'registry entry changed since fresh validation')
+            previous = digest(raw); rows.append((r, previous))
+    check(expected_head == previous, 'stale registry head/replay')
+    return rows
