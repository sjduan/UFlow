+import stat
+import types
+
+INTERFACE = 'mem-service-private-qemu-domain-v1'
+QEMU_COMMIT = 'f2ef54f454b661e551a8619f9feb7406752a1b1a'
+KERNEL_COMMIT = 'c2def7c931e6451d89727dec0c6f892abe28ba00'
+HELPER_SHA = '647a2b7c24f086f4128879ac3ab98e3f0cf981c4211f1129a2fe0f1a4453c33e'
+FIXED = {
+    'qemu_binary': '56fab4e5d8c50c559f76c8ddbae9d6e1661e4764a6f927db2c3706e8199e5d4c',
+    'kernel_Image': '95165fea380ed231b609d4a2a71cfe9b877cac52b7bc44e39a870c839a676ada',
+    'guest_group': '05c2dcc01e6b24aed7e14bd6a77fcf8078f5c4f5e0fccd412833e58280ebdcd1',
+    'physical_helper': HELPER_SHA,
+    'E0_runner': 'c1b7115df2c0973e4ffcd689bef35af4aa457467223b15c6277a1e8479084727',
+}
+CURRENT_ROOT = '/workspace/uflow/runs/mem-service-shared-pool-20261108'
+CURRENT_STATE_SHA = 'b6592a7442e7cb8540f340168a215fe6cc8cf669c7e87fedb7403ced2fc6c307'
+TRUTHS = {
+    'runtime_E1_E5_passed': False, 'normal_native_or_SDK_release_ACK_proven': False,
+    'ledger_fences_applied': False, 'authority_to_mutate_ledger': False,
+    'authority_to_launch_new_Guest': False, 'authority_to_destroy_FM_payload_files': False,
+    'unknown_client_and_operation_history_preserved': True,
+}
+
+
+class EvidenceError(ValueError):
+    pass
+
+
+def check(value, reason):
+    if not value:
+        raise EvidenceError(reason)
+
+
+def digest(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=True).encode()
+
+
+def unique(pairs):
+    value = {}
+    for key, item in pairs:
+        check(key not in value, 'duplicate JSON key')
+        value[key] = item
+    return value
+
+
+def decode(data):
+    try:
+        def reject_constant(value):
+            raise EvidenceError('nonfinite JSON constant rejected')
+        return json.loads(data, object_pairs_hook=unique, parse_constant=reject_constant)
+    except (json.JSONDecodeError, UnicodeError) as error:
+        raise EvidenceError('invalid evidence JSON') from error
+
+
+def identity(info):
+    return {'dev': info.st_dev, 'inode': info.st_ino, 'uid': info.st_uid,
+            'file_type': stat.S_IFMT(info.st_mode), 'bytes': info.st_size,
+            'mtime_ns': info.st_mtime_ns}
+
+
+def checked_path(path):
+    path = Path(path)
+    check(path.is_absolute() and '..' not in path.parts, 'absolute normalized evidence path required')
+    check(path.resolve(strict=True) == path, 'symlink or path escape rejected')
+    return path
+
+
+def read(path, maximum=4 << 20, *, metadata=False, expected=None, allow_empty=False):
+    path = Path(path)
+    # FM payloads must never reach the general evidence reader. The metadata
+    # reader opts in only after exact schema/path/event authorization checks.
+    check(metadata or 'fm' not in path.parts, 'FM content is not a general evidence input')
+    try:
+        path = checked_path(path)
+        before = path.lstat()
+        check(stat.S_ISREG(before.st_mode) and (0 if allow_empty else 1) <= before.st_size <= maximum, 'nonregular/empty/oversized input')
+        if expected is not None:
+            actual = identity(before)
+            check(all(actual.get(key) == value for key, value in expected.items()
+                      if key in actual), 'file identity mismatch before open')
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK)
+        with os.fdopen(fd, 'rb') as stream:
+            first = identity(os.fstat(stream.fileno()))
+            check(first == identity(before), 'identity changed at open')
+            data = stream.read(maximum + 1)
+            last = identity(os.fstat(stream.fileno()))
+        check(first == last == identity(path.lstat()) and len(data) == first['bytes'] <= maximum,
+              'input changed/torn or exceeded bound')
+        return data, first
+    except OSError as error:
+        raise EvidenceError('evidence unavailable: ' + str(path)) from error
+
+
+def bound(record, maximum=4 << 20, *, allow_empty=False):
+    check(type(record) is dict and {'path', 'bytes', 'sha256'} <= record.keys(), 'incomplete evidence reference')
+    check(type(record['bytes']) is int and (0 if allow_empty else 1) <= record['bytes'] <= maximum,
+          'bad evidence size: ' + str(record['path']))
+    data, _ = read(record['path'], maximum, allow_empty=allow_empty)
+    check(len(data) == record['bytes'] and digest(data) == record['sha256'], 'evidence byte/hash mismatch')
+    return data
+
+
+def document(record, kind=None, maximum=4 << 20):
+    value = decode(bound(record, maximum))
+    check(type(value) is dict, 'typed evidence object required')
+    if kind is not None:
+        check(value.get('kind') == kind and value.get('schema') == 1, 'evidence kind/schema mismatch')
+    return value
+
+
+def reviewed(path, external_sha):
+    check(type(external_sha) is str and len(external_sha) == 64, 'external reviewed manifest digest required')
+    data, _ = read(path)
+    check(digest(data) == external_sha, 'external manifest pin mismatch')
+    value = decode(data)
+    check(type(value) is dict and value.get('interface') == INTERFACE and value.get('schema') == 1,
+          'wrong host platform interface')
+    return value
+
+
+def frozen_helper(path):
+    data, _ = read(path, 128 << 10)
+    check(digest(data) == HELPER_SHA, 'frozen physical helper source mismatch')
+    # Compile only the already-hashed source bytes, avoiding module/pyc cache
+    # substitution. This is a fresh ordinary Python module, not a patched worker.
+    module = types.ModuleType('_uflow_pinned_physical_helper')
+    module.__file__ = str(path)
+    exec(compile(data, str(path), 'exec'), module.__dict__)
+    check(all(callable(getattr(module, name, None)) for name in
+              ('identity', 'holders', 'file_identity_aliases')), 'frozen helper ABI missing')
+    return module
+
+
+def fixed_bindings(records):
+    check(set(records) == set(FIXED), 'complete fixed runtime binding set required')
+    for key, expected in FIXED.items():
+        check(records[key]['sha256'] == expected, 'wrong fixed ' + key)
+        bound(records[key], 256 << 20 if key == 'qemu_binary' else 128 << 20)
+
+
+def immutable_json(path, value):
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    data = canonical(value) + b'\n'
+    with path.open('xb') as stream:
+        stream.write(data)
+        stream.flush()
+        os.fsync(stream.fileno())
+    path.chmod(0o444)
+    return {'path': str(path), 'bytes': len(data), 'sha256': digest(data)}
