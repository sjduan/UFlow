+        raw[start:end] = word.encode().ljust(end - start, b'\0')
+    for offset, value in ((24, 1), (224, 70 if node == 'nodeA' else 71), (248, 1), (256, 50331648)):
+        struct.pack_into('<Q', raw, offset, value)
+    value = 14695981039346656037
+    for b in raw[:1016]: value = ((value ^ b) * 1099511628211) & ((1 << 64) - 1)
+    struct.pack_into('<Q', raw, 1016, value)
+    value = 1469598103934665603
+    for b in raw: value = ((value ^ b) * 1099511628211) & ((1 << 64) - 1)
+    text = 'UFPOOL_JOURNAL_BEGIN fixture=1\nUFPOOL_JOURNAL_CHUNK offset=0 hex=' + raw.hex()
+    text += '\nUFPOOL_JOURNAL_END status=complete complete=1 bytes=1024 fnv64=%016x\n' % value
+    path.write_text(text)
+    ref = {'format': 'captured-serial-v1', 'source': reference(path), 'bytes': 1024, 'sha256': m.digest(raw)}
+    summary = {'capture_end': {'complete': '1', 'status': 'complete'}, 'bytes': 1024, 'sha256': m.digest(raw), 'frames': m.md.journal_frames(ref)}
+    return ref, summary
