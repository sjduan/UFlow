+def reviewed(path, external_sha, kind):
+    check(type(external_sha) is str and re.fullmatch('[0-9a-f]{64}', external_sha), 'external digest required')
+    raw, _ = ev.read(path, 4 << 20)
+    check(digest(raw) == external_sha, 'external digest mismatch')
+    v = ev.decode(raw)
+    check(v.get('schema') == 2 and v.get('interface') == INTERFACE and v.get('kind') == kind,
+          'wrong profile-aware schema/interface/kind')
+    return v
