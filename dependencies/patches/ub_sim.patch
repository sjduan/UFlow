+def _capture(c, run, prof, config, fixture):
+    starts = ev.decode(bound(c['artifacts']['starts']))
+    ids = ev.decode(bound(c['artifacts']['identities']))
+    cap = document(c['artifacts']['capture'], 'own-QEMU-metadata-capture')
+    check(len(starts) == 2 and {s['node'] for s in starts} == {'nodeA', 'nodeB'} and
+          len({(s['pid'], s['birth']) for s in starts}) == 2, 'two distinct actual QEMU starts required')
+    check(len(ids) == 2 and {i['node'] for i in ids} == {'nodeA', 'nodeB'} and
+          len({i['boot_id'] for i in ids}) == 2, 'two independent Guest boot identities required')
+    check(cap['starts_sha256'] == c['artifacts']['starts']['sha256'] and
+          cap['group_source_sha256'] == ev.FIXED['guest_group'] and cap['clock_domain'] == 'B-host' and
+          0 < cap['start_host_ns'] <= cap['end_host_ns'], 'inline capture/starts clock/source binding')
+    provenance = cap['qemu_profile_provenance']
+    check(cap['normal_SDK_ACK'] is False and cap['authority_to_mutate_ledger'] is False and
+          cap['authority_to_launch_Guest'] is False, 'capture is observation only')
+    check(all(provenance.get(k) == v for k, v in prof.items() if k != 'unchanged_writer_functions' and k != 'writer_source') and
+          provenance['HOST_fixture_only'] is fixture and provenance['boot_authority'] is False,
+          'actual producer profile provenance differs')
+    check(provenance['external_validator']['sha256'] == PROFILE_CODE_SHA and
+          provenance['profile_manifest']['sha256'] == PROFILE_SHA, 'collector producer anchor mismatch')
+    check(len(cap['processes']) == 2 and {p['node'] for p in cap['processes']} == {'nodeA', 'nodeB'},
+          'both inline process observations required')
+    for s in starts:
+        rows = [p for p in cap['processes'] if p['node'] == s['node']]; p = rows[0]
+        i = p['identity']; env = p['selected_launch_environment']
+        check((i['pid'], i['birth'], i['ppid']) == (s['pid'], s['birth'], cap['owner']['pid']) and
+              p['executable'] == s['argv'][0] == prof['qemu_binary'] and p['executable_sha256'] == BINARY_SHA,
+              'actual executable/birth/parent mismatch')
+        check(p['qemu_profile_provenance'] == provenance and not p['missing_evidence'] and
+              all(p[k] is False for k in ('RAM_or_transport_contents_read', 'full_environment_read', 'QMP_commands_added')),
+              'incomplete/forbidden process observation')
+        check(set(p['namespaces']) == {'pid', 'mnt', 'user'} and
+              all(p['namespaces'][key] == os.readlink('/proc/self/ns/' + key) for key in p['namespaces']),
+              'foreign namespace capture')
+        fds = p['FD_metadata']
+        check(3 <= len(fds) <= 128 and len({f['fd'] for f in fds}) == len(fds) and
+              all({'fd', 'target', 'dev', 'inode', 'uid', 'type', 'file_contents_read'} <= f.keys() and
+                  type(f['dev']) is int and type(f['inode']) is int and type(f['type']) is int and
+                  f['uid'] == os.geteuid() and f['file_contents_read'] is False for f in fds), 'UID/FD evidence missing')
+        memory = next(n['memory_mib'] << 20 for n in config['nodes'] if n['id'] == s['node'])
+        check(any(v['file_backed'] is False and v['bytes'] == v['end'] - v['start'] >= memory and
+                  v['permissions'].startswith('rw') and v in p['anonymous_writable_VMA_metadata']
+                  for v in p['RAM_sized_anonymous_candidates']), 'anonymous RAM VMA not captured')
+        check(env['direct_child_proc_environment_observed'] is False and env['full_environment_read'] is False and
+              env['basis'].startswith('source-derived') and env['values']['UB_FM_SHARED_DIR'] == str(run / 'fm') and
+              env['values']['UB_FM_NODE_ID'] == s['node'], 'environment must remain explicit source inference')
+        check(all(env['values'].get(k) is None for k in ('LD_PRELOAD', 'LD_AUDIT', 'QEMU_RAM_PATH')),
+              'unreviewed launch environment override')
+    return starts, ids, cap
