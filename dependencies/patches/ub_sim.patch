+_DEPS = _load_dependencies()
+ev = _DEPS['uflow_qemu_evidence.py']
+md = _DEPS['uflow_qemu_metadata.py']
+profile = _DEPS['uflow_qemu_profile.py']
+check, digest, bound, document = ev.check, ev.digest, ev.bound, ev.document
+TRUTHS = {'authority_to_mutate_ledger': False, 'normal_native_or_SDK_release_ACK_proven': False,
+          'authority_to_launch_Guest': False, 'files_deleted': False,
