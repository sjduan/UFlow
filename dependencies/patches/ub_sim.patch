+++ b/guest-linux/aarch64/tests/test_uflow_env_guest_audit.py
@@ -0,0 +1,123 @@
+"""Resource guard checks with real owned Linux files, mappings and child exit."""
+import importlib.util
+import ctypes
+import json
+import mmap
+import os
+from pathlib import Path
+import socket
+import stat
+import subprocess
+import sys
+import tempfile
+import unittest
+
+SOURCE = Path(__file__).resolve().parents[1] / 'scripts/uflow_guest_audit.py'
+spec = importlib.util.spec_from_file_location('uflow_guest_audit', SOURCE)
+audit = importlib.util.module_from_spec(spec)
+if sys.platform.startswith('linux'):
+    spec.loader.exec_module(audit)
+
+
+@unittest.skipUnless(sys.platform.startswith('linux'), 'real Linux resource identity tests')
+class ExactResourceAudit(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix='a', dir=os.environ.get('UFLOW_TEST_WORK_DIR'))
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.out = self.root / 'runs/a'
+        (self.out / 'fm').mkdir(parents=True)
+        (self.root / 'coordination').mkdir()
+        self.result = {'process_tree_empty': True, 'task_resources_closed': True, 'owned_births': {}}
+
+    def metadata(self, files, endpoints=()):
+        (self.out / 'result.json').write_text(json.dumps({'processes': self.result}))
+        (self.out / 'fm-carrier-active.json').write_text(json.dumps({'files': files}))
+        (self.out / 'control-endpoints-active.json').write_text(json.dumps(list(endpoints)))
+
+    def row(self, path):
+        info = path.lstat()
+        row = {'path': str(path), 'dev': info.st_dev, 'inode': info.st_ino, 'uid': info.st_uid,
+                'file_type': stat.S_IFMT(info.st_mode), 'bytes': info.st_size}
+        row['kernel_inode_aliases'] = audit.file_identity_aliases(path, row)
+        return row
+
+    def test_live_original_birth_rejected_without_unlink(self):
+        self.result['owned_births'] = {str(os.getpid()): audit.identity(os.getpid())}
+        self.metadata([])
+        with self.assertRaisesRegex(RuntimeError, 'still alive'):
+            audit.audit(self.root, 'a')
+        self.assertFalse((self.out / 'post-close-audit.json').exists())
+
+    def test_replaced_FM_inode_rejected(self):
+        path = self.out / 'fm/backing'
+        path.write_bytes(b'original')
+        original = self.row(path)
+        path.rename(self.out / 'original-preserved')
+        path.write_bytes(b'replacement')
+        self.metadata([original])
+        with self.assertRaisesRegex(RuntimeError, 'identity drift'):
+            audit.audit(self.root, 'a')
+        self.assertEqual(path.read_bytes(), b'replacement')
+
+    def test_real_FD_and_VMA_holder_prevents_cleanup(self):
+        path = self.out / 'fm/backing'
+        path.write_bytes(b'x'*4096)
+        row = self.row(path)
+        self.metadata([row])
+        with path.open('r+b') as stream, mmap.mmap(stream.fileno(), 4096) as view:
+            view[0] = 65
+            observed = audit.holders({tuple(x) for x in row['kernel_inode_aliases']})
+            own = [item['kind'] for item in observed['holders'] if item['pid'] == os.getpid()]
+            self.assertIn('FD', own)
+            self.assertIn('VMA', own)
+            with self.assertRaisesRegex(RuntimeError, 'inconclusive'):
+                audit.audit(self.root, 'a')
+        self.assertTrue(path.exists())
+
+    def test_reaped_child_socket_removed_and_FIFO_retained(self):
+        endpoint = self.out / 's'
+        child = subprocess.Popen([sys.executable, '-B', '-c',
+            'import socket,sys; s=socket.socket(socket.AF_UNIX); s.bind(sys.argv[1]); '
+            'print("bound",flush=True); sys.stdin.buffer.read(1)', str(endpoint)],
+            stdin=subprocess.PIPE, stdout=subprocess.PIPE)
+        self.assertEqual(child.stdout.readline().strip(), b'bound')
+        born = audit.identity(child.pid)
+        endpoint_row = self.row(endpoint)
+        self.assertEqual(child.communicate(input=b'!', timeout=5)[0], b'')
+        self.assertEqual(child.returncode, 0)
+        fifo = self.out / 'fm/notify'
+        os.mkfifo(fifo)
+        self.result['owned_births'] = {str(child.pid): born}
+        self.metadata([self.row(fifo)], [endpoint_row])
+        audit.audit(self.root, 'a')
+        self.assertFalse(endpoint.exists())
+        self.assertTrue(fifo.exists())
+        result = json.loads((self.out / 'post-close-audit.json').read_bytes())
+        self.assertFalse(result['shared_FM_unlinked'])
+        self.assertFalse(result['logical_allocation_ACK_inferred'])
+        self.assertTrue(result['Guest_execution_lock_reacquired_and_released'])
+
+    def test_VMA_only_holder_survives_FD_close_and_is_detected(self):
+        path = self.out / 'fm/backing'
+        path.write_bytes(b'x'*4096)
+        row = self.row(path)
+        libc = ctypes.CDLL(None, use_errno=True)
+        libc.mmap.argtypes = (ctypes.c_void_p, ctypes.c_size_t, ctypes.c_int, ctypes.c_int, ctypes.c_int, ctypes.c_longlong)
+        libc.mmap.restype = ctypes.c_void_p
+        libc.munmap.argtypes = (ctypes.c_void_p, ctypes.c_size_t)
+        fd = os.open(path, os.O_RDONLY)
+        address = libc.mmap(None, 4096, mmap.PROT_READ, mmap.MAP_SHARED, fd, 0)
+        os.close(fd)
+        self.assertNotEqual(address, ctypes.c_void_p(-1).value)
+        try:
+            observed = audit.holders({tuple(x) for x in row['kernel_inode_aliases']})
+            own = [item['kind'] for item in observed['holders'] if item['pid'] == os.getpid()]
+            self.assertIn('VMA', own)
+            self.assertNotIn('FD', own)
+        finally:
+            self.assertEqual(libc.munmap(address, 4096), 0)
+
+
+if __name__ == '__main__':
+    unittest.main()
