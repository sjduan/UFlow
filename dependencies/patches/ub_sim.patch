@@ -0,0 +1,14 @@
+#!/bin/busybox sh
+# Generic initramfs agent seam: initialize the standard Guest, then run payload.
+set -eu
+for fs in proc sysfs devtmpfs; do
+    case "$fs" in proc) dir=/proc ;; sysfs) dir=/sys ;; devtmpfs) dir=/dev ;; esac
+    /bin/busybox mkdir -p "$dir"
+    /bin/busybox mount -t "$fs" none "$dir" 2>/dev/null || true
+done
+if [ "${1:-}" != "--resume" ]; then
+    export UB_RUN_APP_FROM_INIT=1
+    exec /bin/linqu_init "$@"
+fi
+# /bin/uflow_env_payload is replaced by an explicit caller-supplied agent overlay.
+exec /bin/uflow_env_payload
diff --git a/guest-linux/aarch64/scripts/uflow_env_guest_smoke.sh b/guest-linux/aarch64/scripts/uflow_env_guest_smoke.sh
new file mode 100755
index 0000000000000000000000000000000000000000..185475db6c21e69f240ac38c19e0e40797e0a889
--- /dev/null
+++ b/guest-linux/aarch64/scripts/uflow_env_guest_smoke.sh
@@ -0,0 +1,61 @@
+#!/bin/busybox sh
+# E0 identity/control/installed-SDK smoke only. No business pool is allocated.
+set -eu
+node=""
+for token in $(/bin/busybox cat /proc/cmdline); do
+    case "$token" in uflow_node=*) node="${token#*=}" ;; esac
+done
+case "$node" in nodeA|nodeB) ;; *) echo UFLOW_ENV_FAIL_bad_node; exit 2 ;; esac
+boot_id="$(/bin/busybox cat /proc/sys/kernel/random/boot_id)"
+machine="$(/bin/busybox uname -m)"
+kernel_release="$(/bin/busybox uname -r)"
+guest_uid="$(/bin/busybox id -u)"
+daemon=""
+close_daemon() {
+    if [ -n "$daemon" ]; then
+        kill -TERM "$daemon"
+        wait "$daemon"
+        daemon=""
+    fi
+}
+trap close_daemon EXIT
+/bin/uflow_mem_service serve --listen unix:/tmp/uflow-e0.sock --store /tmp/uflow-e0.store >/tmp/uflow-e0.daemon.log 2>&1 &
+daemon=$!
+i=0
+while ! /bin/uflow_sdk_probe unix:/tmp/uflow-e0.sock >/tmp/uflow-sdk-probe.log 2>&1; do
+    i=$((i+1))
+    [ "$i" -lt 50 ] || { echo UFLOW_ENV_FAIL_sdk_start; exit 1; }
+    /bin/busybox sleep .1
+done
+identity() {
+    printf 'UFLOW_ENV_IDENTITY {"node":"%s","boot_id":"%s","engine":"initramfs","machine":"%s","kernel_release":"%s","uid":%s,"payload_operations":0}\n' "$node" "$boot_id" "$machine" "$kernel_release" "$guest_uid"
+}
+identity
+while IFS= read -r command; do
+    # A serial terminal may send CRLF; accepted commands remain a fixed set.
+    command="$(printf '%s' "$command" | /bin/busybox tr -d '\r')"
+    case "$command" in
+        identity) identity ;;
+        sdk-check)
+            if /bin/uflow_sdk_probe unix:/tmp/uflow-e0.sock && /bin/linqu_ub_gsva_query --caps && /bin/uflow_kernel_probe; then
+                echo UFLOW_ENV_SDK_OK
+            else
+                echo UFLOW_ENV_FAIL_sdk_or_gsva
+                exit 1
+            fi
+            ;;
+        quit)
+            close_daemon
+            trap - EXIT
+            echo UFLOW_ENV_DAEMON_CLOSED
+            # The fixed Guest kernel has an observed device-shutdown fault.
+            # The host closes QEMU only after receiving both real drain markers.
+            IFS= read -r -t 30 unexpected || true
+            echo UFLOW_ENV_FAIL_hypervisor_close_deadline
+            exit 1
+            ;;
+        *) echo UFLOW_ENV_FAIL_unknown_control; exit 2 ;;
+    esac
+done
+echo UFLOW_ENV_FAIL_control_EOF
+exit 1
diff --git a/guest-linux/aarch64/scripts/uflow_env_kernel_probe.c b/guest-linux/aarch64/scripts/uflow_env_kernel_probe.c
