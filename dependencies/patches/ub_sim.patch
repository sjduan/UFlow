+def stream_historical_log(ref, run, node):
+    path = Path(ref['path']); check(path==run/(node+'.qemu.log'),'named historical log only')
+    info = path.lstat()
+    check(path.resolve()==path and stat.S_ISREG(info.st_mode) and ev.identity(info)==ref['identity'] and
+          info.st_size==ref['bytes'] and (info.st_size<=64<<20 or
+          (node=='nodeB' and info.st_size==319991262 and ref['sha256']=='7d588663bfbd654cfbbb3af08991d939686321308033cd424b42f77ba2367ac0')),
+          'explicit fixed historical oversize exception only')
+    h=hashlib.sha256(); tail=b''; prefix=b''
+    with path.open('rb') as stream:
+        for chunk in iter(lambda:stream.read(128<<10),b''):
+            h.update(chunk)
+            if not prefix: prefix=chunk[:128]
+            folded=(tail+chunk).lower()
+            check(not any(text in folded for text in (b'falling back to',b'failed to initialize tcg',b'invalid accelerator')),
+                  'actual TCG failure/fallback in preserved historical log')
+            tail=folded[-64:]
+    check(h.hexdigest()==ref['sha256'] and ev.identity(path.lstat())==ref['identity'],'historical log changed')
+    check(prefix.startswith(b'configure accelerator virt-8.2 start\nmachine init start\n'),'actual accelerator initialization prefix missing')
+    return {'sha256':h.hexdigest(),'bytes':info.st_size,'streamed_not_exported':True,
+            'historical_log_budget_failure_preserved':info.st_size>64<<20}
