+#!/usr/bin/env python3
+"""HOST codec and real Unix/SO_PEERCRED QMP fixture; no Guest or authority."""
+import copy
+import hashlib
+import io
+import json
+import os
+from pathlib import Path
+import socket
+import tempfile
+import threading
+import time
+import types
+import unittest
+
+SCRIPTS = Path(__file__).resolve().parents[1] / 'scripts'
+
+
+def load(name):
+    path = SCRIPTS / name
+    m = types.ModuleType('_test_' + name[:-3]); m.__file__ = str(path)
+    exec(compile(path.read_bytes(), str(path), 'exec'), m.__dict__)
+    return m
+
+
+c = load('uflow_managed_cache_codec_v2.py')
+g = load('uflow_managed_guest_group_v1.py')
+
+
+def command(op='begin', generation=1):
+    row = dict(version=1, operation=op, control_generation=generation,
+               authority_sha256='1' * 64, correlation_sha256='2' * 64,
+               descriptor_sha256='3' * 64)
+    row.update(zip(c.FIELDS64, (23, 1, 2, 0x700000000000, 48 << 20, 891, 1, 65536, 20 << 20)))
+    row.update(zip(c.FIELDS32, (67, 50370, 45, 1, 17, 3, 0, 2, 7)))
+    return row
+
+
+def reply(wire, *, code='ok', active=None, pages=0, inflight=0):
+    row = c.decode(wire)
+    alias = {k: str(row[k]) for k in c.FIELDS64}
+    alias.update({k: row[k] for k in c.FIELDS32})
+    alias['descriptor_sha256'] = row['descriptor_sha256']
+    if row['operation'] == 'probe': alias.update(map_id='23', lease_epoch='1')
+    return dict(version=1, feature=c.FEATURE, pid=os.getpid(), operation=row['operation'],
+                request_sha256=c.request_sha256(wire), control_generation=str(row['control_generation']),
+                **{k: row[k] for k in c.HASHES}, code=code,
+                active=(row['operation'] == 'begin') if active is None else active,
+                in_flight=inflight, cache_pages=pages, native_alias=alias,
+                counters={**{k: '0' for k in c.COUNTERS}, 'saturated': False},
+                scope='UFlow-Catalog-managed-only')
+
+
+class Codec(unittest.TestCase):
+    def test_roundtrip_and_max_u64(self):
+        row = command(); row['segment_id'] = (1 << 64) - 1
+        self.assertEqual(c.decode(c.encode(row)), row)
+        wire = c.encode(row)
+        self.assertEqual(c.validate_reply(wire, json.dumps(reply(wire)), os.getpid())['code'], 'ok')
+
+    def test_wire_rejects_noncanonical_and_reserved(self):
+        wire = c.encode(command())
+        raw = bytearray.fromhex(wire[5:]); raw[6] = 1
+        for bad in (wire.upper(), wire + '0', wire[:-1], 'umc1:' + raw.hex()):
+            with self.subTest(bad=bad[:20]), self.assertRaises(ValueError): c.decode(bad)
+
+    def test_command_type_bounds_and_authority(self):
+        for key, value in [('version', True), ('map_id', False), ('length', 0), ('offset', 48 << 20),
+                           ('home_cna', -1), ('epoch', 1 << 64), ('authority_sha256', '0' * 64),
+                           ('cache_policy', 0), ('owner_node', 2)]:
+            row = command(); row[key] = value
+            with self.subTest(key=key), self.assertRaises((ValueError, TypeError)): c.encode(row)
+
+    def test_reply_exact_types(self):
+        wire = c.encode(command())
+        for key, value in [('version', True), ('pid', True), ('active', 1), ('in_flight', False),
+                           ('cache_pages', 0.0), ('cache_pages', 2049), ('control_generation', 1)]:
+            row = reply(wire); row[key] = value
+            with self.subTest(key=key), self.assertRaises(ValueError): c.validate_reply(wire, row, os.getpid())
+
+    def test_reply_requires_complete_exact_alias(self):
+        wire = c.encode(command())
+        for key in (*c.FIELDS64, *c.FIELDS32, 'descriptor_sha256'):
+            for mode in ('missing', 'wrong'):
+                row = reply(wire)
+                if mode == 'missing': del row['native_alias'][key]
+                elif key in c.FIELDS64: row['native_alias'][key] = '0'
+                elif key in c.FIELDS32: row['native_alias'][key] = True
+                else: row['native_alias'][key] = '4' * 64
+                with self.subTest(key=key, mode=mode), self.assertRaises(ValueError): c.validate_reply(wire, row, os.getpid())
+
+    def test_reply_binding_and_unknown_member(self):
+        wire = c.encode(command())
+        for key, value in [('request_sha256', '4' * 64), ('authority_sha256', '4' * 64),
+                           ('correlation_sha256', '4' * 64), ('operation', 'end'), ('feature', 'old'),
+                           ('pid', os.getpid() + 1), ('arbitrary', 7), ('native_alias', None)]:
+            row = reply(wire); row[key] = value
+            with self.subTest(key=key), self.assertRaises(ValueError): c.validate_reply(wire, row, os.getpid())
+
+    def test_reply_counters_and_json(self):
+        wire = c.encode(command())
+        for value in ('00', '-1', str(1 << 64), True, 0.0):
+            row = reply(wire); row['counters']['cache_hits'] = value
+            with self.assertRaises(ValueError): c.validate_reply(wire, row, os.getpid())
+        for body in ('{"version":1,"version":1}', '{"x":NaN}', '{"x":"é"}', ' ' * 4097):
+            with self.assertRaises((ValueError, UnicodeError)): c.validate_reply(wire, body, os.getpid())
+
+    def test_begin_empty_and_end_drained(self):
+        for op, active, pages, flight in [('begin', False, 0, 0), ('begin', True, 1, 0),
+                                        ('end', True, 0, 0), ('end', False, 1, 0), ('end', False, 0, 1)]:
+            wire = c.encode(command(op))
+            with self.subTest(op=op, active=active, pages=pages, flight=flight), self.assertRaises(ValueError):
+                c.validate_reply(wire, reply(wire, active=active, pages=pages, inflight=flight), os.getpid())
+
+    def test_probe_resolves_native_alias(self):
+        row = command('probe', 0); row.update(map_id=0, lease_epoch=0)
+        wire = c.encode(row)
+        self.assertEqual(c.validate_reply(wire, reply(wire), os.getpid())['native_alias']['map_id'], '23')
+        value = reply(wire); value['native_alias']['lease_epoch'] = '0'
+        with self.assertRaises(ValueError): c.validate_reply(wire, value, os.getpid())
+
+    def test_descriptor_public_slices_only(self):
+        raw = bytearray(96)
+        fields = [(0,4,0x4d534f42),(4,4,2),(8,4,96),(16,8,2),(24,8,0x700000000000),
+                  (32,8,48<<20),(40,4,67),(44,4,50370),(48,8,891),(56,8,1),(64,4,7),
+                  (68,4,0),(72,4,2),(76,4,1),(80,4,17),(84,4,3),(88,4,45)]
+        for at, n, value in fields: raw[at:at+n] = value.to_bytes(n, 'big')
+        one = c.descriptor_metadata(raw.hex()); raw[92:] = b'\x99' * 4
+        two = c.descriptor_metadata(raw.hex())
+        self.assertNotEqual(one.pop('descriptor_sha256'), two.pop('descriptor_sha256'))
+        self.assertEqual(one, two); self.assertNotIn('token_value', one)
+
+
+class Peer:
+    """Bounded local Unix endpoint owned by this actual process, no QEMU."""
+    def __init__(self, path, transform=None, disconnect=False):
+        self.sock = socket.socket(socket.AF_UNIX); self.sock.bind(str(path)); self.sock.listen(1)
+        self.sock.settimeout(3); self.calls = []; self.error = None
+        self.transform = transform; self.disconnect = disconnect; self.last = None
+        self.thread = threading.Thread(target=self.serve); self.thread.start()
+
+    def serve(self):
+        try:
+            conn, _ = self.sock.accept()
+            with conn, conn.makefile('rwb', buffering=0) as stream:
+                conn.settimeout(3); stream.write(b'{"QMP":{}}\r\n')
+                for _ in range(100):
+                    raw = stream.readline(8193)
+                    if not raw: break
+                    req = json.loads(raw); self.calls.append(req)
+                    op = req['execute']; value = {}
+                    if op == 'qom-set':
+                        assert req['arguments']['path'] == c.OBJECT_PATH and req['arguments']['property'] == c.PROPERTY
+                        self.last = req['arguments']['value']
+                    elif op == 'qom-get':
+                        if self.disconnect: break
+                        value = reply(self.last)
+                        if self.transform: value = self.transform(value)
+                        value = json.dumps(value)
+                    elif op == 'query-status': value = {'status': 'running'}
+                    else: assert op in ('qmp_capabilities', 'quit', 'system_powerdown')
+                    stream.write(json.dumps({'return': value, 'id': req['id']}).encode() + b'\r\n')
+        except BaseException as error: self.error = error
+        finally: self.sock.close()
+
+    def finish(self):
+        self.thread.join(4)
+        if self.thread.is_alive(): raise AssertionError('fixture endpoint did not reap')
+        if self.error: raise self.error
+
+
+class Wrapper(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory(prefix='mc-', dir=SCRIPTS.parent)
+        self.peer = self.qmp = None; self.notices = []
+        self.previous = g.notify_failure; g.notify_failure = lambda: self.notices.append(time.monotonic())
+
+    def tearDown(self):
+        g.notify_failure = self.previous
+        if self.qmp: self.qmp.abort_transport()
+        if self.peer: self.peer.finish()
+        self.tmp.cleanup()
+
+    def connect(self, **kwargs):
+        path = '\0uflow-mc-host-' + str(os.getpid()) + '-' + str(time.monotonic_ns())
+        self.peer = Peer(path, **kwargs); self.qmp = g.QMP(path, time.monotonic() + 3)
+        birth = int(Path('/proc/self/stat').read_bytes().rpartition(b')')[2].split()[19])
+        self.qmp.bind_managed_peer(os.getpid(), birth)
+        return self.qmp
+
+    def test_normal_real_peer_and_lifecycle(self):
+        q = self.connect()
+        self.assertEqual(q.command('query-status'), {'status': 'running'})
+        self.assertTrue(q.managed_cache(c.encode(command()))['active'])
+        for action in (q.close, lambda:q.command('quit'), lambda:q.command('system_powerdown')):
+            with self.assertRaises(RuntimeError): action()
+        self.assertFalse(q.managed_cache(c.encode(command('end')))['active'])
+        q.command('quit'); q.close(); self.assertEqual(self.notices, [])
+
+    def test_general_qom_and_debug_commands_rejected(self):
