index 0000000000000000000000000000000000000000..52453f78f1bca4e5931a590811f10d4b3af5a292
--- /dev/null
+++ b/guest-linux/aarch64/scripts/uflow_env_kernel_probe.c
@@ -0,0 +1,71 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+#include <ub/obmm.h>
+#include <ub/gsva.h>
+
+/* Read-only public kernel ABI probe: no aperture, segment or allocation create. */
+int main(void)
+{
+    struct obmm_cmd_gsva_enumerate_v1 command = { .version = 1 };
+    unsigned char first_instance[16] = {0};
+    unsigned char zero[16] = {0};
+    uint64_t first_revision = 0;
+    unsigned int entries = 0;
+    int fd = open("/dev/obmm", O_RDWR | O_CLOEXEC);
+
+    if (fd < 0) {
+        perror("open public OBMM device");
+        return 1;
+    }
+    for (unsigned int page = 0; page < 64; ++page) {
+        struct obmm_cmd_gsva_enumerate_v1 next = {
+            .version = 1,
+            .revision = command.revision,
+            .cursor = command.cursor,
+        };
+        memcpy(next.kernel_instance, command.kernel_instance, sizeof(next.kernel_instance));
+        command = next;
+        if (ioctl(fd, OBMM_CMD_GSVA_ENUMERATE, &command) != 0) {
+            perror("public GSVA enumeration");
+            close(fd);
+            return 1;
+        }
+        if (command.version != 1 || memcmp(command.kernel_instance, zero, sizeof(zero)) == 0 ||
+            !(command.flags & (OBMM_GSVA_ENUM_ENTRY | OBMM_GSVA_ENUM_END))) {
+            fprintf(stderr, "invalid versioned kernel inventory reply\n");
+            close(fd);
+            return 1;
+        }
+        if (page == 0) {
+            memcpy(first_instance, command.kernel_instance, sizeof(first_instance));
+            first_revision = command.revision;
+        } else if (memcmp(first_instance, command.kernel_instance, sizeof(first_instance)) != 0 ||
+                   first_revision != command.revision) {
+            fprintf(stderr, "kernel inventory identity/revision drift\n");
+            close(fd);
+            return 1;
+        }
+        if (command.flags & OBMM_GSVA_ENUM_ENTRY) {
+            ++entries;
+        }
+        if (command.flags & OBMM_GSVA_ENUM_END) {
+            printf("kernel_inventory_version=1 kernel_instance=");
+            for (unsigned int i = 0; i < sizeof(first_instance); ++i) {
+                printf("%02x", first_instance[i]);
+            }
+            printf(" revision=%" PRIu64 " entries=%u enumeration_bytes=%zu allocation_operations=0\n",
+                   first_revision, entries, sizeof(command));
+            close(fd);
+            return 0;
+        }
+    }
+    fprintf(stderr, "bounded kernel inventory page limit reached\n");
+    close(fd);
+    return 1;
+}
diff --git a/guest-linux/aarch64/scripts/uflow_env_runner.py b/guest-linux/aarch64/scripts/uflow_env_runner.py
new file mode 100755
index 0000000000000000000000000000000000000000..5350bf01dbee0ce4283fddcc46ada4176d1b07af
--- /dev/null
+++ b/guest-linux/aarch64/scripts/uflow_env_runner.py
@@ -0,0 +1,292 @@
+#!/usr/bin/env python3
+"""Run one task-owned environment job through the accepted external supervisor.
+
+Configuration and outputs belong to a private task root. The supervisor source
+and SHA bindings are supplied explicitly; no NPU-specific teardown is imported.
+This runner never unlinks FM/shared backing or infers logical ACK from death.
+"""
+import argparse
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path
+import select
+import signal
+import stat
+import subprocess
+import sys
+import threading
+import time
+
+
+def save(path, value):
+    with path.open('x', encoding='utf-8') as stream:
+        json.dump(value, stream, indent=2); stream.flush(); os.fsync(stream.fileno())
+
+
+def load(config):
+    value = json.loads(Path(config).read_bytes())
+    root = Path(value['root']).resolve()
+    if not root.is_dir() or root.stat().st_uid != os.geteuid():
+        raise ValueError('same-UID task root required')
+    for key in ('job',):
+        text = value[key]
+        if type(text) is not str or not text or len(text) > 32 or any(c not in 'abcdefghijklmnopqrstuvwxyz0123456789-_' for c in text):
+            raise ValueError('bounded literal job identity required')
+    if len(os.fsencode(root / 'runs' / value['job'] / 'monitor/lifecycle.sock')) >= 108:
+        raise ValueError('task monitor socket path exceeds AF_UNIX limit')
+    if not 0 < value['run_seconds'] <= 3600 or type(value['run_seconds']) not in (int, float):
+        raise ValueError('finite job runtime up to3600 seconds required')
+    if value['kind'] not in ('host', 'build', 'guest') or not 1 <= len(value['commands']) <= 16:
+        raise ValueError('known job kind and bounded command sequence required')
+    if value['kind'] == 'guest' and value['run_seconds'] > 1800:
+        raise ValueError('Guest group runtime must not exceed1800 seconds')
+    for key, maximum in (('close_seconds', 10), ('term_seconds', 10), ('kill_seconds', 5)):
+        duration = value.get(key, maximum)
+        if type(duration) not in (int, float) or not 0 < duration <= maximum:
+            raise ValueError('finite bounded shutdown duration required')
+    supervisor = Path(value['supervisor_root']).resolve()
+    for name, expected in value['supervisor_sha256'].items():
+        if name not in ('task_supervisor.py', 'task_lifecycle.py', 'task_resources.py') or hashlib.sha256((supervisor / name).read_bytes()).hexdigest() != expected:
+            raise ValueError('accepted supervisor source binding changed')
+    if len(value['supervisor_sha256']) != 3:
+        raise ValueError('complete accepted supervisor closure required')
+    for command in value['commands']:
+        if type(command['argv']) is not list or not command['argv'] or any(type(x) is not str or '\0' in x for x in command['argv']):
+            raise ValueError('literal command argv required, no shell composition')
+        if not Path(command['cwd']).resolve().is_relative_to(root):
+            raise ValueError('command cwd must remain within this task')
+        duration = command.get('seconds', value['run_seconds'])
+        if type(duration) not in (int, float) or not 0 < duration <= value['run_seconds']:
+            raise ValueError('command deadline must remain within job deadline')
+    return value, root, supervisor
+
+
+def task_usage(root, *, seconds=8, entries=300000):
+    """Count actual task blocks without following links into reusable bases."""
+    deadline = time.monotonic() + seconds
+    todo, seen, count, blocks, logs = [root], set(), 0, root.stat().st_blocks * 512, 0
+    while todo:
+        directory = todo.pop()
+        try:
+            stream = os.scandir(directory)
+        except FileNotFoundError:
+            continue
+        with stream:
+            for entry in stream:
+                count += 1
+                if count > entries or time.monotonic() >= deadline:
+                    raise RuntimeError('task disk audit bound exceeded')
+                try:
+                    info = entry.stat(follow_symlinks=False)
+                except FileNotFoundError:
+                    continue
+                if stat.S_ISLNK(info.st_mode):
+                    continue
+                if stat.S_ISDIR(info.st_mode):
+                    blocks += info.st_blocks * 512
+                    todo.append(Path(entry.path))
+                    continue
+                if not stat.S_ISREG(info.st_mode):
+                    continue
+                key = (info.st_dev, info.st_ino)
+                if key in seen:
+                    continue
+                seen.add(key)
+                blocks += info.st_blocks * 512
+                if Path(entry.path).is_relative_to(root / 'runs'):
+                    logs += info.st_size
+                if blocks > 64 << 30 or logs > 1 << 30:
+                    raise RuntimeError('task disk or aggregate evidence budget exceeded')
+    return {'actual_blocks_bytes': blocks, 'run_evidence_bytes': logs, 'entries': count,
+            'symlinks_followed': False}
+
+
+def actor(config):
+    value, root, supervisor = load(config)
+    sys.path.insert(0, str(supervisor))
+    from task_lifecycle import begin_close
+    from task_supervisor import birth, children, pidfd_signal
+    out = root / 'runs' / value['job']
+    stop = threading.Event()
+    signal.signal(signal.SIGUSR1, lambda *_: stop.set())
+    save(out / 'ready.json', {'pid': os.getpid(), 'birth': birth(os.getpid()), 'signal': 'SIGUSR1'})
+    memory_cap = (32 if value['kind'] == 'guest' else 16) << 30
+    peak = 0
+    usage = {}
+    next_disk_audit = 0
+    def rss():
+        todo, seen, total = [os.getpid()], set(), 0
+        while todo:
+            pid = todo.pop()
+            if pid in seen:
+                continue
+            seen.add(pid)
+            if len(seen) > 128:
+                raise RuntimeError('owned job process bound exceeded')
+            try:
+                p = Path('/proc', str(pid)); fields = (p / 'stat').read_text().rpartition(')')[2].split()
+                if p.stat().st_uid != os.geteuid():
+                    raise RuntimeError('task descendant UID drift')
+                total += int(fields[21]) * os.sysconf('SC_PAGE_SIZE'); todo.extend(children(pid))
+            except (FileNotFoundError, ProcessLookupError):
+                continue
+        return total
+    try:
+        for index, command in enumerate(value['commands']):
+            env = {**os.environ, **value.get('env', {}), **command.get('env', {})}
+            log_path = out / ('command-%02d.log' % index)
+            count = 0
+            with log_path.open('xb') as log:
+                notice_read, notice_write = os.pipe2(os.O_CLOEXEC | os.O_NONBLOCK)
+                env['UFLOW_ENV_CLOSE_FD'] = str(notice_write)
+                process = subprocess.Popen(command['argv'], cwd=command['cwd'], env=env,
+                    stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
+                    pass_fds=(notice_write,))
+                os.close(notice_write)
+                born = birth(process.pid)
+                command_deadline = time.monotonic() + command.get('seconds', value['run_seconds'])
+                save(out / ('command-%02d-start.json' % index), {'argv': command['argv'], 'cwd': command['cwd'],
+                    'pid': process.pid, 'birth': born, 'no_environment_dump': True})
+                os.set_blocking(process.stdout.fileno(), False)
+                stdout_open = notice_open = True
+                while True:
+                    peak = max(peak, rss())
+                    if time.monotonic() >= next_disk_audit:
+                        usage = task_usage(root)
+                        next_disk_audit = time.monotonic() + 10
+                    if time.monotonic() >= command_deadline:
+                        begin_close('environment-command-deadline')
+                        raise RuntimeError('bounded command deadline exceeded')
+                    if peak > memory_cap or stop.is_set():
+                        begin_close('environment-job-resource-or-stop')
+                        pidfd_signal(process.pid, born, signal.SIGTERM, expected_uid=os.geteuid())
+                        raise RuntimeError('job stopped or own RSS budget exceeded')
+                    watched = ([process.stdout] if stdout_open else []) + ([notice_read] if notice_open else [])
+                    readable, _, _ = select.select(watched, [], [], .1)
+                    if notice_read in readable:
+                        data = os.read(notice_read, 1)
+                        if data:
+                            begin_close('environment-child-failure-notice')
+                            raise RuntimeError('child reported failure before diagnostics or cleanup')
+                        notice_open = False
+                    if process.stdout in readable:
+                        data = os.read(process.stdout.fileno(), 65536)
+                        if not data:
+                            stdout_open = False
+                        else:
+                            count += len(data)
+                            if count > 64 << 20:
+                                begin_close('environment-job-log-limit')
+                                raise RuntimeError('single command log exceeded64MiB')
+                            log.write(data)
+                            log.flush()
+                    if not stdout_open and process.poll() is not None:
+                        break
+                code = process.wait()
+                os.close(notice_read)
+                process.stdout.close()
+            if code:
+                begin_close('environment-command-failed')
+            save(out / ('command-%02d-exit.json' % index), {'actual_exit_code': code, 'log_bytes': count,
+                 'peak_own_RSS_bytes': peak, 'pid': process.pid, 'birth': born})
+            if code:
+                raise RuntimeError('command failed; original log retained')
+        begin_close('environment-job-normal-close')
+        save(out / 'actor-complete.json', {'command_count': len(value['commands']), 'peak_own_RSS_bytes': peak,
+             'logical_resources_ACK_inferred': False, 'task_usage': task_usage(root)})
+    except BaseException:
+        begin_close('environment-job-exception')
+        raise
+
+
+def run(config):
+    import fcntl
+    value, root, supervisor = load(config)
+    sys.path.insert(0, str(supervisor))
+    from task_supervisor import birth, run_external
+    extra = {}
+    if value['kind'] == 'build':
+        from uflow_build_supervisor import run_external
+        extra = {'accepted_root': str(supervisor), 'accepted_hashes': value['supervisor_sha256']}
+    out = root / 'runs' / value['job']; out.mkdir()
+    coordination = root / 'coordination'; coordination.mkdir(exist_ok=True)
+    held = []
+    started = physically_closed = False
+    try:
+        if value['kind'] in ('build', 'guest'):
+            if (coordination / 'heavy-process-quarantine.json').exists():
+                raise RuntimeError('prior heavy process boundary unresolved; no new heavy admission')
+            for index in range(2):
+                lock = (coordination / ('heavy-%d.lock' % index)).open('a+')
+                try:
+                    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB); held.append(lock)
+                    if value['kind'] == 'build':
+                        break
+                except BlockingIOError:
+                    lock.close()
+            if not held or value['kind'] == 'guest' and len(held) != 2:
+                raise RuntimeError('task heavy slots busy; no polling')
+        if value['kind'] == 'guest':
+            lock = (coordination / 'guest-execution.lock').open('a+')
+            try:
+                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            except BaseException:
+                lock.close()
+                raise
+            held.append(lock)
+            if (coordination / 'guest-process-quarantine.json').exists():
+                raise RuntimeError('prior Guest process boundary unresolved; no new Guest admission')
+        for lock in held:
+            lock.seek(0)
+            lock.truncate()
+            json.dump({'pid': os.getpid(), 'birth': birth(os.getpid()), 'job': value['job'],
+                       'state': 'held', 'kind': value['kind']}, lock)
+            lock.flush()
+        available = int(next(line.split()[1] for line in Path('/proc/meminfo').read_text().splitlines() if line.startswith('MemAvailable:'))) << 10
+        disk = os.statvfs(root); free = disk.f_bavail * disk.f_frsize
+        if available < (40 << 30) or free < (80 << 30):
+            raise RuntimeError('task resource margin unavailable; no polling')
+        started = True
+        result = run_external([sys.executable, '-B', '-s', str(Path(__file__).resolve()), '--actor', str(Path(config).resolve())],
+            out / 'monitor', run_seconds=value['run_seconds'], close_seconds=value.get('close_seconds', 10),
+            grace_seconds=value.get('close_seconds', 10), term_seconds=value.get('term_seconds', 10),
+            kill_seconds=value.get('kill_seconds', 5), graceful_ready=out / 'ready.json', max_processes=128, private_shm=False,
+            memory_bytes=(32 if value['kind'] == 'guest' else 16) << 30, **extra)
+        physically_closed = bool(result['process_tree_empty'] and result['task_resources_closed'])
+        save(out / 'result.json', {'processes': result, 'FM_is_not_private_SHM': True, 'logical_ACK_inferred': False,
+             'MemAvailable_before': available, 'disk_free_before': free})
+        if result['actual_task_exit_code'] != 0 or not result['process_tree_empty']:
+            raise RuntimeError('job failed or tree not closed; inspect original receipts')
+        print(json.dumps({'job': value['job'], 'actual_exit_code': 0, 'tree_empty': True}))
+    finally:
+        if value['kind'] in ('build', 'guest') and started and not physically_closed:
+            marker = coordination / 'heavy-process-quarantine.json'
+            if not marker.exists():
+                save(marker, {'job': value['job'], 'result_root': str(out),
+                     'unresolved_process_boundary': True, 'logical_DDR_ACK_inferred': False})
+        if value['kind'] == 'guest' and started and not physically_closed:
+            marker = coordination / 'guest-process-quarantine.json'
+            if not marker.exists():
+                save(marker, {'job': value['job'], 'result_root': str(out),
+                     'unresolved_process_boundary': True, 'logical_DDR_ACK_inferred': False})
+        for lock in held:
+            lock.seek(0)
+            lock.truncate()
+            json.dump({'pid': os.getpid(), 'birth': birth(os.getpid()), 'job': value['job'],
+                       'state': 'released'}, lock)
+            lock.flush()
+            lock.close()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--actor', action='store_true')
+    parser.add_argument('config', type=Path)
+    args = parser.parse_args()
+    (actor if args.actor else run)(args.config)
+
+
+if __name__ == '__main__':
+    main()
diff --git a/guest-linux/aarch64/scripts/uflow_env_sdk_probe.c b/guest-linux/aarch64/scripts/uflow_env_sdk_probe.c
