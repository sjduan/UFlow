+ struct UMMUBaseClass {
+     /* <private> */
diff --git a/guest-linux/aarch64/patches/managed-lease-cache-v1/files/hw/ub/uflow_managed_cache.inc b/guest-linux/aarch64/patches/managed-lease-cache-v1/files/hw/ub/uflow_managed_cache.inc
