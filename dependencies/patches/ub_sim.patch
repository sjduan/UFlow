+#!/usr/bin/env python3
+"""Source-bound HOST current-domain tests; every edited input is a new fixture."""
+import copy
+from pathlib import Path
+import sys
+import unittest
+sys.path.insert(0,str(Path(__file__).resolve().parents[1]/'scripts'))
+import uflow_recovery_context_v4 as t
+
+P=t.ROOT/'implementation/c101-write-v1'
+CONTEXT=P/'terminal-context004/context.json'
+CANDIDATE=P/'terminal-context004/candidate.json'
+OUTPUT=P/'context-tests001'
+
+
+class CurrentContext(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        OUTPUT.mkdir();cls.original=t.reference(t.ROOT/'runs/c101/state/state.json')
+        cls.context=t.decode(CONTEXT.read_bytes());cls.observation=t.document(cls.context['observation'])
+
+    @classmethod
+    def tearDownClass(cls):
+        if t.reference(t.ROOT/'runs/c101/state/state.json')!=cls.original:
+            raise AssertionError('read-only tests altered original authority')
+
+    def write(self,name,value):
+        p=OUTPUT/(self._testMethodName+'-'+name+'.json')
+        with p.open('xb') as f:f.write(t.ev.canonical(value)+b'\n')
+        return t.reference(p)
+
+    def reject(self,context):
+        ref=self.write('context',context)
+        value=t.evaluate(ref['path'],ref['sha256'])
+        self.assertEqual(value['status'],'INCOMPLETE');self.assertEqual(value['eligible_rows'],[])
+        self.assertFalse(value['authority_to_mutate_ledger']);self.assertFalse(value['authority_to_launch_new_Guest'])
+        self.assertFalse(value['normal_native_or_SDK_release_ACK'])
+
+    def observation_case(self,edit):
+        context=copy.deepcopy(self.context);obs=copy.deepcopy(self.observation)
+        edit(obs['references']);context['observation']=self.write('observation',obs);self.reject(context)
+
+    def test_actual_current_candidate_reproduces(self):
+        ref=t.reference(CANDIDATE);value=t.validate_candidate(ref['path'],ref['sha256'])
+        self.assertEqual(value['physical_closure']['retained_files'],84)
+        self.assertEqual(value['physical_closure']['exact_original_births_gone'],179)
+        self.assertEqual(value['current_eligible_capacity_bytes'],52<<20)
+        self.assertFalse(value['native_W_grant_observed_in_c101'])
+        self.assertEqual(value['normal_metadata_verdict'],'INCOMPLETE')
+
+    def test_old_case_is_not_current(self):
+        ref=t.reference(t.ROOT/'implementation/c081-recovery-v1/terminal-context004/context.json')
+        self.assertEqual(t.evaluate(ref['path'],ref['sha256'])['status'],'INCOMPLETE')
+
+    def test_future_W_profile_cannot_replace_observed_R(self):
+        c=copy.deepcopy(self.context);c['observed_profile']['manifest']=t.reference(P/'release-v1/profile-manifest.json')
+        self.reject(c)
+
+    def test_missing_actual_ownership_is_not_invented(self):
+        c=copy.deepcopy(self.context);del c['ownership']['c102'];self.reject(c)
+
+    def test_prior_claim_cannot_be_replayed_as_current_claim(self):
+        c=copy.deepcopy(self.context)
+        c['prior_chains']['c100']['service-admission-claim.json']=c['prior_chains']['c064']['service-admission-claim.json']
+        self.reject(c)
+
+    def test_caller_readiness_flags_are_rejected(self):
+        c=copy.deepcopy(self.context);c['force_ready']=True;self.reject(c)
+
+    def test_wrong_original_authority_is_rejected(self):
+        self.observation_case(lambda refs:refs.update(state=t.reference(t.ROOT/'runs/c081/state/state.json')))
+
+    def test_missing_source_manifest_is_rejected(self):
+        self.observation_case(lambda refs:refs['source_manifest'].update(sha256='0'*64))
+
+    def test_old_image_is_not_the_observed_image(self):
+        old=t.ROOT/'implementation/build-host046/pool-agent.cpio.gz'
+        self.observation_case(lambda refs:refs.update(guest_image=t.reference(old,64<<20)))
+
+    def test_image_compiler_closure_is_complete(self):
+        refs=copy.deepcopy(self.observation['references']);inputs=t.document(refs['image_compiler_inputs'])
+        del inputs[next(iter(inputs))];altered=self.write('image-inputs',inputs)
+        self.observation_case(lambda refs:refs.update(image_compiler_inputs=altered))
+
+    def test_all_physical_paths_required(self):
+        refs=self.observation['references'];physical=t.document(refs['physical'])
+        physical['files_stat_and_aliases']=physical['files_stat_and_aliases'][:-1]
+        altered=self.write('physical',physical)
+        self.observation_case(lambda refs:refs.update(physical=altered))
+
+    def test_actual_external_context_digest_required(self):
+        self.assertEqual(t.evaluate(CONTEXT,'0'*64)['status'],'INCOMPLETE')
+
+
+if __name__=='__main__':unittest.main(verbosity=2)
