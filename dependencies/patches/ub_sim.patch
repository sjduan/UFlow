+        raise ValueError('explicit reviewed managed-cache profile required')
+    module = _verified_peer_module('uflow_managed_qemu_profile_v1.py', 'a225f345d48046d228e33a98161c02a1b17a556453a13d2d2869ab33e2ea931b')
+    result = module.validate(selected['manifest'], selected['manifest_sha256'], config['qemu_binary'])
+    if (result['managed_cache'] != module.CONTROL or result['runtime_wrapper']['path'] != str(Path(__file__).resolve()) or
+        result['runtime_wrapper']['sha256'] != hashlib.sha256(Path(__file__).read_bytes()).hexdigest() or
+        result['runtime_codec']['sha256'] != '7cfbdc76f1ab8d696ae3349b6bf5510d5b8e6b4f047f50ae90e579b72c4e62db'):
+        raise ValueError('actual selected profile/wrapper/codec closure mismatch')
