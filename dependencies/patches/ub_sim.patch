+        self.assertEqual(len(self.prof['unchanged_writer_functions']), 6)
+        self.assertEqual(m.md.SOURCE_SHA, 'cf803e8e898764002bea02307ff4f94d20320fac44226fa1b54c40f5154cf043')
+
+    def test_complete_fixture_bootstrap_retired(self):
